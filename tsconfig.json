{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.astro"],
  "exclude": ["node_modules", "app", "build", "components", "db", "examples", "hooks", "lib", "worker", "vite.config.ts", "next.config.ts", "drizzle.config.ts"]
}
