---
import { editorialImages } from "../data/editorial-images";
import ValuationOptions from "./ValuationOptions.astro";

const autoOpen = Astro.url.pathname === "/";
---

<aside id="sayan-advice-popup" class:list={["advice-popup", { "is-open": autoOpen, "advice-popup--entrance": autoOpen }]} data-advice-popup tabindex="-1" hidden={!autoOpen} aria-labelledby="advice-title" aria-describedby="advice-description">
  <div class="advice-popup__intro">
    <img src={editorialImages.company.src} alt="Unser Team von SAYAN Immobilien" width="72" height="72" loading="lazy" />
    <div><p class="eyebrow">SAYAN Immobilien · Köln</p><p class="advice-popup__name">In der Branche seit 1999.</p></div>
    <button class="advice-popup__close" type="button" data-close-advice aria-label="Beratungshinweis schließen">×</button>
  </div>
  <div class="advice-popup__body">
    <h2 id="advice-title">Was ist Ihre Immobilie wert?</h2>
    <p id="advice-description">Online oder persönlich vor Ort. Sie entscheiden.</p>
    <ValuationOptions compact />
    <button class="advice-popup__later" type="button" data-close-advice>Vielleicht später</button>
  </div>
</aside>

<style>
  .advice-popup { position: fixed; z-index: 300; right: max(1.25rem, env(safe-area-inset-right)); bottom: max(1.25rem, env(safe-area-inset-bottom)); width: min(25rem, calc(100% - 2.5rem)); max-height: min(32rem, calc(100svh - 2.5rem)); overflow-y: auto; border: 1px solid var(--n-border); border-radius: var(--radius-card); background: var(--paper); color: var(--ink); box-shadow: 0 20px 70px -15px rgb(0 0 0 / .25); opacity: 0; transform: translate3d(12%, calc(100% + 2rem), 0); transition: transform var(--motion-panel) var(--ease-out-expo), opacity 300ms ease; }
  .advice-popup[hidden] { display: none; }
  .advice-popup.is-open { opacity: 1; transform: translateY(0); }
  :global(body:has([data-consent]:not([hidden]))) .advice-popup { max-height: calc(64svh - 1.5rem); }
  .advice-popup--entrance { animation: advice-enter 650ms var(--ease-out-expo) 2s both; }
  @keyframes advice-enter { from { opacity: 0; transform: translate3d(12%, calc(100% + 2rem), 0); } to { opacity: 1; transform: translate3d(0, 0, 0); } }
  /* Keep the privacy notice visible above the panel, including on small screens. */
  :global(body:has(.advice-popup:not([hidden])) .consent:not([hidden])) { top: 1rem; bottom: auto; max-height: calc(36svh - 1.5rem); overflow-y: auto; }
  .advice-popup__intro { display: flex; gap: .85rem; align-items: center; padding: .85rem 1rem; background: var(--brand-100); }
  .advice-popup__intro img { width: 2.75rem; height: 2.75rem; flex-shrink: 0; border-radius: 50%; object-fit: cover; object-position: 50% 25%; }
  .advice-popup .eyebrow { margin: 0 0 .4rem; font-size: .62rem; letter-spacing: .09em; opacity: 1; }
  .advice-popup__name { font-size: .85rem; font-weight: 600; }
  .advice-popup__close { display: grid; place-items: center; flex-shrink: 0; width: 2.75rem; height: 2.75rem; margin-left: auto; border: 1px solid var(--line-dark); border-radius: 50%; background: transparent; color: var(--ink); font-size: 1.5rem; cursor: pointer; }
  .advice-popup__intro .eyebrow { padding: 0; border: 0; background: none; }
  .advice-popup__body { padding: 1rem; }
  .advice-popup h2 { max-width: 17ch; font-size: 1.45rem; line-height: 1.12; letter-spacing: -.035em; text-transform: none; }
  .advice-popup #advice-description { margin-top: .5rem; font-size: .8rem; color: var(--ink-muted); }
  .advice-popup .button { display: flex; justify-content: space-between; width: 100%; margin-top: 1.4rem; }
  .advice-popup__valuation { display: flex; justify-content: space-between; gap: .5rem; margin-top: 1rem; padding-block: .35rem; font-size: .78rem; font-weight: 600; }
  .advice-popup__valuation:hover { text-decoration: underline; text-underline-offset: .2em; }
  .advice-popup__body > :global(.valuation-options) { margin-top: .75rem; }
  .advice-popup__later { display: block; min-height: 2.75rem; margin: .65rem auto -.5rem; padding: .5rem; border: 0; background: none; color: var(--ink-muted); font-size: .75rem; cursor: pointer; }
  @media (max-width: 767px) {
    .advice-popup { right: .75rem; bottom: max(.75rem, env(safe-area-inset-bottom)); width: calc(100% - 1.5rem); max-height: min(32rem, calc(100svh - 1.5rem)); }
    .advice-popup__intro { padding: 1rem; }
    .advice-popup__body { padding: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) { .advice-popup { transition: none; animation: none; transform: none; } }
</style>

<script>
  const popup = document.querySelector<HTMLElement>("[data-advice-popup]");
  if (popup) {
    let closingTimer: number | undefined;
    let returnFocus: HTMLElement | null = null;

    const openPopup = (trigger: HTMLElement | null = null) => {
      returnFocus = trigger;
      if (closingTimer !== undefined) {
        window.clearTimeout(closingTimer);
        closingTimer = undefined;
      }
      if (document.body.classList.contains("menu-open")) document.querySelector<HTMLButtonElement>(".menu-close")?.click();
      popup.inert = false;
      popup.hidden = false;
      popup.classList.remove("advice-popup--entrance");
      requestAnimationFrame(() => requestAnimationFrame(() => {
        if (!popup.inert) {
          popup.classList.add("is-open");
          popup.focus({ preventScroll: true });
        }
      }));
    };
    const closePopup = () => {
      if (popup.hidden || popup.inert) return;
      if (popup.contains(document.activeElement)) {
        const target = returnFocus?.isConnected && returnFocus.getClientRects().length
          ? returnFocus : document.querySelector<HTMLElement>(".nav-cta, .menu-toggle");
        target?.focus({ preventScroll: true });
      }
      popup.inert = true;
      popup.classList.remove("advice-popup--entrance", "is-open");
      closingTimer = window.setTimeout(() => { popup.hidden = true; closingTimer = undefined; }, window.matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 600);
    };
    document.querySelectorAll<HTMLAnchorElement>("[data-open-advice]").forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
        event.preventDefault();
        openPopup(trigger);
      });
    });
    popup.querySelectorAll("[data-close-advice]").forEach((button) => button.addEventListener("click", closePopup));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !popup.hidden) closePopup();
    });
    window.addEventListener("hashchange", () => { if (window.location.hash === "#beratung") openPopup(); });
    if (window.location.hash === "#beratung" && popup.hidden) openPopup();
  }
</script>
