---
import { editorialImages } from "../data/editorial-images";
import { siteSettings } from "../data/site-settings";

const autoOpen = Astro.url.pathname === "/";
---

<aside
  id="sayan-advice-popup"
  class="advice-popup"
  data-advice-popup
  data-auto-open={autoOpen ? "true" : undefined}
  data-delay={siteSettings.advicePopupDelaySeconds}
  data-scroll={siteSettings.advicePopupScrollPercent}
  tabindex="-1"
  hidden
  aria-labelledby="advice-title"
  aria-describedby="advice-description"
>
  <div class="advice-popup__band">
    <img src={editorialImages.candanPortrait.src} alt="" width="56" height="56" loading="lazy" style="object-position: 50% 20%" />
    <div>
      <p class="advice-popup__brand">SAYAN Immobilien Köln</p>
      <p class="advice-popup__since">Immobilienexpertise seit 1998</p>
    </div>
    <button class="advice-popup__close" type="button" data-close-advice aria-label="Hinweis schließen">×</button>
  </div>
  <div class="advice-popup__body">
    <h2 id="advice-title">Was ist Ihre Immobilie wert?</h2>
    <p id="advice-description">Kostenlos und unverbindlich. Wir kommen zu Ihnen und sagen Ihnen ehrlich, was Ihre Immobilie am Markt bringt.</p>
    <div class="advice-popup__actions">
      <a class="advice-popup__btn advice-popup__btn--primary" href="/kontakt/#termin"><span><strong>Termin vor Ort vereinbaren</strong><small>Persönlich, genau, mit Preisempfehlung</small></span><span aria-hidden="true">→</span></a>
      <a class="advice-popup__online" href="/leistung/formular/">Lieber erst online schätzen <span aria-hidden="true">→</span></a>
    </div>
    <button class="advice-popup__later" type="button" data-close-advice>Später</button>
  </div>
</aside>
<button class="advice-launcher" type="button" data-advice-launcher hidden aria-controls="sayan-advice-popup">
  <span class="advice-launcher__dot" aria-hidden="true"></span>Was ist Ihre Immobilie wert?
</button>

<style>
  .advice-launcher { position: fixed; z-index: 480; right: 1rem; bottom: 1rem; display: inline-flex; align-items: center; gap: .55rem; min-height: 3rem; padding: .7rem 1.1rem; border: 0; border-radius: 999px; background: var(--accent); color: var(--accent-ink, #1e1713); font-weight: 600; font-size: .92rem; box-shadow: 0 10px 30px rgb(30 23 19 / .25); cursor: pointer; animation: launcher-in 500ms cubic-bezier(.16, 1, .3, 1) both; }
  .advice-launcher[hidden] { display: none; }
  .advice-launcher:hover { filter: brightness(1.05); }
  .advice-launcher__dot { width: .5rem; height: .5rem; border-radius: 50%; background: currentColor; animation: launcher-pulse 1.8s ease-in-out infinite; }
  @keyframes launcher-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @keyframes launcher-pulse { 50% { opacity: .35; } }
  :global(body:has([data-consent]:not([hidden]))) .advice-launcher { display: none; }
  @media (prefers-reduced-motion: reduce) { .advice-launcher, .advice-launcher__dot { animation: none; } }
  .advice-popup { position: fixed; z-index: 300; right: max(1.25rem, env(safe-area-inset-right)); bottom: max(1.25rem, env(safe-area-inset-bottom)); width: min(23rem, calc(100% - 2.5rem)); overflow: hidden; border: 1px solid var(--n-border); border-radius: 18px; background: #fff; color: var(--ink); box-shadow: 0 30px 70px -25px rgb(36 28 24 / .45); opacity: 0; transform: translate3d(0, 1.5rem, 0); transition: transform var(--motion-panel) var(--ease-out-expo), opacity 300ms ease; }
  .advice-popup[hidden] { display: none; }
  .advice-popup.is-open { opacity: 1; transform: none; }
  .advice-popup__band { display: flex; gap: .85rem; align-items: center; padding: .9rem 1rem .9rem 1.1rem; background: var(--accent); color: var(--accent-ink); }
  .advice-popup__band img { width: 2.75rem; height: 2.75rem; flex-shrink: 0; border: 2px solid #fff; border-radius: 50%; object-fit: cover; object-position: 50% 25%; }
  .advice-popup__brand { font-size: .8rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .advice-popup__since { font-size: .95rem; font-weight: 500; }
  .advice-popup__close { display: grid; place-items: center; flex-shrink: 0; width: 2.5rem; height: 2.5rem; margin-left: auto; border: 0; border-radius: 50%; background: rgb(255 255 255 / .55); color: var(--ink); font-size: 1.4rem; line-height: 1; cursor: pointer; }
  .advice-popup__close:hover { background: #fff; }
  .advice-popup__body { padding: 1.25rem 1.25rem 1rem; }
  .advice-popup h2 { font-size: 1.6rem; line-height: 1.15; }
  .advice-popup #advice-description { margin-top: .5rem; color: var(--n-text-secondary); font-size: 1rem; line-height: 1.55; }
  .advice-popup__actions { display: grid; gap: .6rem; margin-top: 1.1rem; }
  .advice-popup__btn { display: flex; align-items: center; justify-content: space-between; padding: .85rem 1.1rem; border-radius: 10px; color: #fff; font-size: 1rem; font-weight: 600; transition: filter 200ms ease; }
  .advice-popup__btn:hover { filter: brightness(1.1); }
  .advice-popup__btn--primary { padding: 1rem 1.15rem; background: var(--accent); color: var(--accent-ink); }
  .advice-popup__btn--primary strong { display: block; font-size: 1.05rem; }
  .advice-popup__btn--primary small { display: block; margin-top: .15rem; font-size: .85rem; font-weight: 500; opacity: .8; }
  .advice-popup__online { display: flex; justify-content: center; gap: .4rem; padding: .6rem; color: var(--blue); font-weight: 600; }
  .advice-popup__online:hover { text-decoration: underline; text-underline-offset: .2em; }
  .advice-popup__later { display: block; margin: .75rem auto 0; padding: .4rem; border: 0; background: none; color: var(--n-text-secondary); font-size: .9rem; text-decoration: underline; text-underline-offset: .2em; cursor: pointer; }
  :global(body:has(.advice-popup:not([hidden])) .consent:not([hidden])) { top: 1rem; bottom: auto; }
  @media (max-width: 767px) { .advice-popup { right: .75rem; bottom: max(.75rem, env(safe-area-inset-bottom)); width: calc(100% - 1.5rem); } }
  @media (prefers-reduced-motion: reduce) { .advice-popup { transition: none; transform: none; } }
</style>

<script>
  const popup = document.querySelector<HTMLElement>("[data-advice-popup]");
  // Geschlossen = nur für diesen Besuch (Tab) pausiert. Beim nächsten Besuch erscheint das Pop-up wieder.
  const KEY = "sayan-advice-dismissed";
  try { localStorage.removeItem(KEY); } catch { /* alter Schlüssel, nicht mehr genutzt */ }
  const launcher = document.querySelector<HTMLButtonElement>("[data-advice-launcher]");
  const dismissedRecently = () => { try { return sessionStorage.getItem(KEY) === "1"; } catch { return false; } };
  const rememberDismiss = () => { try { sessionStorage.setItem(KEY, "1"); } catch { /* privater Modus */ } };

  if (popup) {
    let returnFocus: HTMLElement | null = null;
    let closingTimer: number | undefined;

    const openPopup = (trigger: HTMLElement | null = null, focus = true) => {
      returnFocus = trigger;
      if (closingTimer) window.clearTimeout(closingTimer);
      popup.inert = false;
      popup.hidden = false;
      if (launcher) launcher.hidden = true;
      requestAnimationFrame(() => requestAnimationFrame(() => {
        popup.classList.add("is-open");
        if (focus) popup.focus({ preventScroll: true });
      }));
    };
    const closePopup = () => {
      if (popup.hidden) return;
      rememberDismiss();
      if (popup.contains(document.activeElement)) returnFocus?.focus({ preventScroll: true });
      popup.inert = true;
      popup.classList.remove("is-open");
      closingTimer = window.setTimeout(() => { popup.hidden = true; if (launcher) launcher.hidden = false; }, window.matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 500);
    };

    document.querySelectorAll<HTMLAnchorElement>("[data-open-advice]").forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
        event.preventDefault();
        openPopup(trigger);
      });
    });
    popup.querySelectorAll("[data-close-advice]").forEach((button) => button.addEventListener("click", closePopup));
    document.addEventListener("keydown", (event) => { if (event.key === "Escape") closePopup(); });
    launcher?.addEventListener("click", () => openPopup(launcher));
    if (dismissedRecently() && launcher) launcher.hidden = false;
    if (new URLSearchParams(window.location.search).has("popup")) openPopup();
    window.addEventListener("hashchange", () => { if (window.location.hash === "#beratung") openPopup(); });
    if (window.location.hash === "#beratung") openPopup();

    // Automatisch nur auf der Startseite: erst nach Wartezeit UND genug Scrollen,
    // nie während die Bewertungskarten sichtbar sind, nie wenn kürzlich geschlossen.
    if (popup.dataset.autoOpen && !dismissedRecently()) {
      const minScroll = Number(popup.dataset.scroll || 50) / 100;
      const valuation = document.getElementById("bewertung");
      let timeUp = false;
      let done = false;
      const valuationVisible = () => {
        if (!valuation) return false;
        const r = valuation.getBoundingClientRect();
        return r.top < window.innerHeight && r.bottom > 0;
      };
      const check = () => {
        if (done || !timeUp || !popup.hidden) return;
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        if (scrollable > 0 && window.scrollY / scrollable < minScroll) return;
        if (valuationVisible()) return;
        if (document.querySelector("[data-consent]:not([hidden])")) return;
        done = true;
        window.removeEventListener("scroll", check);
        openPopup(null, false);
      };
      window.addEventListener("scroll", check, { passive: true });
      // Sobald der Besucher im Datenschutz-Banner entschieden hat, kurz danach erneut prüfen.
      window.addEventListener("sayan:consent", () => window.setTimeout(check, 1500));
      window.setTimeout(() => { timeUp = true; check(); }, Number(popup.dataset.delay || 30) * 1000);
    }
  }
</script>
