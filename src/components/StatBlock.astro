---
interface Props {
  value: string;
  label: string;
  source?: string;
  placeholder?: boolean;
}

const { value, label, source, placeholder = false } = Astro.props;
---

<div class:list={["stat-block", { "is-placeholder": placeholder }]} data-reveal>
  <strong>{value}</strong>
  <span>{label}</span>
  {source && <small>{source}</small>}
</div>
