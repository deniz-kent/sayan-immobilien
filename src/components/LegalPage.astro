---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

interface Props { title: string; eyebrow: string; intro?: string; }
const { title, eyebrow, intro } = Astro.props;
---

<BaseLayout title={`${title} | SAYAN Immobilien`} description={`${title} von SAYAN Immobilien Köln.`}>
  <Header />
  <main id="main">
    <section class="page-hero"><div class="container"><p class="eyebrow">{eyebrow}</p><h1>{title}.</h1>{intro && <p>{intro}</p>}</div></section>
    <section class="section section--light"><div class="container legal-copy"><slot /></div></section>
  </main>
  <Footer />
</BaseLayout>
