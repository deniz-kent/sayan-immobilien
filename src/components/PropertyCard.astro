---
import type { Property } from "../data/properties";

interface Props {
  property: Property;
}

const { property } = Astro.props;
const cover = property.images.find((image) => ["Titelbild", "Foto", "Foto_gross"].includes(image.category));
---

<article class="property-card" data-type={property.type}>
  <a class="property-card__media" href={`/immobilien/${property.id}/`} aria-hidden="true" tabindex="-1">
    <span class="property-card__tag">{property.status === "Reserviert" ? "Reserviert" : property.type === "kaufen" ? "Kaufen" : "Mieten"}</span>
    {cover ? <img src={cover.url} alt="" loading="lazy" width="800" height="667" /> : <svg viewBox="0 0 64 64" width="30" height="30">
      <path d="M6 34 L32 12 L58 34" fill="none" stroke="currentColor" stroke-width="6" stroke-linejoin="miter" />
      <rect x="16" y="46" width="32" height="6" fill="currentColor" />
    </svg>}
  </a>
  <div class="property-card__body">
    {property.location && <p class="property-card__location"><svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-5.5-7-11a7 7 0 1 1 14 0c0 5.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg> {property.location}</p>}
    <div class="property-card__row"><h3><a href={`/immobilien/${property.id}/`}>{property.title}</a></h3><span class="property-card__price">{property.price}</span></div>
    {(property.rooms || property.area) && <dl class="property-card__facts">
      {property.rooms && <div><dt>Zimmer</dt><dd>{property.rooms}</dd></div>}
      {property.area && <div><dt>Fläche</dt><dd>{property.area}</dd></div>}
    </dl>}
    <a class="text-link" href={`/immobilien/${property.id}/`}>Details ansehen →</a>
  </div>
</article>
