---
interface Props {
  status?: string;
  meta?: string;
  title?: string;
  specs?: string;
  index?: string;
}

const {
  status = "Abgeschlossen",
  meta = "Ort · Kategorie · Platzhalter",
  title = "Referenzprojekt – Inhalte folgen.",
  specs = "Zimmer · Fläche · Preis folgen",
  index = "01",
} = Astro.props;
---

<article class="property-card" data-reveal>
  <div class="media-placeholder media-placeholder--property" role="img" aria-label="Immobilienbild Platzhalter">
    <span class="status-pill">{status}</span>
    <span class="placeholder-index">{index}</span>
    <span class="placeholder-label">Objektbild · Platzhalter</span>
  </div>
  <div class="property-card__body">
    <p class="property-meta">{meta}</p>
    <h3>{title}</h3>
    <p class="property-specs">{specs}</p>
  </div>
</article>
