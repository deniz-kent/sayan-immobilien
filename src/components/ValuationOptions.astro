---
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;

const options = [
  {
    tag: "Online",
    meta: "in wenigen Minuten",
    title: "Erste Einschätzung <em>online.</em>",
    copy: "Eckdaten eingeben und eine erste Orientierung bekommen. Gut, wenn Sie sich zuerst einen Überblick verschaffen möchten.",
    points: ["Von zu Hause, wann es Ihnen passt", "Erste Orientierung zum Wert", "Unverbindlich"],
    href: "/leistung/formular/",
    action: "Online bewerten",
    featured: false,
  },
  {
    tag: "Vor Ort",
    meta: "empfohlen",
    title: "Genaue Bewertung <em>vor Ort.</em>",
    copy: "Wir sehen uns Ihre Immobilie persönlich an und ordnen Lage, Zustand und Markt ein. Daraus wird ein Preis, mit dem Sie verkaufen können.",
    points: ["Persönliche Besichtigung und Beratung", "Einordnung von Lage, Zustand und Markt", "Klare Empfehlung zum Angebotspreis"],
    href: "/kontakt/#termin",
    action: "Termin vereinbaren",
    featured: true,
  },
];
---
<div class:list={["valuation-options", { "valuation-options--compact": compact }]} data-reveal-group>
  {options.map((option, i) => (
    <a class:list={["valuation-option", { "valuation-option--featured": option.featured }]} href={option.href} data-reveal style={`--stagger:${i}`}>
      <div class="valuation-option__top">
        <span class="valuation-option__tag">{option.tag}</span>
        <span class="valuation-option__meta">{option.meta}</span>
      </div>
      <h3 set:html={option.title} />
      <p class="valuation-option__copy">{option.copy}</p>
      <ul>
        {option.points.map((point) => <li>{point}</li>)}
      </ul>
      <span class="valuation-option__action">{option.action} <span class="arrow" aria-hidden="true">→</span></span>
    </a>
  ))}
</div>
<style>
  .valuation-options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.75rem); }
  .valuation-option { display: flex; flex-direction: column; padding: clamp(1.75rem, 3.2vw, 3rem); border-radius: 20px; background: #fff; color: var(--ink); transition: transform 500ms var(--ease-out-expo), box-shadow 500ms var(--ease-out-expo); }
  .valuation-option:hover { transform: translateY(-4px); box-shadow: 0 30px 60px -30px rgb(51 59 62 / .35); }
  .valuation-option--featured { background: var(--accent); }
  .valuation-option__top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: clamp(2rem, 4vw, 3.25rem); }
  .valuation-option__tag { padding: .55rem 1rem; border-radius: 8px; background: var(--n-bg); font-size: .95rem; font-weight: 600; }
  .valuation-option--featured .valuation-option__tag { background: rgb(255 255 255 / .45); }
  .valuation-option__meta { color: var(--n-text-secondary); font-size: .95rem; }
  .valuation-option--featured .valuation-option__meta { color: var(--accent-ink); font-weight: 600; }
  .valuation-option h3 { margin: 0 0 1.25rem; font-size: clamp(1.9rem, 2.8vw, 2.5rem); font-weight: 300; line-height: 1.12; }
  .valuation-option--featured h3 :global(em) { background-image: linear-gradient(#fff, #fff); }
  .valuation-option__copy { max-width: 44ch; color: var(--n-text-secondary); }
  .valuation-option--featured .valuation-option__copy { color: var(--accent-ink); }
  .valuation-option ul { display: grid; gap: .85rem; margin: 2rem 0 2.5rem; padding: 2rem 0 0; border-top: 1px solid var(--n-border); list-style: none; }
  .valuation-option--featured ul { border-color: rgb(51 59 62 / .2); }
  .valuation-option li { position: relative; padding-left: 2rem; }
  .valuation-option li::before { position: absolute; top: .85em; left: 0; width: 1rem; height: 1px; background: currentColor; content: ""; }
  .valuation-option__action { display: inline-flex; align-items: center; gap: .6rem; width: fit-content; margin-top: auto; padding: 1.05rem 1.6rem; border-radius: 10px; background: var(--blue); color: #fff; font-weight: 600; }
  .valuation-option--featured .valuation-option__action { background: var(--ink); }
  .valuation-option .arrow { transition: transform 300ms var(--ease-out-expo); }
  .valuation-option:hover .arrow { transform: translateX(4px); }

  .valuation-options--compact { grid-template-columns: 1fr; gap: .75rem; }
  .valuation-options--compact .valuation-option { padding: 1rem 1.15rem; border-radius: 12px; }
  .valuation-options--compact .valuation-option:hover { transform: translateY(-2px); box-shadow: none; }
  .valuation-options--compact .valuation-option--featured { background: #fff; }
  .valuation-options--compact .valuation-option--featured h3 :global(em) { background-image: linear-gradient(var(--accent), var(--accent)); }
  .valuation-options--compact .valuation-option--featured .valuation-option__tag { background: var(--n-bg); }
  .valuation-options--compact .valuation-option__top { margin-bottom: .6rem; }
  .valuation-options--compact .valuation-option__tag { padding: .3rem .65rem; font-size: .8rem; }
  .valuation-options--compact .valuation-option__meta { font-size: .85rem; }
  .valuation-options--compact h3 { margin-bottom: .75rem; font-size: 1.35rem; }
  .valuation-options--compact .valuation-option__copy, .valuation-options--compact ul { display: none; }
  .valuation-options--compact .valuation-option__action { padding: .7rem 1rem; font-size: .95rem; }
  @media (max-width: 767px) { .valuation-options { grid-template-columns: 1fr; } }
</style>
