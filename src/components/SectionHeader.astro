---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  linkLabel?: string;
  linkHref?: string;
}

const { eyebrow, title, lead, linkLabel, linkHref = "/#kontakt" } = Astro.props;
---

<header class:list={["section-head", { "section-head--with-lead": Boolean(lead) }]} data-reveal>
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2 set:html={title}></h2>
    {lead && <p class="section-lead">{lead}</p>}
  </div>
  {linkLabel && <a class="text-link" href={linkHref}>{linkLabel}</a>}
</header>
