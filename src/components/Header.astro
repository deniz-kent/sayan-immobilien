---
import Logo from "./Logo.astro";
import { googleRating } from "../data/reviews";
import { services } from "../data/services";
import { hasEnglish, toEnglishPath, toGermanPath } from "../i18n/translate";

const lang = Astro.locals.lang ?? "de";
const dePath = toGermanPath(Astro.url.pathname);
const canSwitch = hasEnglish(dePath);
const langLinks = { de: dePath, en: canSwitch ? toEnglishPath(dePath) : "/en/" };

const serviceGroups = ["Eigentümer", "Vermarktung", "Abschluss", "Weitere Leistungen"] as const;

// Navigation nach Absicht der Besucher: suchen, verkaufen, Wert erfahren. Häufige Ziele (Preise, Über uns, Kontakt) sind direkte Links ohne Menü.
type NavGroup = {
  label: string;
  href?: string;
  columns?: { title: string; links: string[] }[];
  promoEyebrow?: string; promo?: string; promoText?: string; promoHref?: string; promoImage?: string;
};
const groups: NavGroup[] = [
  {
    label: "Immobilien",
    columns: [
      { title: "Angebote", links: ["Immobilien kaufen", "Immobilien mieten", "Alle Angebote"] },
      { title: "Nichts Passendes dabei?", links: ["Suchprofil anlegen", "Finanzierung"] },
    ],
    promoEyebrow: "Kostenlos · unverbindlich",
    promo: "Suchprofil anlegen",
    promoText: "Passende Angebote direkt von uns, auch Objekte, die nicht öffentlich inseriert sind.",
    promoHref: "/suchservice/",
    promoImage: "/images/menu/suchen.webp",
  },
  {
    label: "Verkaufen",
    columns: [
      { title: "Verkaufen und vermieten", links: ["Immobilie verkaufen", "Immobilie vermieten", "Diskret vermarkten", "Alle Leistungen"] },
      { title: "So vermarkten wir", links: ["Fotografie", "Home Staging", "360-Grad-Rundgang", "Besichtigungen"] },
      { title: "Für Profis", links: ["Bauträgervertrieb", "Portfoliovertrieb", "Tippgeber"] },
    ],
    promoEyebrow: "Der erste Schritt",
    promo: "Was ist Ihre Immobilie wert?",
    promoText: "Online in wenigen Minuten oder persönlich vor Ort.",
    promoHref: "/leistung/formular/",
    promoImage: "/images/menu/verkaufen.webp",
  },
  {
    label: "Bewerten",
    columns: [
      { title: "Wert erfahren", links: ["Online bewerten", "Bewertung vor Ort", "Wertermittlung", "Energieausweis"] },
      { title: "Marktdaten", links: ["Immobilienpreise Köln", "Alle Stadtteile & Preise"] },
    ],
    promoEyebrow: "Kostenlos · unverbindlich",
    promo: "Bewertung vor Ort",
    promoText: "Wir sehen uns Ihre Immobilie an und nennen Ihnen einen realistischen Preis.",
    promoHref: "/kontakt/#termin",
    promoImage: "/images/menu/bewerten.webp",
  },
  { label: "Preise Köln", href: "/immobilienpreise-koeln/" },
  { label: "Über uns", href: "/ueber-uns/" },
  { label: "Kontakt", href: "/kontakt/" },
];
// Kurze Erklärung unter jedem Menülink, damit man schneller findet, was man sucht.
const linkHints: Record<string, string> = {
  "Immobilien kaufen": "Aktuelle Kaufangebote in Köln",
  "Immobilien mieten": "Wohnungen und Häuser zur Miete",
  "Alle Angebote": "Kauf und Miete auf einen Blick",
  "Suchprofil anlegen": "Passende Objekte direkt von uns",
  "Finanzierung": "Unabhängig zur passenden Finanzierung",
  "Immobilie verkaufen": "In 7 Phasen bis zum Notartermin",
  "Immobilie vermieten": "Von den Fotos bis zur Übergabe",
  "Diskret vermarkten": "Ohne öffentliches Inserat",
  "Alle Leistungen": "Alle 19 Leistungen im Überblick",
  "Fotografie": "Profifotos und Exposé",
  "Home Staging": "Räume, die man sich vorstellen kann",
  "360-Grad-Rundgang": "Besichtigen vom Sofa aus",
  "Besichtigungen": "Organisiert und begleitet",
  "Bauträgervertrieb": "Vertrieb für Neubauprojekte",
  "Portfoliovertrieb": "Mehrere Objekte, ein Partner",
  "Tippgeber": "Provision für Ihre Empfehlung",
  "Online bewerten": "Erste Einschätzung in Minuten",
  "Bewertung vor Ort": "Persönlich, mit Preisempfehlung",
  "Wertermittlung": "So ermitteln wir den Wert",
  "Energieausweis": "Pflicht beim Verkauf",
  "Immobilienpreise Köln": "Amtliche Richtwerte",
  "Alle Stadtteile & Preise": "116 Lagen durchsuchen",
};
const liveLinks: Record<string, string> = {
  ...Object.fromEntries(services.map((service) => [service.title, `/leistung/${service.slug}/`])),
  "Aktuelle Objekte": "/immobilien/",
  "Suchprofil anlegen": "/suchservice/",
  "After-Sales-Service": "/leistung/after-sales-service/",
  "Immobilienpreise Köln": "/immobilienpreise-koeln/",
  "Köln-Marienburg": "/immobilienpreise-koeln/?ort=Marienburg#stadtteile",
  "Köln-Lindenthal": "/immobilienpreise-koeln/?ort=Lindenthal#stadtteile",
  "Köln-Sülz": "/immobilienpreise-koeln/?ort=S%C3%BClz#stadtteile",
  "Köln-Rodenkirchen": "/immobilienpreise-koeln/?ort=Rodenkirchen#stadtteile",
  "Alle Stadtteile & Preise": "/immobilienpreise-koeln/#stadtteile",
  "Home Staging": "/leistung/home-staging/",
  "360-Grad-Rundgang": "/leistung/rundgang-360-grad/",
  "Tippgeber": "/leistung/tippgeber/",
  "Online bewerten": "/leistung/formular/",
  "Bewertung vor Ort": "/kontakt/#termin",
  "Energieausweis": "/leistung/energieausweis/",
  "Termin vereinbaren": "/kontakt/#termin",
  "Immobilien kaufen": "/immobilien/?typ=kaufen",
  "Immobilien mieten": "/immobilien/?typ=mieten",
  "Kapitalanlagen": "/immobilien/",
  "Suchauftrag": "/suchservice/",
  "Diskrete Angebote": "/#diskretion",
  "Finanzierung": "/leistung/finanzierung/",
  "Immobilie verkaufen": "/leistung/immobilienverkauf/",
  "Immobilie vermieten": "/leistung/immobilienvermietung/",
  "Diskret vermarkten": "/leistung/diskrete-vermarktung/",
  "Wertermittlung": "/leistung/wertermittlung/",
  "Fotografie": "/leistung/fotografie-und-expose/",
  "Besichtigungen": "/leistung/besichtigungen/",
  "Bauträgervertrieb": "/leistung/bautraeger-vertrieb/",
  "Portfoliovertrieb": "/leistung/portfolio-vertrieb/",
  "Alle Leistungen": "/leistung/",
  "Über SAYAN": "/ueber-uns/",
  "Team": "/ueber-uns/#team",
  "10 gute Gründe": "/ueber-uns/#warum-wir",
  "Arbeitsweise": "/#ablauf",
  "Leistungen": "/leistung/",
  "Kontakt": "/kontakt/",
  "Alle Angebote": "/immobilien/",
  "Häufige Fragen": "/#faq",
};
---

<header class="site-header" data-header>
  <button class="nav-backdrop" type="button" data-close-mega hidden aria-label="Navigation schließen"></button>
  <div class="top-bar">
    <div class="container top-bar__inner">
      <a class="top-bar__rating" href={googleRating.url} target="_blank" rel="noopener"><strong>Google</strong> <span class="top-bar__stars" aria-hidden="true">★★★★★</span> <b>{googleRating.value.toLocaleString("de-DE")}</b> · {googleRating.count} Bewertungen</a>
      <div class="top-bar__links">
        <a href="tel:+4922116892660">0221 168 926 60</a>
        <a href="mailto:info@sayan-immo.de">info@sayan-immo.de</a>
        <a href="/kontakt/#termin">Termin vereinbaren</a>
        <span class="lang-switch" aria-label="Sprache / Language">
          <a href={langLinks.de} hreflang="de" lang="de" aria-current={lang === "de" ? "true" : undefined}>DE</a>
          <a href={langLinks.en} hreflang="en" lang="en" aria-current={lang === "en" ? "true" : undefined}>EN</a>
        </span>
      </div>
    </div>
  </div>
  <div class="nav-wrap">
    <div class="container nav-inner">
      <a class="brand-link" href="/" aria-label="Zur Startseite">
        <span class="logo-light"><Logo variant="dark" /></span>
        <span class="logo-dark"><Logo variant="dark" /></span>
      </a>

      <nav class="desktop-nav" aria-label="Hauptnavigation">
        {groups.map((group, index) => group.href ? (
          <a href={group.href}>{group.label}</a>
        ) : (
          <div class="nav-group">
            <button class="nav-trigger" type="button" aria-expanded="false" aria-controls={`mega-${index}`}>
              {group.label}
            </button>
            <div class="mega-menu" id={`mega-${index}`} hidden>
              <div class="mega-menu__inner" style={`--cols:${group.columns!.length}`}>
                {group.columns!.map((column) => (
                  <div class="mega-column">
                    <p>{column.title}</p>
                    {column.links.map((link) => <a href={liveLinks[link]}><span class="mega-link__text"><span>{link}</span>{linkHints[link] && <small>{linkHints[link]}</small>}</span></a>)}
                  </div>
                ))}
                <a class="mega-promo" href={group.promoHref}>
                  <img src={group.promoImage} alt="" loading="lazy" width="800" height="520" />
                  <span class="mega-promo__body"><small>{group.promoEyebrow}</small><strong>{group.promo}</strong><span>{group.promoText}</span><em>Mehr erfahren →</em></span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </nav>

      <a class="nav-cta" href="/kontakt/#termin"><span class="nav-cta__dot" aria-hidden="true"></span>Termin vor Ort</a>
      <button class="menu-toggle" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <div class="mobile-menu__top">
      <Logo variant="dark" />
      <button class="menu-close" type="button" aria-label="Menü schließen">×</button>
    </div>
    <div class="mobile-menu__groups">
      {groups.map((group) => group.href ? (
        <a href={group.href}>{group.label}</a>
      ) : (
        <details>
          <summary>{group.label}</summary>
          {group.columns!.flatMap((column) => column.links).map((link) => <a href={liveLinks[link]}>{link}</a>)}
        </details>
      ))}
    </div>
    <div class="mobile-menu__footer">
      <a class="button" href="/kontakt/#termin">Termin vor Ort vereinbaren</a>
      <a class="mobile-menu__phone" href="tel:+4922116892660">0221 168 926 60 anrufen</a>
      <span class="lang-switch lang-switch--mobile" aria-label="Sprache / Language">
        <a href={langLinks.de} hreflang="de" lang="de" aria-current={lang === "de" ? "true" : undefined}>Deutsch</a>
        <a href={langLinks.en} hreflang="en" lang="en" aria-current={lang === "en" ? "true" : undefined}>English</a>
      </span>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const triggers = document.querySelectorAll<HTMLButtonElement>(".nav-trigger");
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const closeButton = document.querySelector<HTMLButtonElement>(".menu-close");
  const mobileMenu = document.querySelector<HTMLElement>("#mobile-menu");
  const backdrop = document.querySelector<HTMLButtonElement>(".nav-backdrop");
  const syncMegaState = () => {
    const open = [...triggers].some(trigger => trigger.getAttribute("aria-expanded") === "true");
    header?.classList.toggle("mega-open", open);
    if (backdrop) backdrop.hidden = !open;
  };

  const closeMegaMenus = (except?: HTMLButtonElement) => {
    triggers.forEach((trigger) => {
      if (trigger === except) return;
      trigger.setAttribute("aria-expanded", "false");
      const panel = document.getElementById(trigger.getAttribute("aria-controls") ?? "");
      if (panel) panel.hidden = true;
    });
    syncMegaState();
  };

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const willOpen = trigger.getAttribute("aria-expanded") !== "true";
      closeMegaMenus(trigger);
      trigger.setAttribute("aria-expanded", String(willOpen));
      const panel = document.getElementById(trigger.getAttribute("aria-controls") ?? "");
      if (panel) panel.hidden = !willOpen;
      syncMegaState();
    });
  });

  document.addEventListener("click", (event) => {
    if (event.target instanceof Element && !event.target.closest(".nav-group")) closeMegaMenus();
  });

  // Desktop: Mega-Menü öffnet schon beim Drüberfahren.
  const canHover = window.matchMedia("(hover: hover) and (min-width: 1024px)");
  let hoverTimer: number | undefined;
  document.querySelectorAll<HTMLElement>(".nav-group").forEach((group) => {
    const trigger = group.querySelector<HTMLButtonElement>(".nav-trigger");
    const panel = group.querySelector<HTMLElement>(".mega-menu");
    if (!trigger || !panel) return;
    const open = () => {
      window.clearTimeout(hoverTimer);
      if (trigger.getAttribute("aria-expanded") === "true") return;
      closeMegaMenus(trigger);
      trigger.setAttribute("aria-expanded", "true");
      panel.hidden = false;
      syncMegaState();
    };
    group.addEventListener("mouseenter", () => { if (canHover.matches) { window.clearTimeout(hoverTimer); hoverTimer = window.setTimeout(open, 90); } });
    group.addEventListener("mouseleave", () => { if (canHover.matches) { window.clearTimeout(hoverTimer); hoverTimer = window.setTimeout(() => closeMegaMenus(), 220); } });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-close-mega]").forEach(button => {
    button.addEventListener("click", () => {
      const active = [...triggers].find(trigger => trigger.getAttribute("aria-expanded") === "true");
      closeMegaMenus();
      active?.focus();
    });
  });
  window.matchMedia("(max-width: 1023px)").addEventListener("change", event => { if (event.matches) closeMegaMenus(); });
  document.addEventListener("focusin", event => { if (event.target instanceof Node && !header?.contains(event.target)) closeMegaMenus(); });

  const updateHeader = () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 60);
  };
  window.addEventListener("scroll", updateHeader, { passive: true });
  updateHeader();

  const setMobileMenu = (open: boolean) => {
    if (!mobileMenu || !toggle) return;
    mobileMenu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    document.body.classList.toggle("menu-open", open);
    if (open) closeButton?.focus();
    else toggle.focus();
  };
  toggle?.addEventListener("click", () => setMobileMenu(toggle.getAttribute("aria-expanded") !== "true"));
  closeButton?.addEventListener("click", () => setMobileMenu(false));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") { closeMegaMenus(); if (mobileMenu && !mobileMenu.hidden) setMobileMenu(false); }
    if (event.key !== "Tab" || !mobileMenu || mobileMenu.hidden) return;
    const items = [...mobileMenu.querySelectorAll<HTMLElement>('a[href], button, summary')].filter(item => item.getClientRects().length);
    const first = items[0], last = items[items.length - 1];
    if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
    else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
  });
</script>
