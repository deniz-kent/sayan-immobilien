---
import Logo from "./Logo.astro";
import ServiceIcon from "./ServiceIcon.astro";

const groups = [
  {
    label: "Immobilien",
    columns: [
      { title: "Angebot", links: ["Immobilien kaufen", "Immobilien mieten", "Kapitalanlagen"] },
      { title: "Service", links: ["Suchauftrag", "Diskrete Angebote", "Finanzierung"] },
    ],
    promo: "Aktuelle Immobilien in Köln",
    promoHref: "/immobilien/",
    promoAction: "Angebote ansehen",
    promoImage: "/images/haus-modern-klinker.webp",
  },
  {
    label: "Verkaufen",
    columns: [
      { title: "Eigentümer", links: ["Immobilie verkaufen", "Immobilie vermieten", "Diskret vermarkten"] },
      { title: "Weitere Leistungen", links: ["Alle Leistungen", "Wertermittlung", "Fotografie", "Besichtigungen", "Bauträgervertrieb", "Portfoliovertrieb"] },
    ],
    promo: "Immobilie bewerten lassen",
    promoHref: "/leistung/formular/",
    promoAction: "Bewertung starten",
    promoImage: "/images/sayan-beratung-640.webp",
  },
  {
    label: "Unternehmen",
    columns: [
      { title: "SAYAN", links: ["Über SAYAN", "Arbeitsweise"] },
      { title: "Einblicke", links: ["Alle Leistungen", "Kontakt", "Häufige Fragen"] },
    ],
    promo: "SAYAN Immobilien Köln seit 2001",
    promoHref: "/#unternehmen",
    promoAction: "SAYAN kennenlernen",
    promoImage: "/images/sayan-persoenlich-640.webp",
  },
];
const liveLinks: Record<string, string> = {
  "Immobilien kaufen": "/immobilien/?typ=kaufen",
  "Immobilien mieten": "/immobilien/?typ=mieten",
  "Kapitalanlagen": "/immobilien/",
  "Suchauftrag": "/suchservice/",
  "Diskrete Angebote": "/#diskretion",
  "Finanzierung": "/leistung/finanzierung/",
  "Immobilie verkaufen": "/leistung/immobilienverkauf/",
  "Immobilie vermieten": "/leistung/immobilienvermietung/",
  "Diskret vermarkten": "/leistung/diskrete-vermarktung/",
  "Wertermittlung": "/leistung/wertermittlung/",
  "Fotografie": "/leistung/fotografie-und-expose/",
  "Besichtigungen": "/leistung/besichtigungen/",
  "Bauträgervertrieb": "/leistung/bautraeger-vertrieb/",
  "Portfoliovertrieb": "/leistung/portfolio-vertrieb/",
  "Alle Leistungen": "/leistung/#all-services-title",
  "Über SAYAN": "/#unternehmen",
  "Arbeitsweise": "/#ablauf",
  "Leistungen": "/leistung/",
  "Kontakt": "/kontakt/",
  "Häufige Fragen": "/#faq",
};
const linkIcon = (label: string) => {
  const service = liveLinks[label]?.match(/^\/leistung\/([^/]+)\//)?.[1];
  if (service) return service;
  const icons: Record<string, string> = { "Immobilien kaufen": "home", "Immobilien mieten": "key", "Kapitalanlagen": "building", "Suchauftrag": "monitor", "Diskrete Angebote": "lock", "Über SAYAN": "users", "Arbeitsweise": "handshake", "Kontakt": "users", "Häufige Fragen": "file" };
  return icons[label] ?? "building";
};
---

<header class="site-header" data-header>
  <button class="nav-backdrop" type="button" data-close-mega hidden aria-label="Navigation schließen"></button>
  <div class="nav-wrap">
    <div class="container nav-inner">
      <a class="brand-link" href="/" aria-label="Zur Startseite">
        <span class="logo-light"><Logo variant="dark" /></span>
        <span class="logo-dark"><Logo variant="dark" /></span>
      </a>

      <nav class="desktop-nav" aria-label="Hauptnavigation">
        {groups.map((group, index) => (
          <div class="nav-group">
            <button class="nav-trigger" type="button" aria-expanded="false" aria-controls={`mega-${index}`}>
              {group.label}
            </button>
            <div class="mega-menu" id={`mega-${index}`} hidden>
              <div class="container mega-menu__head"><div><p>SAYAN Immobilien Köln</p><h2>{group.label}</h2></div><a class="mega-all-services" href="/leistung/#all-services-title">Alle Leistungen</a><button type="button" data-close-mega>Schließen <span aria-hidden="true">×</span></button></div>
              <div class="container mega-menu__inner">
                {group.columns.map((column) => (
                  <div class="mega-column">
                    <p>{column.title}</p>
                    {column.links.map((link) => <a href={liveLinks[link]}><span class="mega-link-icon"><ServiceIcon name={linkIcon(link)} /></span><span>{link}</span></a>)}
                  </div>
                ))}
                <a class="mega-promo" href={group.promoHref}>
                  <img src={group.promoImage} alt="" loading="lazy" width="640" height="430" />
                  <span>Direkter Einstieg</span>
                  <strong>{group.promo}</strong>
                  <small>{group.promoAction}</small>
                </a>
              </div>
            </div>
          </div>
        ))}
          <a href="/kontakt/">Kontakt</a>
      </nav>

      <a class="nav-cta" href="/#online-bewertung" data-open-advice><span class="nav-cta__dot" aria-hidden="true"></span>Immobilie bewerten</a>
      <button class="menu-toggle" type="button" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobile-menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <div class="mobile-menu__top">
      <Logo variant="dark" />
      <button class="menu-close" type="button" aria-label="Menü schließen">×</button>
    </div>
    <div class="mobile-menu__groups">
      <a class="mobile-all-services" href="/leistung/#all-services-title">Alle Leistungen</a>
      {groups.map((group) => (
        <details>
          <summary>{group.label}</summary>
          {group.columns.flatMap((column) => column.links).map((link) => <a href={liveLinks[link]}>{link}</a>)}
        </details>
      ))}
      <a href="/kontakt/">Kontakt</a>
    </div>
    <div class="mobile-menu__footer">
      <a class="button" href="/#online-bewertung" data-open-advice>Immobilie bewerten</a>
      <a href="tel:+4922116892660">0221 / 168 926 60</a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const triggers = document.querySelectorAll<HTMLButtonElement>(".nav-trigger");
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const closeButton = document.querySelector<HTMLButtonElement>(".menu-close");
  const mobileMenu = document.querySelector<HTMLElement>("#mobile-menu");
  const backdrop = document.querySelector<HTMLButtonElement>(".nav-backdrop");
  const syncMegaState = () => {
    const open = [...triggers].some(trigger => trigger.getAttribute("aria-expanded") === "true");
    header?.classList.toggle("mega-open", open);
    if (backdrop) backdrop.hidden = !open;
  };

  const closeMegaMenus = (except?: HTMLButtonElement) => {
    triggers.forEach((trigger) => {
      if (trigger === except) return;
      trigger.setAttribute("aria-expanded", "false");
      const panel = document.getElementById(trigger.getAttribute("aria-controls") ?? "");
      if (panel) panel.hidden = true;
    });
    syncMegaState();
  };

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const willOpen = trigger.getAttribute("aria-expanded") !== "true";
      closeMegaMenus(trigger);
      trigger.setAttribute("aria-expanded", String(willOpen));
      const panel = document.getElementById(trigger.getAttribute("aria-controls") ?? "");
      if (panel) panel.hidden = !willOpen;
      syncMegaState();
    });
  });

  document.addEventListener("click", (event) => {
    if (event.target instanceof Element && !event.target.closest(".nav-group")) closeMegaMenus();
  });

  document.querySelectorAll<HTMLButtonElement>("[data-close-mega]").forEach(button => {
    button.addEventListener("click", () => {
      const active = [...triggers].find(trigger => trigger.getAttribute("aria-expanded") === "true");
      closeMegaMenus();
      active?.focus();
    });
  });
  window.matchMedia("(max-width: 1023px)").addEventListener("change", event => { if (event.matches) closeMegaMenus(); });
  document.addEventListener("focusin", event => { if (event.target instanceof Node && !header?.contains(event.target)) closeMegaMenus(); });

  const updateHeader = () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 60);
  };
  window.addEventListener("scroll", updateHeader, { passive: true });
  updateHeader();

  const setMobileMenu = (open: boolean) => {
    if (!mobileMenu || !toggle) return;
    mobileMenu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    document.body.classList.toggle("menu-open", open);
    if (open) closeButton?.focus();
    else toggle.focus();
  };
  toggle?.addEventListener("click", () => setMobileMenu(toggle.getAttribute("aria-expanded") !== "true"));
  closeButton?.addEventListener("click", () => setMobileMenu(false));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") { closeMegaMenus(); if (mobileMenu && !mobileMenu.hidden) setMobileMenu(false); }
    if (event.key !== "Tab" || !mobileMenu || mobileMenu.hidden) return;
    const items = [...mobileMenu.querySelectorAll<HTMLElement>('a[href], button, summary')].filter(item => item.getClientRects().length);
    const first = items[0], last = items[items.length - 1];
    if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
    else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
  });
</script>
