---
interface Props {
  name: string;
  role: string;
  copy: string;
  proof: string;
}

const { name, role, copy, proof } = Astro.props;
---

<article class="person-card" data-reveal>
  <div class="media-placeholder media-placeholder--portrait" role="img" aria-label={`Portrait von ${name} – Platzhalter`}>
    <span>Portrait<br />Platzhalter</span>
  </div>
  <div class="person-card__body">
    <h3>{name}</h3>
    <p class="person-role">{role}</p>
    <p>{copy}</p>
    <strong class="person-proof">{proof}</strong>
    <span class="signature-placeholder" aria-label="Unterschrift Platzhalter">Unterschrift · Platzhalter</span>
    <a class="text-link" href="/kontakt/#termin">Gespräch anfragen →</a>
  </div>
</article>
