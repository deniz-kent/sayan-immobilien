---
interface Props {
  variant?: "light" | "dark" | "mono";
}

const { variant = "dark" } = Astro.props;
const sources = {
  light: "/brand/header-logo-negativ.svg",
  dark: "/brand/header-logo-farbe.svg",
  mono: "/brand/header-logo-anthrazit.svg",
};
---

<img class:list={["logo", `logo--${variant}`]} src={sources[variant]} alt="SAYAN Immobilien" width="354" height="104" />

<style>
  .logo { width: clamp(9.5rem, 14vw, 12rem); height: auto; }
</style>
