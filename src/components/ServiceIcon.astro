---
// Icons: Phosphor Icons (MIT-Lizenz), Stil "duotone".
// Die Kontur nimmt die Textfarbe an, die Fläche wird in SAYAN-Limette gefüllt.
import { readFileSync } from "node:fs";
import { createRequire } from "node:module";

interface Props { name: string; size?: number; }
const { name, size = 26 } = Astro.props;

// Eigene Kurznamen -> Phosphor-Icon
const phosphor: Record<string, string> = {
  home: "house", key: "key", calculator: "calculator", chart: "chart-line-up", file: "file-text",
  camera: "camera", panorama: "panorama", sparkles: "sparkle", pin: "map-pin", users: "users",
  lock: "lock", handshake: "handshake", building: "buildings", monitor: "magnifying-glass",
  megaphone: "megaphone", leaf: "leaf", coins: "coins", gift: "gift", check: "user-circle-check",
};

// Leistungsseite -> Kurzname
const serviceIcons: Record<string, string> = {
  "immobilienverkauf": "home", "immobilienvermietung": "key", "wertermittlung": "calculator", "marktpreisanalyse": "chart",
  "verkaufsunterlagen": "file", "energieausweis": "leaf", "fotografie-und-expose": "camera", "rundgang-360-grad": "panorama",
  "home-staging": "sparkles", "besichtigungen": "pin", "interessentenpruefung": "check", "diskrete-vermarktung": "lock",
  "verkaufsabwicklung": "handshake", "finanzierung": "coins", "bautraeger-vertrieb": "building", "portfolio-vertrieb": "chart",
  "vermarktung": "megaphone", "after-sales-service": "handshake", "tippgeber": "gift",
};

const require = createRequire(import.meta.url);
const file = phosphor[serviceIcons[name] ?? name] ?? "house";
const raw = readFileSync(require.resolve(`@phosphor-icons/core/assets/duotone/${file}-duotone.svg`), "utf8");
const inner = raw.replace(/^<svg[^>]*>/, "").replace(/<\/svg>\s*$/, "").replace(/opacity="0\.2"/g, 'class="duo"');
---
<svg class="service-icon" width={size} height={size} viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" set:html={inner} />

<style>
  .service-icon :global(.duo) { fill: var(--accent); opacity: .85; }
</style>
