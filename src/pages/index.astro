---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionHeader from "../components/SectionHeader.astro";
import PropertyCard from "../components/PropertyCard.astro";
import StatBlock from "../components/StatBlock.astro";

const principles = [
  { number: "01", title: "Eine Person bleibt verantwortlich.", copy: "Von der ersten Einordnung bis zur Übergabe bleibt klar, wer Ihr Anliegen führt. Zuständigkeit ist bei uns kein Kleingedrucktes." },
  { number: "02", title: "Diskretion ist ein Verfahren.", copy: "Nicht jedes Objekt gehört sofort auf ein Portal. Wir klären gemeinsam, welche Sichtbarkeit zur Situation und zum gewünschten Ergebnis passt." },
  { number: "03", title: "Jede Aussage braucht Herkunft.", copy: "Zahlen, Bewertungen und Marktangaben erscheinen erst, wenn Quelle und Stichtag feststehen. Bis dahin bleiben sie sichtbar als Platzhalter markiert." },
];
---

<BaseLayout
  title="SAYAN Immobilien Köln | Persönlich seit 2001"
  description="SAYAN Immobilien begleitet Verkäufer und Käufer in Köln persönlich, diskret und mit Erfahrung seit 2001."
>
  <Header />
  <main id="main">
    <section class="hero section--brand">
      <div class="hero-media" aria-hidden="true">
        <span>Hero-Medium · Platzhalter</span>
      </div>
      <div class="hero-overlay"></div>
      <div class="container hero-grid">
        <div class="hero-copy" data-reveal>
          <p class="eyebrow">Immobilienvermittlung · Köln</p>
          <h1>Immobilien verdienen eine klare <em>Entscheidung.</em></h1>
          <p class="hero-lead">SAYAN begleitet Verkäufer und Käufer persönlich, diskret und mit Erfahrung seit 2001.</p>
          <div class="hero-actions">
            <a class="button" href="/kontakt/#termin">Termin vereinbaren →</a>
            <a class="button button--secondary" href="#unternehmen">SAYAN kennenlernen →</a>
          </div>
        </div>

        <form class="hero-form" action="/leistung/formular/" method="get" data-entry-form novalidate data-reveal>
          <p class="hero-form__eyebrow">Ihr Einstieg · ca. 60 Sekunden</p>
          <h2>Was dürfen wir für Sie einordnen?</h2>
          <div class="mini-proof" aria-label="Leistungsversprechen">
            <span><small>Erfahrung</small><strong>seit 2001</strong></span>
            <span><small>Kontakt</small><strong>persönlich</strong></span>
            <span><small>Schritt 1</small><strong>unverbindlich</strong></span>
          </div>
          <div class="entry-tabs" role="tablist" aria-label="Anfragetyp">
            <button type="button" role="tab" aria-selected="true" data-tab="verkaufen">Verkaufen</button>
            <button type="button" role="tab" aria-selected="false" data-tab="kaufen">Kaufen</button>
          </div>
          <input type="hidden" name="anliegen" value="verkaufen" data-intent />
          <label for="entry-location">Adresse oder gewünschte Lage</label>
          <div class="entry-field">
            <input id="entry-location" name="ort" type="text" autocomplete="street-address" placeholder="z. B. Köln-Lindenthal" aria-describedby="entry-error entry-note" required />
            <button type="submit" aria-label="Eingabe übernehmen">→</button>
          </div>
          <p class="field-error" id="entry-error" aria-live="polite"></p>
          <p class="micro" id="entry-note">Unverbindlich · ohne Anmeldung · keine Weitergabe an Dritte</p>
        </form>
      </div>
      <div class="trust-bar">
        <div class="container trust-bar__inner">
          <span><small>Gründung</small><strong>2001</strong></span>
          <span><small>Bewertungen</small><strong>Platzhalter</strong></span>
          <span><small>Verband</small><strong>Logo folgt</strong></span>
          <span><small>Auszeichnung</small><strong>Nachweis folgt</strong></span>
        </div>
      </div>
    </section>

    <section class="section section--light" id="unternehmen">
      <div class="container">
        <div class="about-grid grid-12">
          <div class="about-media media-placeholder" role="img" aria-label="Unternehmensbild Platzhalter" data-reveal>
            <span>Unternehmensbild<br />Platzhalter</span>
          </div>
          <div class="about-copy" data-reveal>
            <p class="eyebrow">Wer wir sind</p>
            <h2>Persönlich geführt, klar <em>verantwortet.</em></h2>
            <p>SAYAN Immobilien wurde 2001 in Köln gegründet. Candan Sayan begleitet Eigentümer, Käufer und Mieter persönlich bei Entscheidungen rund um Wohn-, Gewerbe- und Anlageimmobilien.</p>
            <p>Persönliche Zuständigkeit und eine klare Einordnung stehen vor öffentlicher Lautstärke. Bei sensiblen Situationen kann die Vermarktung bewusst diskret beginnen.</p>
            <a class="text-link" href="/kontakt/#termin">Candan Sayan kontaktieren →</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--dark-alt">
      <div class="container">
        <SectionHeader
          eyebrow="Vermarktung und Verfahren"
          title="Vermarktung beginnt mit <em>Klarheit.</em>"
          lead="Bewertung, Präsentation und Auswahl der Interessenten folgen einem nachvollziehbaren Ablauf. Belegbare Kennzahlen werden ergänzt, sobald Quellen und Stichtage vorliegen."
        />
        <div class="technology-grid grid-12">
          <div class="technology-copy" data-reveal>
            <p>Jede Immobilie beginnt mit einer Einordnung: Lage, Zustand, Zielgruppe und Anlass. Erst danach entscheidet sich, ob das Objekt öffentlich, vorgemerkt oder vollständig diskret angeboten wird.</p>
          </div>
          <div class="technology-stats">
            <StatBlock value="seit 2001" label="SAYAN Immobilien in Köln" source="Unternehmensangabe: Gründung 2001." />
            <StatBlock value="Daten folgen" label="Belegte Vermarktungsergebnisse" source="Platzhalter bis zur bestätigten Datengrundlage." placeholder />
          </div>
        </div>
        <div class="partner-strip" id="partner" data-reveal>
          <p class="eyebrow">Integrierte Partner und Plattformen · Platzhalter</p>
          <div class="marquee" aria-label="Partnerlogos Platzhalter">
            <div class="marquee__track">
              {["Partnerlogo 01", "Partnerlogo 02", "Partnerlogo 03", "Partnerlogo 04", "Partnerlogo 01", "Partnerlogo 02", "Partnerlogo 03", "Partnerlogo 04"].map((logo) => <span>{logo}</span>)}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--paper" id="objekte">
      <div class="container">
        <SectionHeader
          eyebrow="Ausgewähltes Projekt · Platzhalter"
          title="Ein Projekt zeigt den <em>Anspruch.</em>"
          lead="Die folgenden Inhalte markieren die spätere Referenzdarstellung. Objektangaben werden erst nach Freigabe veröffentlicht."
          linkLabel="Objekt anfragen"
          linkHref="#kontakt"
        />
        <div class="featured-project">
          <div class="featured-project__media media-placeholder" role="img" aria-label="Referenzprojekt Bild Platzhalter" data-reveal>
            <span>Referenzbild · Platzhalter</span>
          </div>
          <div class="featured-project__content" data-reveal>
            <p class="eyebrow">Köln · Kategorie folgt</p>
            <h3>Ausgewähltes Referenzprojekt.</h3>
            <p>Beschreibung, Vermarktungsweg und Ergebnis werden nach Freigabe eines echten Projekts ergänzt.</p>
            <div class="mini-stats">
              <span><small>Fläche</small><strong>folgt</strong></span>
              <span><small>Zimmer</small><strong>folgt</strong></span>
              <span><small>Ergebnis</small><strong>folgt</strong></span>
            </div>
            <a class="button" href="#kontakt">Projekt anfragen →</a>
          </div>
        </div>
        <div class="property-grid property-grid--compact">
          <PropertyCard index="01" />
          <PropertyCard index="02" />
          <PropertyCard index="03" />
        </div>
      </div>
    </section>

    <section class="section section--light" id="referenzen">
      <div class="container">
        <SectionHeader
          eyebrow="Referenzen · Platzhalter"
          title="Ergebnisse brauchen einen nachvollziehbaren <em>Weg.</em>"
          lead="Echte Referenzen werden später mit Objektart, Ausgangslage und belegtem Ergebnis veröffentlicht."
          linkLabel="Referenz anfragen"
          linkHref="#kontakt"
        />
        <div class="property-grid">
          <PropertyCard index="01" />
          <PropertyCard index="02" />
          <PropertyCard index="03" />
        </div>
        <p class="placeholder-note">Keine dargestellte Karte behauptet aktuell ein reales Objekt oder Verkaufsergebnis.</p>
      </div>
    </section>

    <section class="section section--brand">
      <div class="container">
        <SectionHeader
          eyebrow="Unser Versprechen"
          title="Drei Zusagen, die Bestand <em>haben.</em>"
          lead="Das Versprechen bleibt bewusst überprüfbar: Zuständigkeit, Diskretion und belegbare Aussagen."
        />
        <div class="principles-grid">
          {principles.map((principle) => (
            <article class="principle" data-reveal>
              <span>{principle.number}</span>
              <div>
                <h3>{principle.title}</h3>
                <p>{principle.copy}</p>
              </div>
            </article>
          ))}
        </div>
        <div class="milestone-cta" data-reveal>
          <p>Ein erstes Gespräch klärt Anlass, Zeitrahmen und den passenden Vermarktungsweg.</p>
          <a class="button" href="#kontakt">Gespräch anfragen →</a>
        </div>
      </div>
    </section>

    <section class="section section--light">
      <div class="container">
        <SectionHeader
          eyebrow="Warum SAYAN"
          title="Persönliche Verantwortung statt großer <em>Versprechen.</em>"
          lead="Die Gegenüberstellung beschreibt typische Arbeitsmodelle im Markt. Sie bewertet keine einzelnen Wettbewerber."
        />
        <div class="market-compare">
          <article class="market-compare__own" data-reveal>
            <p class="eyebrow">Das SAYAN-Modell</p>
            <h3>Ein Ansprechpartner bleibt nah am Mandat.</h3>
            <ul>
              <li>Persönlicher Ansprechpartner</li>
              <li>Einordnung vor Veröffentlichung</li>
              <li>Öffentliche oder diskrete Vermarktung</li>
              <li>Abstimmung der Interessentenauswahl</li>
              <li>Begleitung bis zur Übergabe</li>
              <li>Belegte Aussagen statt Fantasiezahlen</li>
            </ul>
          </article>
          <div class="market-compare__models">
            <article data-reveal><span>01</span><h3>Reine Portalvermarktung.</h3><p>Das Objekt wird öffentlich angeboten. Persönliche Strategie und Nachbetreuung können je nach Anbieter unterschiedlich ausfallen.</p></article>
            <article data-reveal><span>02</span><h3>Große Vertriebsstruktur.</h3><p>Reichweite und Prozesse sind standardisiert. Zuständigkeiten können über mehrere Rollen verteilt sein.</p></article>
            <article data-reveal><span>03</span><h3>Privater Alleingang.</h3><p>Der Eigentümer behält die volle Kontrolle, übernimmt aber Bewertung, Unterlagen, Anfragen und Verhandlungen selbst.</p></article>
          </div>
        </div>
        <p class="neutrality-note">Gegenüberstellung typischer Marktmodelle. Keine Aussage über einzelne Wettbewerber.</p>
      </div>
    </section>

    <section class="section section--dark-alt">
      <div class="container">
        <SectionHeader
          eyebrow="Der Einstieg"
          title="Zwei Wege führen zum ersten <em>Gespräch.</em>"
          lead="Wählen Sie den Einstieg, der zu Ihrer Situation passt. Beide Wege bleiben zunächst unverbindlich."
        />
        <div class="path-grid">
          <article class="path-card" data-reveal>
            <div class="path-card__meta"><span>Online</span><span>ca. 60 Sekunden</span></div>
            <h3>Objekt kurz einordnen.</h3>
            <p>Teilen Sie die wichtigsten Eckdaten. Candan Sayan kann das erste Gespräch dadurch konkreter vorbereiten.</p>
            <ul><li>Anlass auswählen</li><li>Objekt grob beschreiben</li><li>Rückrufwunsch hinterlassen</li></ul>
            <a class="button" href="/leistung/formular/">Anfrage starten →</a>
          </article>
          <article class="path-card path-card--recommended" data-reveal>
            <span class="recommendation">Empfohlen</span>
            <div class="path-card__meta"><span>Vor Ort oder telefonisch</span><span>persönlich</span></div>
            <h3>Situation direkt besprechen.</h3>
            <p>Bei sensiblen, komplexen oder zeitkritischen Anlässen ist das direkte Gespräch der ruhigere Anfang.</p>
            <ul><li>Fester Ansprechpartner</li><li>Keine Veröffentlichung</li><li>Nächste Schritte gemeinsam festlegen</li></ul>
            <a class="button" href="#kontakt">Termin anfragen →</a>
          </article>
        </div>
      </div>
    </section>

    <section class="section section--paper" id="marktdaten">
      <div class="container">
        <SectionHeader
          eyebrow="Marktdaten · Quellen folgen"
          title="Daten werden erst mit Quelle <em>sichtbar.</em>"
          lead="Die Tabelle zeigt bereits Bedienung und Struktur. Marktwerte bleiben Platzhalter, bis Quelle, Stichtag und Nutzungsrecht bestätigt sind."
        />
        <div class="data-tool" data-table data-reveal>
          <div class="data-tool__controls">
            <div class="data-tabs" role="tablist" aria-label="Datensatz auswählen">
              <button type="button" role="tab" aria-selected="true" data-dataset="verkauf">Verkauf</button>
              <button type="button" role="tab" aria-selected="false" data-dataset="vermietung">Vermietung</button>
            </div>
            <label>Stadtteil suchen<input type="search" placeholder="z. B. Lindenthal" data-table-search /></label>
          </div>
          <div class="table-scroll">
            <table>
              <thead><tr><th><button type="button" data-sort="0" data-label="Teilmarkt">Teilmarkt ↕</button></th><th><button type="button" data-sort="1" data-label="Objektart">Objektart ↕</button></th><th><button type="button" data-sort="2" data-label="Wert">Wert ↕</button></th><th><button type="button" data-sort="3" data-label="Stichtag">Stichtag ↕</button></th><th><button type="button" data-sort="4" data-label="Tendenz">Tendenz ↕</button></th></tr></thead>
              <tbody data-table-body="verkauf">
                <tr><td>Innenstadt</td><td>Wohnung</td><td>Platzhalter</td><td>Quelle folgt</td><td>—</td></tr>
                <tr><td>Lindenthal</td><td>Haus</td><td>Platzhalter</td><td>Quelle folgt</td><td>—</td></tr>
                <tr><td>Rodenkirchen</td><td>Wohnung</td><td>Platzhalter</td><td>Quelle folgt</td><td>—</td></tr>
                <tr><td>Ehrenfeld</td><td>Wohnung</td><td>Platzhalter</td><td>Quelle folgt</td><td>—</td></tr>
              </tbody>
              <tbody data-table-body="vermietung" hidden>
                <tr><td>Innenstadt</td><td>Wohnung</td><td>Platzhalter</td><td>Quelle folgt</td><td>—</td></tr>
                <tr><td>Lindenthal</td><td>Haus</td><td>Platzhalter</td><td>Quelle folgt</td><td>—</td></tr>
                <tr><td>Rodenkirchen</td><td>Wohnung</td><td>Platzhalter</td><td>Quelle folgt</td><td>—</td></tr>
              </tbody>
            </table>
          </div>
          <div class="data-tool__footer"><span data-row-count>4 Einträge</span><span>Quelle und Stichtag: Platzhalter</span></div>
        </div>
      </div>
    </section>

    <section class="section section--light">
      <div class="container">
        <SectionHeader eyebrow="Der Ablauf" title="Vier Schritte schaffen einen klaren <em>Weg.</em>" />
        <div class="process-line">
          <article data-reveal><span>01</span><h3>Einordnen.</h3><p>Anlass, Objekt und Zeitrahmen gemeinsam klären.</p></article>
          <article data-reveal><span>02</span><h3>Vorbereiten.</h3><p>Unterlagen, Bewertung und Präsentation zusammenführen.</p></article>
          <article data-reveal><span>03</span><h3>Vermarkten.</h3><p>Interessenten gezielt und passend zum Mandat ansprechen.</p></article>
          <article data-reveal><span>04</span><h3>Übergeben.</h3><p>Verhandlung, Abschluss und Übergabe begleiten.</p></article>
        </div>
      </div>
    </section>

    <section class="section section--brand">
      <div class="container">
        <SectionHeader
          eyebrow="Ihre Sicherheit"
          title="Risiken gehören offen auf den <em>Tisch.</em>"
          lead="Vertragsdetails werden nicht mit Werbesätzen ersetzt. Diese Karten zeigen, welche Punkte vor einem Auftrag konkret geklärt werden müssen."
        />
        <div class="security-grid">
          <article data-reveal><span>Risiko</span><h3>Was wird veröffentlicht?</h3><p>Vor dem Start wird festgelegt, welche Daten, Bilder und Grundrisse öffentlich erscheinen dürfen.</p></article>
          <article data-reveal><span>Preis</span><h3>Welche Kosten entstehen?</h3><p>Provision und mögliche Zusatzleistungen werden vor Beauftragung schriftlich eingeordnet. Konkrete Konditionen folgen im Angebot.</p></article>
          <article data-reveal><span>Bindung</span><h3>Wie lange gilt der Auftrag?</h3><p>Laufzeit, Kündigung und Pflichten beider Seiten müssen im Maklervertrag eindeutig benannt sein.</p></article>
        </div>
      </div>
    </section>

    <section class="section section--dark" id="diskretion">
      <div class="container discretion-grid grid-12">
        <div class="discretion-copy" data-reveal>
          <p class="eyebrow">Diskrete Vermarktung</p>
          <h2>Nicht jedes Objekt braucht <em>Öffentlichkeit.</em></h2>
          <p>Bei familiären Veränderungen, sensiblen Vermögenssituationen oder prominenten Objekten kann eine Vermarktung ohne öffentliche Anzeigen der richtige Weg sein.</p>
          <p>Dann werden Informationen nur kontrolliert und an ausgewählte Interessenten weitergegeben. Umfang und Vorgehen werden vorher gemeinsam festgelegt.</p>
          <a class="button" href="#kontakt">Diskret anfragen →</a>
        </div>
        <div class="discretion-number" data-reveal><strong>01</strong><span>vertraulicher Weg, abgestimmt auf Ihre Situation</span></div>
      </div>
    </section>

    <section class="section section--paper">
      <div class="container">
        <SectionHeader
          eyebrow="Ergebnisse und Bewertungen"
          title="Vertrauen braucht überprüfbare <em>Belege.</em>"
          lead="Bewertungswerte, Transaktionszahlen und Kundenstimmen werden erst nach Prüfung ihrer Herkunft veröffentlicht."
        />
        <div class="results-stats">
          <StatBlock value="seit 2001" label="in Köln tätig" source="Unternehmensangabe: Gründung 2001." />
          <StatBlock value="Daten folgen" label="vermittelte Objekte" source="Platzhalter bis zur Freigabe." placeholder />
          <StatBlock value="Daten folgen" label="Bewertungsschnitt" source="Plattform und Stichtag folgen." placeholder />
        </div>
        <div class="review-grid">
          {[1, 2, 3].map((item) => (
            <article class="review-card" data-reveal>
              <p class="review-stars">Bewertung · Platzhalter</p>
              <blockquote>„Originale Kundenstimme wird nach Freigabe und Quellenprüfung ergänzt.“</blockquote>
              <div><span>P{item}</span><p><strong>Name folgt</strong><small>Quelle folgt</small></p></div>
            </article>
          ))}
        </div>
        <p class="neutrality-note">Noch keine Bewertung wird als echt dargestellt. Plattform, Datum und Herkunft werden später ergänzt.</p>
      </div>
    </section>

    <section class="section section--light" id="magazin">
      <div class="container">
        <SectionHeader eyebrow="Magazin" title="Wissen macht Entscheidungen <em>ruhiger.</em>" linkLabel="Thema besprechen" linkHref="#kontakt" />
        <div class="article-grid">
          <article data-reveal><div class="media-placeholder"><span>Beitragsbild · Platzhalter</span></div><p class="eyebrow">Verkauf</p><h3>Welche Unterlagen zuerst gebraucht werden.</h3><small>Ratgeber · Lesedauer folgt</small></article>
          <article data-reveal><div class="media-placeholder"><span>Beitragsbild · Platzhalter</span></div><p class="eyebrow">Bewertung</p><h3>Warum Angebotspreis und Marktwert abweichen.</h3><small>Ratgeber · Lesedauer folgt</small></article>
          <article data-reveal><div class="media-placeholder"><span>Beitragsbild · Platzhalter</span></div><p class="eyebrow">Diskretion</p><h3>Wann ein Verkauf ohne Portal sinnvoll ist.</h3><small>Ratgeber · Lesedauer folgt</small></article>
        </div>
      </div>
    </section>

    <section class="section section--dark-alt" id="kontakt">
      <div class="container contact-grid">
        <div class="contact-copy" data-reveal>
          <p class="eyebrow">Kontakt</p>
          <h2>Ein Gespräch bringt schnell <em>Klarheit.</em></h2>
          <p>Beschreiben Sie kurz Ihr Anliegen. In der Testversion wird das Formular lokal bestätigt und noch nicht versendet.</p>
          <div class="contact-channels">
            <a href="tel:+4922116892660"><span>01</span><strong>+49 221 168 926 60</strong><small>Telefonischer Kontakt</small></a>
            <a href="mailto:info@sayan-immo.de"><span>02</span><strong>info@sayan-immo.de</strong><small>Antwortzeit wird noch bestätigt</small></a>
            <span><span>03</span><strong>Sternengasse 3 · Köln</strong><small>Termin nach Vereinbarung</small></span>
          </div>
        </div>
        <form class="contact-form" data-local-form novalidate data-reveal>
          <div class="field"><label for="contact-name">Name</label><input id="contact-name" name="name" autocomplete="name" required /><p class="field-error" data-error="name"></p></div>
          <div class="field"><label for="contact-email">E-Mail</label><input id="contact-email" name="email" type="email" autocomplete="email" required /><p class="field-error" data-error="email"></p></div>
          <div class="field"><label for="contact-phone">Telefon</label><input id="contact-phone" name="phone" type="tel" autocomplete="tel" /></div>
          <div class="field"><label for="contact-topic">Anliegen</label><select id="contact-topic" name="topic"><option>Immobilie verkaufen</option><option>Immobilie kaufen</option><option>Immobilie vermieten</option><option>Sonstiges</option></select></div>
          <div class="field field--full"><label for="contact-message">Nachricht</label><textarea id="contact-message" name="message" rows="5" required></textarea><p class="field-error" data-error="message"></p></div>
          <label class="consent-check field--full"><input type="checkbox" name="consent" required /> Ich stimme der Verarbeitung meiner Angaben zur Bearbeitung der Anfrage zu.</label>
          <div class="field--full"><button class="button" type="submit">Anfrage vorbereiten →</button><p class="micro">Unverbindlich · keine Weitergabe · in der Testversion ohne Versand</p><p class="form-success" data-form-success hidden>Vielen Dank. Der lokale Test wurde erfolgreich abgeschlossen; es wurden keine Daten versendet.</p></div>
        </form>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    const tabButtons = document.querySelectorAll<HTMLButtonElement>("[data-tab]");
    const intentInput = document.querySelector<HTMLInputElement>("[data-intent]");
    tabButtons.forEach((button) => {
      button.addEventListener("click", () => {
        tabButtons.forEach((item) => item.setAttribute("aria-selected", String(item === button)));
        if (intentInput) intentInput.value = button.dataset.tab ?? "verkaufen";
      });
    });

    const entryForm = document.querySelector<HTMLFormElement>("[data-entry-form]");
    const locationInput = document.querySelector<HTMLInputElement>("#entry-location");
    const error = document.querySelector<HTMLElement>("#entry-error");
    entryForm?.addEventListener("submit", (event) => {
      if (!locationInput?.value.trim()) {
        event.preventDefault();
        if (error) error.textContent = "Bitte geben Sie eine Adresse oder gewünschte Lage ein.";
        locationInput?.setAttribute("aria-invalid", "true");
        locationInput?.focus();
      }
    });
    locationInput?.addEventListener("input", () => {
      if (locationInput.value.trim()) {
        if (error) error.textContent = "";
        locationInput.removeAttribute("aria-invalid");
      }
    });

    const dataTabs = document.querySelectorAll<HTMLButtonElement>("[data-dataset]");
    const tableBodies = document.querySelectorAll<HTMLTableSectionElement>("[data-table-body]");
    const tableSearch = document.querySelector<HTMLInputElement>("[data-table-search]");
    const rowCount = document.querySelector<HTMLElement>("[data-row-count]");
    let activeDataset = "verkauf";
    const updateTable = () => {
      const query = tableSearch?.value.trim().toLocaleLowerCase("de") ?? "";
      let visible = 0;
      tableBodies.forEach((body) => {
        const active = body.dataset.tableBody === activeDataset;
        body.hidden = !active;
        body.querySelectorAll<HTMLTableRowElement>("tr").forEach((row) => {
          const matches = !query || Boolean(row.textContent?.toLocaleLowerCase("de").includes(query));
          row.hidden = !active || !matches;
          if (active && matches) visible += 1;
        });
      });
      if (rowCount) rowCount.textContent = `${visible} ${visible === 1 ? "Eintrag" : "Einträge"}`;
    };
    dataTabs.forEach((button) => button.addEventListener("click", () => {
      activeDataset = button.dataset.dataset ?? "verkauf";
      dataTabs.forEach((item) => item.setAttribute("aria-selected", String(item === button)));
      updateTable();
    }));
    tableSearch?.addEventListener("input", updateTable);

    document.querySelectorAll<HTMLButtonElement>("[data-sort]").forEach((button) => {
      button.addEventListener("click", () => {
        const column = Number(button.dataset.sort ?? 0);
        const direction = button.dataset.direction === "asc" ? "desc" : "asc";
        button.dataset.direction = direction;
        const body = [...tableBodies].find((item) => item.dataset.tableBody === activeDataset);
        if (!body) return;
        [...body.rows]
          .sort((a, b) => {
            const left = a.cells[column]?.textContent?.trim() ?? "";
            const right = b.cells[column]?.textContent?.trim() ?? "";
            return left.localeCompare(right, "de") * (direction === "asc" ? 1 : -1);
          })
          .forEach((row) => body.append(row));
        document.querySelectorAll<HTMLButtonElement>("[data-sort]").forEach((item) => {
          const marker = item === button ? (direction === "asc" ? "↑" : "↓") : "↕";
          item.textContent = `${item.dataset.label ?? "Spalte"} ${marker}`;
        });
        updateTable();
      });
    });

    document.querySelectorAll<HTMLFormElement>("[data-local-form]").forEach((form) => {
      form.addEventListener("submit", (event) => {
        event.preventDefault();
        let valid = true;
        form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input[required], textarea[required]").forEach((field) => {
          const fieldValid = field.type === "checkbox" ? (field as HTMLInputElement).checked : field.validity.valid && Boolean(field.value.trim());
          field.toggleAttribute("aria-invalid", !fieldValid);
          const target = form.querySelector<HTMLElement>(`[data-error="${field.name}"]`);
          if (target) target.textContent = fieldValid ? "" : field.type === "email" ? "Bitte geben Sie eine gültige E-Mail-Adresse ein." : "Bitte füllen Sie dieses Feld aus.";
          if (!fieldValid && valid) field.focus();
          valid = valid && fieldValid;
        });
        const success = form.querySelector<HTMLElement>("[data-form-success]");
        if (success) success.hidden = !valid;
      });
    });
  </script>
</BaseLayout>

