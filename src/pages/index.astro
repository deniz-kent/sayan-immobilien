---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionHeader from "../components/SectionHeader.astro";

const services = [
  {
    number: "01",
    title: "Verkaufen",
    copy: "Von der fundierten Einordnung über die Präsentation bis zum Notartermin: Sie behalten jederzeit den Überblick.",
    href: "/leistung/",
    link: "Verkauf vorbereiten",
  },
  {
    number: "02",
    title: "Vermieten",
    copy: "Wir positionieren Ihre Immobilie passend, prüfen Interessenten sorgfältig und begleiten Sie bis zur Übergabe.",
    href: "/leistung/#vermietung",
    link: "Vermietung besprechen",
  },
  {
    number: "03",
    title: "Kaufen & mieten",
    copy: "Sagen Sie uns, was Sie suchen. Wir gleichen Ihr Profil mit passenden öffentlichen und diskreten Angeboten ab.",
    href: "/kontakt/",
    link: "Suchprofil mitteilen",
  },
];

const process = [
  ["01", "Verstehen", "Wir klären Ihre Situation, Ihre Ziele und den gewünschten Zeitrahmen."],
  ["02", "Einordnen", "Wir betrachten Lage, Zustand, Unterlagen und die aktuelle Nachfrage."],
  ["03", "Vermarkten", "Wir wählen den passenden Weg – öffentlich, vorgemerkt oder diskret."],
  ["04", "Abschließen", "Wir begleiten Verhandlung, Notartermin und geordnete Übergabe."],
];
---

<BaseLayout
  title="SAYAN Immobilien Köln | Persönlich seit 2001"
  description="Persönliche Immobilienvermittlung in Köln: Verkauf, Vermietung und Immobiliensuche mit Candan Sayan als direktem Ansprechpartner."
>
  <Header />
  <main id="main">
    <section class="home-hero">
      <div class="container home-hero__grid">
        <div class="home-hero__copy" data-reveal>
          <p class="eyebrow">Immobilienvermittlung · Köln</p>
          <h1>Ihre Immobilie verdient eine klare <em>Entscheidung.</em></h1>
          <p class="home-hero__lead">
            Ob Verkauf, Vermietung oder Suche: Candan Sayan begleitet Sie persönlich, verbindlich und mit
            Erfahrung seit 2001.
          </p>
          <div class="home-hero__actions">
            <a class="button" href="#online-bewertung">Bewertung starten →</a>
            <a class="button button--outline" href="/kontakt/">Persönlich sprechen →</a>
          </div>
        </div>

        <aside class="hero-valuation" id="online-bewertung" data-reveal aria-label="Online-Immobilienbewertung">
          <div class="hero-valuation__head">
            <p class="eyebrow">Kostenlose Ersteinschätzung</p>
            <h2>Was ist Ihre Immobilie wert?</h2>
          </div>
          <p class="widget-status" data-bottimmo-status>Bewertung wird geladen …</p>
          <btm-widget widget="valuation"></btm-widget>
          <p class="widget-error" data-bottimmo-error hidden>Die Bewertung konnte gerade nicht geladen werden. Rufen Sie uns gern unter <a href="tel:+4922116892660">0221 / 168 926 60</a> an.</p>
        </aside>
      </div>
      <div class="proof-line">
        <div class="container proof-line__inner">
          <span>Persönlicher Ansprechpartner</span>
          <span>Fundierte Wertermittlung</span>
          <span>Öffentliche oder diskrete Vermarktung</span>
          <span>Köln & Region</span>
        </div>
      </div>
    </section>

    <section class="section section--light" id="unternehmen">
      <div class="container owner-grid">
        <div class="owner-mark" aria-hidden="true" data-reveal><span>CS</span><small>Persönlich für Sie da</small></div>
        <div class="owner-copy" data-reveal>
          <p class="eyebrow">Candan Sayan · Inhaber</p>
          <h2>Eine Entscheidung. Ein fester <em>Ansprechpartner.</em></h2>
          <p>Eine Immobilie zu verkaufen oder zu vermieten ist selten nur eine sachliche Entscheidung. Es geht um Vermögen, Veränderungen und oft auch um persönliche Geschichte. Deshalb führt Candan Sayan Ihr Anliegen selbst – vom ersten Gespräch bis zur Übergabe.</p>
          <p>Seit 1998 in der Immobilienbranche und seit 2001 mit SAYAN Immobilien in Köln verbindet er lokale Marktkenntnis mit einer ruhigen, nachvollziehbaren Beratung.</p>
          <a class="text-link" href="/kontakt/">Candan Sayan kennenlernen →</a>
        </div>
      </div>
    </section>

    <section class="section section--paper" id="leistungen">
      <div class="container">
        <SectionHeader eyebrow="Was wir für Sie tun" title="Immobilienentscheidungen brauchen <em>Orientierung.</em>" lead="Sie erhalten keinen Standardablauf, sondern einen Weg, der zu Ihrer Immobilie, Ihrem Ziel und Ihrer Situation passt." />
        <div class="service-grid">
          {services.map((service) => (
            <article class="service-card" data-reveal>
              <span>{service.number}</span><h3>{service.title}.</h3><p>{service.copy}</p>
              <a class="text-link" href={service.href}>{service.link} →</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--dark-alt" id="ablauf">
      <div class="container">
        <SectionHeader eyebrow="Der SAYAN-Weg" title="Von der ersten Frage bis zur sicheren <em>Übergabe.</em>" lead="Sie wissen jederzeit, wo Ihr Vorhaben steht, was als Nächstes passiert und welche Entscheidung ansteht." />
        <div class="process-grid">
          {process.map(([number, title, copy]) => (
            <article data-reveal><span>{number}</span><h3>{title}.</h3><p>{copy}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--brand">
      <div class="container valuation-grid">
        <div data-reveal>
          <p class="eyebrow">Für Eigentümer</p><h2>Was ist Ihre Immobilie heute <em>wert?</em></h2>
          <p>Eine gute Verkaufsentscheidung beginnt mit einer realistischen Einordnung. Starten Sie online mit den wichtigsten Eckdaten – unverbindlich und in wenigen Schritten.</p>
          <a class="button button--dark" href="/leistung/formular/">Online-Bewertung starten →</a>
        </div>
        <div class="valuation-points" data-reveal>
          <span><strong>01</strong> Eckdaten zur Immobilie angeben</span>
          <span><strong>02</strong> Erste Einschätzung erhalten</span>
          <span><strong>03</strong> Ergebnis persönlich vertiefen</span>
        </div>
      </div>
    </section>

    <section class="section section--light" id="objekte">
      <div class="container buyer-grid">
        <div data-reveal><p class="eyebrow">Für Käufer und Mieter</p><h2>Die passende Immobilie beginnt mit Ihrem <em>Suchprofil.</em></h2></div>
        <div data-reveal>
          <p>Nicht jedes Angebot wird öffentlich vermarktet. Teilen Sie uns mit, welche Lage, Größe und Nutzung Sie suchen. Sobald eine passende Immobilie verfügbar ist, kann Ihre Anfrage gezielt berücksichtigt werden.</p>
          <div class="inline-actions"><a class="button button--dark" href="/kontakt/">Suchprofil mitteilen →</a><a class="text-link" href="tel:+4922116892660">0221 / 168 926 60 →</a></div>
        </div>
      </div>
    </section>

    <section class="section section--dark" id="diskretion">
      <div class="container discretion-grid">
        <div data-reveal><p class="eyebrow">Diskrete Vermarktung</p><h2>Nicht jede Immobilie braucht <em>Öffentlichkeit.</em></h2></div>
        <div data-reveal>
          <p>Wenn persönliche Umstände, Privatsphäre oder die besondere Positionierung des Objekts es erfordern, sprechen wir ausgewählte Interessenten direkt an. Informationen werden kontrolliert weitergegeben, Besichtigungen gezielt koordiniert und der gesamte Prozess vertraulich geführt.</p>
          <a class="button" href="/kontakt/">Diskreten Verkauf besprechen →</a>
        </div>
      </div>
    </section>

    <section class="section section--paper">
      <div class="container">
        <SectionHeader eyebrow="Wenn sich etwas verändert" title="Wir schaffen Klarheit – auch in anspruchsvollen <em>Situationen.</em>" />
        <div class="situation-grid">
          {["Geplanter Verkauf", "Erbschaft", "Trennung", "Beruflicher Umzug", "Altersbedingter Wechsel", "Kapitalanlage"].map((item) => <span data-reveal>{item}</span>)}
        </div>
      </div>
    </section>

    <section class="contact-cta" id="kontakt">
      <div class="container contact-cta__grid">
        <div data-reveal><p class="eyebrow">Ihr nächster Schritt</p><h2>Was dürfen wir für Sie <em>einordnen?</em></h2><p>Ein erstes Gespräch ist unverbindlich und bringt schnell Klarheit über die nächsten Schritte.</p></div>
        <div class="contact-cta__links" data-reveal>
          <a href="tel:+4922116892660"><small>Telefon</small><strong>+49 221 168 926 60</strong><span>Direkt anrufen →</span></a>
          <a href="mailto:info@sayan-immo.de"><small>E-Mail</small><strong>info@sayan-immo.de</strong><span>Nachricht schreiben →</span></a>
          <span><small>Adresse</small><strong>Sternengasse 3</strong><span>50676 Köln</span></span>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script is:inline src="https://components.bottimmo.com/components/6a9a8e5ddd651d6512580de2/btm-widget/de-DE" defer></script>
  <script>
    const status = document.querySelector<HTMLElement>("[data-bottimmo-status]");
    const error = document.querySelector<HTMLElement>("[data-bottimmo-error]");
    let ready = false;
    window.customElements.whenDefined("btm-widget").then(() => { ready = true; if (status) status.hidden = true; });
    window.setTimeout(() => { if (!ready) { if (status) status.hidden = true; if (error) error.hidden = false; } }, 12000);
  </script>
</BaseLayout>

<style>
  :global(.site-header .nav-wrap){background:color-mix(in srgb,var(--cream) 96%,transparent);border-color:var(--line-dark);box-shadow:var(--shadow-sm);backdrop-filter:blur(16px)}.home-hero{min-height:100svh;display:grid;align-content:end;padding-top:10rem;overflow:hidden;background:linear-gradient(135deg,var(--cream) 0%,var(--paper) 100%)}.home-hero__grid{display:grid;grid-template-columns:minmax(0,6fr) minmax(24rem,5fr);gap:clamp(2rem,6vw,6rem);align-items:start;padding-block:clamp(3rem,7vw,6rem)}.home-hero__copy{padding-top:clamp(1rem,5vw,5rem)}.home-hero__copy h1{max-width:10ch}.home-hero__lead{max-width:48ch;margin-top:1.6rem;font-size:clamp(1rem,1.5vw,1.2rem)}.home-hero__actions,.inline-actions{display:flex;flex-wrap:wrap;align-items:center;gap:1rem;margin-top:2rem}.button--dark,.home-hero .button{border-color:var(--ink);background:var(--ink);color:var(--cream)}.button--outline{background:transparent!important;color:var(--ink)!important}.hero-valuation{min-height:38rem;padding:clamp(1rem,2vw,1.5rem);overflow:clip;border:1px solid var(--line-dark);border-radius:var(--radius-card);background:var(--paper);box-shadow:var(--shadow-lg)}.hero-valuation__head{padding:.5rem .5rem 1.25rem;border-bottom:1px solid var(--line-dark)}.hero-valuation__head h2{font-size:clamp(1.7rem,2.6vw,2.35rem)}.hero-valuation .eyebrow{margin-bottom:.5rem}.hero-valuation btm-widget{display:block;width:100%}.widget-status,.widget-error{padding:1rem;color:var(--ink-muted);font-size:.75rem;text-align:center}.widget-error a{text-decoration:underline}.proof-line{border-top:1px solid var(--line-dark);background:var(--paper)}.proof-line__inner{display:grid;grid-template-columns:repeat(4,1fr)}.proof-line span{padding:1.2rem 1rem;border-left:1px solid var(--line-dark);font-size:.7rem;font-weight:600;text-align:center}.proof-line span:last-child{border-right:1px solid var(--line-dark)}.owner-grid,.valuation-grid,.buyer-grid,.discretion-grid,.contact-cta__grid{display:grid;grid-template-columns:5fr 7fr;gap:clamp(3rem,8vw,8rem);align-items:center}.owner-mark{min-height:28rem;display:grid;place-content:center;justify-items:center;background:var(--brand-900);color:var(--cream)}.owner-mark span{color:var(--accent);font:600 clamp(6rem,14vw,11rem)/1 var(--font-display);letter-spacing:-.08em}.owner-mark small{margin-top:1rem;font-size:.65rem;letter-spacing:.16em;text-transform:uppercase}.owner-copy p:not(.eyebrow){max-width:60ch;margin-top:1.2rem;color:var(--ink-muted)}.owner-copy .text-link{margin-top:1.8rem}.service-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line-dark)}.service-card{display:grid;align-content:start;min-height:22rem;padding:2rem;border-right:1px solid var(--line-dark)}.service-card:first-child{border-left:1px solid var(--line-dark)}.service-card>span,.process-grid span{color:var(--accent-ink);font-size:.65rem;font-weight:700}.service-card h3{margin:3rem 0 1rem}.service-card p{color:var(--ink-muted)}.service-card .text-link{margin-top:auto;padding-top:2rem}.process-grid{display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid var(--hairline)}.process-grid article{min-height:16rem;padding:1.5rem;border-right:1px solid var(--hairline)}.process-grid article:first-child{border-left:1px solid var(--hairline)}.process-grid h3{margin:3rem 0 1rem}.process-grid p,.discretion-grid p{color:color-mix(in srgb,var(--cream) 68%,transparent)}.valuation-grid>div>p:not(.eyebrow),.buyer-grid p{max-width:58ch;margin-top:1.2rem}.valuation-grid .button{margin-top:2rem}.valuation-points{display:grid}.valuation-points span{display:grid;grid-template-columns:3rem 1fr;gap:1rem;padding:1.4rem 0;border-top:1px solid color-mix(in srgb,var(--ink) 22%,transparent)}.valuation-points strong{font-size:.65rem}.buyer-grid{align-items:start}.discretion-grid{align-items:end}.discretion-grid .button{margin-top:2rem}.situation-grid{display:grid;grid-template-columns:repeat(3,1fr)}.situation-grid span{padding:1.6rem;border:1px solid var(--line-dark);margin:-1px 0 0 -1px;font:500 1.2rem/1.2 var(--font-display)}.contact-cta{padding-block:var(--section-space);background:var(--accent)}.contact-cta__grid{align-items:start}.contact-cta__grid>div>p:not(.eyebrow){max-width:50ch;margin-top:1.2rem}.contact-cta__links{display:grid}.contact-cta__links>a,.contact-cta__links>span{display:grid;grid-template-columns:6rem 1fr auto;gap:1rem;align-items:center;padding:1.2rem 0;border-top:1px solid color-mix(in srgb,var(--ink) 24%,transparent)}.contact-cta__links small,.contact-cta__links span span{font-size:.65rem}.contact-cta__links>a>span{font-size:.7rem;font-weight:600}
  @media(max-width:900px){.proof-line__inner,.process-grid{grid-template-columns:1fr 1fr}.service-grid{grid-template-columns:1fr}.service-card{min-height:auto;border-left:1px solid var(--line-dark);border-bottom:1px solid var(--line-dark)}.situation-grid{grid-template-columns:1fr 1fr}}
  @media(max-width:767px){.home-hero__grid,.owner-grid,.valuation-grid,.buyer-grid,.discretion-grid,.contact-cta__grid{grid-template-columns:1fr}.home-hero__grid{padding-top:2rem}.home-hero{min-height:auto}.hero-valuation{min-height:42rem}.owner-mark{min-height:18rem}.proof-line__inner,.process-grid,.situation-grid{grid-template-columns:1fr}.proof-line span{border-right:1px solid var(--line-dark);border-bottom:1px solid var(--line-dark)}.contact-cta__links>a,.contact-cta__links>span{grid-template-columns:1fr}.contact-cta__links>a>span{display:none}}
</style>
