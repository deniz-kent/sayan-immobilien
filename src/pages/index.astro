---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionHeader from "../components/SectionHeader.astro";
import PropertyCard from "../components/PropertyCard.astro";
import { properties } from "../data/properties";

const featuredProperties = properties.slice(0, 3);

const services = [
  {
    number: "01",
    title: "Verkaufen",
    copy: "Von der fundierten Einordnung über die Präsentation bis zum Notartermin: Sie behalten jederzeit den Überblick.",
    href: "/leistung/",
    link: "Verkauf vorbereiten",
    image: "/images/haus-modern-klinker.webp",
  },
  {
    number: "02",
    title: "Vermieten",
    copy: "Wir positionieren Ihre Immobilie passend, prüfen Interessenten sorgfältig und begleiten Sie bis zur Übergabe.",
    href: "/leistung/#vermietung",
    link: "Vermietung besprechen",
    image: "/images/fassade-balkone-klinker.webp",
  },
  {
    number: "03",
    title: "Kaufen & mieten",
    copy: "Sagen Sie uns, was Sie suchen. Wir gleichen Ihr Profil mit passenden öffentlichen und diskreten Angeboten ab.",
    href: "/kontakt/",
    link: "Suchprofil mitteilen",
    image: "/images/wohnzimmer-modern-domblick.webp",
  },
];

const process = [
  ["01", "Verstehen", "Wir klären Ihre Situation, Ihre Ziele und den gewünschten Zeitrahmen."],
  ["02", "Einordnen", "Wir betrachten Lage, Zustand, Unterlagen und die aktuelle Nachfrage."],
  ["03", "Vermarkten", "Wir wählen den passenden Weg: öffentlich, vorgemerkt oder diskret."],
  ["04", "Abschließen", "Wir begleiten Verhandlung, Notartermin und geordnete Übergabe."],
];
---

<BaseLayout
  title="SAYAN Immobilien Köln | Persönlich seit 2001"
  description="Persönliche Immobilienvermittlung in Köln: Verkauf, Vermietung und Immobiliensuche mit Candan Sayan als direktem Ansprechpartner."
>
  <Header />
  <main id="main">
    <section class="home-hero">
      <div class="container home-hero__grid">
        <div class="home-hero__copy" data-reveal>
          <p class="eyebrow">Immobilienvermittlung · Köln</p>
          <h1>Ihre Immobilie verdient eine klare <em>Entscheidung.</em></h1>
          <p class="home-hero__lead">
            Ob Verkauf, Vermietung oder Suche: Candan Sayan begleitet Sie persönlich, verbindlich und mit
            Erfahrung seit 2001.
          </p>
          <div class="home-hero__actions">
            <a class="button" href="#online-bewertung">Bewertung starten</a>
            <a class="button button--outline" href="/kontakt/">Persönlich sprechen</a>
          </div>
        </div>

        <aside class="hero-valuation" id="online-bewertung" data-reveal aria-label="Online Immobilienbewertung">
          <div class="hero-valuation__head">
            <p class="eyebrow">Kostenlose Ersteinschätzung</p>
            <h2>Was ist Ihre Immobilie wert?</h2>
          </div>
          <p class="widget-status" data-bottimmo-status>Bewertung wird geladen …</p>
          <btm-widget widget="valuation"></btm-widget>
          <p class="widget-error" data-bottimmo-error hidden>Die Bewertung konnte gerade nicht geladen werden. Rufen Sie uns gern unter <a href="tel:+4922116892660">0221 / 168 926 60</a> an.</p>
        </aside>
      </div>
      <div class="proof-line">
        <div class="proof-line__track">
          <div class="proof-line__group">
            <span>Persönlicher Ansprechpartner</span>
            <span>Fundierte Wertermittlung</span>
            <span>Öffentliche oder diskrete Vermarktung</span>
            <span>Köln & Region</span>
            <span>Seit 2001 am Markt</span>
            <span>Inhabergeführt</span>
            <span>Verkauf, Vermietung & Suche</span>
            <span>Verbindliche Beratung</span>
          </div>
          <div class="proof-line__group" aria-hidden="true">
            <span>Persönlicher Ansprechpartner</span>
            <span>Fundierte Wertermittlung</span>
            <span>Öffentliche oder diskrete Vermarktung</span>
            <span>Köln & Region</span>
            <span>Seit 2001 am Markt</span>
            <span>Inhabergeführt</span>
            <span>Verkauf, Vermietung & Suche</span>
            <span>Verbindliche Beratung</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--paper" id="wohntraumfinder">
      <div class="container">
        <div class="widget-card">
          <div class="widget-card__head">
            <p class="eyebrow">Für Käufer und Mieter</p>
            <h2>Finden Sie Ihre <em>Wunschimmobilie.</em></h2>
          </div>
          <btm-widget widget="property-request"></btm-widget>
        </div>
      </div>
    </section>

    <section class="section section--paper" id="objekte-vorschau">
      <div class="container">
        <SectionHeader eyebrow="Aktuelle Objekte" title="Ausgewählte <em>Angebote.</em>" />
        <div class="property-grid" data-reveal-group>
          {featuredProperties.map((property, index) => (
            <div data-reveal style={`--stagger:${index}`}>
              <PropertyCard property={property} label={String(index + 1).padStart(2, "0")} />
            </div>
          ))}
        </div>
        <div class="property-preview__cta">
          <a class="button" href="/immobilien/">Alle ansehen</a>
        </div>
      </div>
    </section>

    <section class="section section--light" id="unternehmen">
      <div class="container owner-grid">
        <div class="owner-mark" aria-hidden="true" data-reveal>
          <img src="/images/altbau-wohnzimmer-fischgraet.webp" alt="" loading="lazy" />
        </div>
        <div class="owner-copy" data-reveal>
          <p class="eyebrow">Candan Sayan · Inhaber</p>
          <h2>Eine Entscheidung. Ein fester <em>Ansprechpartner.</em></h2>
          <p>Eine Immobilie zu verkaufen oder zu vermieten ist selten nur eine sachliche Entscheidung. Es geht um Vermögen, Veränderungen und oft auch um persönliche Geschichte. Deshalb führt Candan Sayan Ihr Anliegen selbst, vom ersten Gespräch bis zur Übergabe.</p>
          <p>Seit 1998 in der Immobilienbranche und seit 2001 mit SAYAN Immobilien in Köln verbindet er lokale Marktkenntnis mit einer ruhigen, nachvollziehbaren Beratung.</p>
          <a class="text-link" href="/kontakt/">Candan Sayan kennenlernen →</a>
        </div>
      </div>
    </section>

    <section class="section section--paper" id="leistungen">
      <div class="container">
        <SectionHeader eyebrow="Was wir für Sie tun" title="Immobilienentscheidungen brauchen <em>Orientierung.</em>" lead="Sie erhalten keinen Standardablauf, sondern einen Weg, der zu Ihrer Immobilie, Ihrem Ziel und Ihrer Situation passt." />
        <div class="service-grid" data-reveal-group>
          {services.map((service, i) => (
            <article class="service-card" data-reveal style={`--stagger:${i}`}>
              <div class="service-card__media"><img src={service.image} alt="" loading="lazy" /><span>{service.number}</span></div>
              <h3>{service.title}.</h3><p>{service.copy}</p>
              <a class="text-link" href={service.href}>{service.link} →</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--dark-alt" id="ablauf">
      <div class="container">
        <SectionHeader eyebrow="Der SAYAN Weg" title="Von der ersten Frage bis zur sicheren <em>Übergabe.</em>" lead="Sie wissen jederzeit, wo Ihr Vorhaben steht, was als Nächstes passiert und welche Entscheidung ansteht." />
        <div class="process-grid" data-reveal-group>
          {process.map(([number, title, copy], i) => (
            <article data-reveal style={`--stagger:${i}`}><span>{number}</span><h3>{title}.</h3><p>{copy}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--brand">
      <div class="container valuation-grid">
        <div data-reveal>
          <p class="eyebrow">Für Eigentümer</p><h2>Was ist Ihre Immobilie heute <em>wert?</em></h2>
          <p>Eine gute Verkaufsentscheidung beginnt mit einer realistischen Einordnung. Starten Sie online mit den wichtigsten Eckdaten, unverbindlich und in wenigen Schritten.</p>
          <a class="button button--dark" href="/leistung/formular/">Online Bewertung starten</a>
        </div>
        <div class="valuation-points" data-reveal>
          <span><strong>01</strong> Eckdaten zur Immobilie angeben</span>
          <span><strong>02</strong> Erste Einschätzung erhalten</span>
          <span><strong>03</strong> Ergebnis persönlich vertiefen</span>
        </div>
      </div>
    </section>

    <section class="section section--light" id="objekte">
      <div class="container buyer-grid">
        <div class="section-photo" data-reveal aria-hidden="true"><img src="/images/strasse-altbau-koeln.webp" alt="" loading="lazy" /></div>
        <div data-reveal>
          <p class="eyebrow">Für Käufer und Mieter</p>
          <h2>Die passende Immobilie beginnt mit Ihrem <em>Suchprofil.</em></h2>
          <p>Nicht jedes Angebot wird öffentlich vermarktet. Teilen Sie uns mit, welche Lage, Größe und Nutzung Sie suchen. Sobald eine passende Immobilie verfügbar ist, kann Ihre Anfrage gezielt berücksichtigt werden.</p>
          <div class="inline-actions"><a class="button button--dark" href="/kontakt/">Suchprofil mitteilen</a><a class="text-link" href="tel:+4922116892660">0221 / 168 926 60 →</a></div>
        </div>
      </div>
    </section>

    <section class="section section--dark" id="diskretion">
      <div class="container discretion-grid">
        <div class="section-photo" data-reveal aria-hidden="true"><img src="/images/altbau-zimmer-leer.webp" alt="" loading="lazy" /></div>
        <div data-reveal>
          <p class="eyebrow">Diskrete Vermarktung</p>
          <h2>Nicht jede Immobilie braucht <em>Öffentlichkeit.</em></h2>
          <p>Wenn persönliche Umstände, Privatsphäre oder die besondere Positionierung des Objekts es erfordern, sprechen wir ausgewählte Interessenten direkt an. Informationen werden kontrolliert weitergegeben, Besichtigungen gezielt koordiniert und der gesamte Prozess vertraulich geführt.</p>
          <a class="button" href="/kontakt/">Diskreten Verkauf besprechen</a>
        </div>
      </div>
    </section>

    <section class="section section--paper">
      <div class="container">
        <SectionHeader eyebrow="Wenn sich etwas verändert" title="Wir schaffen Klarheit, auch in anspruchsvollen <em>Situationen.</em>" />
        <div class="situation-grid">
          {["Geplanter Verkauf", "Erbschaft", "Trennung", "Beruflicher Umzug", "Altersbedingter Wechsel", "Kapitalanlage"].map((item) => <span data-reveal>{item}</span>)}
        </div>
      </div>
    </section>

    <section class="contact-cta" id="kontakt">
      <div class="container contact-cta__grid">
        <div data-reveal><p class="eyebrow">Ihr nächster Schritt</p><h2>Was dürfen wir für Sie <em>einordnen?</em></h2><p>Ein erstes Gespräch ist unverbindlich und bringt schnell Klarheit über die nächsten Schritte.</p></div>
        <div class="contact-cta__links" data-reveal>
          <a href="tel:+4922116892660"><small>Telefon</small><strong>+49 221 168 926 60</strong><span>Direkt anrufen →</span></a>
          <a href="mailto:info@sayan-immo.de"><small>Email</small><strong>info@sayan-immo.de</strong><span>Nachricht schreiben →</span></a>
          <span><small>Adresse</small><strong>Sternengasse 3</strong><span>50676 Köln</span></span>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script is:inline src="https://components.bottimmo.com/components/6a9a8e5ddd651d6512580de2/btm-widget/de-DE" defer></script>
  <script>
    const status = document.querySelector<HTMLElement>("[data-bottimmo-status]");
    const error = document.querySelector<HTMLElement>("[data-bottimmo-error]");
    let ready = false;
    window.customElements.whenDefined("btm-widget").then(() => { ready = true; if (status) status.hidden = true; });
    window.setTimeout(() => { if (!ready) { if (status) status.hidden = true; if (error) error.hidden = false; } }, 12000);
  </script>
</BaseLayout>

<style>
  :global(.site-header .nav-wrap) { background: color-mix(in srgb, #fff 90%, transparent); border-color: var(--n-border); backdrop-filter: blur(12px); }

  .home-hero { min-height: 100svh; display: grid; align-content: end; padding-top: 6rem; overflow: hidden; background: var(--n-surface); }
  .home-hero__grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(24rem, 5fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; padding-block: clamp(3rem, 7vw, 6rem); }
  .home-hero__copy { padding-top: clamp(1rem, 5vw, 5rem); }
  .home-hero__copy h1 { max-width: none; }
  .home-hero__lead { max-width: 48ch; margin-top: 1.6rem; font-size: clamp(1.1rem, 1.5vw, 1.25rem); color: var(--n-text-secondary); }
  .home-hero__actions, .inline-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 2.5rem; }

  .hero-valuation { min-height: 38rem; padding: clamp(1.25rem, 2vw, 2rem); overflow: clip; border: 1px solid var(--n-border); border-radius: var(--radius-media); background: #fff; }
  .hero-valuation__head { padding: .5rem .5rem 1.5rem; }
  .hero-valuation__head h2 { max-width: none; font-size: clamp(1.6rem, 2.4vw, 2.1rem); }
  .hero-valuation .eyebrow { margin-bottom: .75rem; padding: .4rem 1rem; font-size: .8rem; }
  .hero-valuation btm-widget { display: block; width: 100%; }
  .widget-status, .widget-error { padding: 1rem; color: var(--n-text-secondary); font-size: .85rem; text-align: center; }
  .widget-error a { text-decoration: underline; }

  .proof-line { overflow: hidden; border-top: 1px solid var(--n-border); border-bottom: 1px solid var(--n-border); background: #fff; }
  .proof-line__track { display: flex; width: max-content; animation: proof-scroll 36s linear infinite; }
  .proof-line:hover .proof-line__track { animation-play-state: paused; }
  .proof-line__group { display: flex; flex-shrink: 0; }
  .proof-line span { display: flex; align-items: center; justify-content: center; width: 19rem; padding: 1.2rem 1rem; border-left: 1px solid var(--n-border); font-size: .85rem; font-weight: 500; color: var(--n-text-secondary); text-align: center; white-space: nowrap; }
  @keyframes proof-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  .owner-grid, .valuation-grid, .buyer-grid, .discretion-grid, .contact-cta__grid { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(3rem, 8vw, 8rem); align-items: center; }
  .section-photo { position: relative; min-height: 22rem; border-radius: var(--radius-media); overflow: hidden; background: var(--n-surface); }
  .section-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  /* Signature-Detail: ausgesparte Ecke. Kein Trust-Content vorhanden -> bleibt leer. */
  .corner-notch { position: relative; }
  .corner-notch::after { content: ""; position: absolute; right: 0; bottom: 0; width: 3.5rem; height: 3.5rem; background: radial-gradient(circle at 100% 100%, transparent 2rem, var(--n-surface) 2rem); }

  .owner-mark { position: relative; min-height: 28rem; border-radius: var(--radius-media); overflow: hidden; background: var(--brand-900); }
  .owner-mark img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .owner-copy p:not(.eyebrow) { max-width: 60ch; margin-top: 1.2rem; color: var(--n-text-secondary); }
  .owner-copy .text-link { margin-top: 1.8rem; }

  .service-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.75rem; }
  .service-card { display: grid; align-content: start; padding: 2rem; border-radius: var(--radius-card); background: var(--n-surface); border: 1px solid transparent; transition: background var(--motion-hover) ease, border-color var(--motion-hover) ease; }
  .service-card:hover { background: #fff; border-color: var(--n-border); }
  .service-card__media { position: relative; aspect-ratio: 4 / 3; margin-bottom: 2rem; border-radius: var(--radius-field); overflow: hidden; }
  .service-card__media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 700ms var(--ease-out-expo); }
  .service-card:hover .service-card__media img { transform: scale(1.04); }
  .service-card__media span { position: absolute; left: 1rem; bottom: 1rem; display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: var(--radius-pill); background: #fff; color: var(--n-text); font-size: 1rem; font-weight: 600; }
  .service-card h3 { margin: 0 0 1rem; text-transform: none; }
  .service-card p { color: var(--n-text-secondary); }
  .service-card .text-link { margin-top: 1.25rem; padding-top: 0; }

  .process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.75rem; }
  .process-grid article { padding: 2.5rem 0; border-top: 1px solid color-mix(in srgb, #fff 18%, transparent); }
  .process-grid span { color: var(--accent); font-size: .95rem; font-weight: 600; }
  .process-grid h3 { margin: 2.5rem 0 .85rem; text-transform: none; color: #fff; }
  .process-grid p, .discretion-grid p { color: color-mix(in srgb, #fff 70%, transparent); }

  .valuation-grid > div > p:not(.eyebrow), .buyer-grid p { max-width: 58ch; margin-top: 1.2rem; color: var(--n-text-secondary); }
  .valuation-grid .button { margin-top: 2rem; }
  .valuation-points { display: grid; }
  .valuation-points span { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: 1.4rem 0; border-top: 1px solid var(--n-border); }
  .valuation-points strong { font-weight: 400; font-size: 1.5rem; color: var(--n-text); }
  .discretion-grid .button { margin-top: 2rem; }

  .situation-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.75rem; }
  .situation-grid span { display: flex; align-items: center; padding: 1.75rem; border-radius: var(--radius-card); background: var(--n-surface); font: 500 1.15rem/1.2 var(--font-display); }

  .property-preview__cta { display: flex; justify-content: center; margin-top: clamp(2.5rem, 5vw, 3.5rem); }
  .contact-cta { padding-block: var(--section-space); background: var(--n-surface); }
  .contact-cta__grid > div > p:not(.eyebrow) { max-width: 50ch; margin-top: 1.2rem; color: var(--n-text-secondary); }
  .contact-cta__links { display: grid; }
  .contact-cta__links > a, .contact-cta__links > span { display: grid; grid-template-columns: 6rem 1fr auto; gap: 1rem; align-items: center; padding: 1.4rem 0; border-top: 1px solid var(--n-border); }
  .contact-cta__links small, .contact-cta__links span span { font-size: .8rem; color: var(--n-text-secondary); }
  .contact-cta__links > a > span { font-size: .85rem; font-weight: 600; }

  @media (max-width: 900px) {
    .process-grid { grid-template-columns: 1fr 1fr; }
    .service-grid { grid-template-columns: 1fr; }
    .situation-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 767px) {
    .home-hero__grid, .owner-grid, .valuation-grid, .buyer-grid, .discretion-grid, .contact-cta__grid { grid-template-columns: 1fr; }
    .home-hero__grid { padding-top: 1rem; }
    .home-hero { min-height: auto; padding-top: 2.5rem; }
    .hero-valuation { min-height: 42rem; }
    .owner-mark { min-height: 18rem; }
    .process-grid, .situation-grid { grid-template-columns: 1fr; }
    .proof-line span { width: 13.5rem; }
    .contact-cta__links > a, .contact-cta__links > span { grid-template-columns: 1fr; }
    .contact-cta__links > a > span { display: none; }
  }
</style>
