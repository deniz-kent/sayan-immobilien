---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionHeader from "../components/SectionHeader.astro";
import PropertyCard from "../components/PropertyCard.astro";
import { properties } from "../data/properties";

const featuredProperties = properties.slice(0, 3);

const services = [
  {
    number: "01",
    title: "Verkaufen",
    copy: "Wir bewerten Ihre Immobilie, bereiten Exposé und Vermarktung vor, prüfen Interessenten und begleiten Sie bis zum Notartermin und zur Übergabe.",
    href: "/leistung/",
    link: "Verkauf vorbereiten",
    image: "/images/haus-modern-klinker.webp",
  },
  {
    number: "02",
    title: "Vermieten",
    copy: "Von den Fotos über Besichtigungen und Bonitätsprüfung bis zum Mietvertrag und zur Wohnungsübergabe kümmern wir uns um die Vermietung.",
    href: "/leistung/#vermietung",
    link: "Vermietung besprechen",
    image: "/images/fassade-balkone-klinker.webp",
  },
];

const process = [
  ["01", "Besichtigen", "Wir sehen uns Ihre Immobilie an und besprechen, was Sie vorhaben."],
  ["02", "Bewerten", "Wir prüfen Unterlagen, Lage und Markt und legen den Angebotspreis mit Ihnen fest."],
  ["03", "Vermarkten", "Wir erstellen Fotos und Exposé, wählen die passenden Kanäle und organisieren Besichtigungen."],
  ["04", "Abwickeln", "Wir prüfen Interessenten, führen Verhandlungen und begleiten Vertrag und Übergabe."],
];
---

<BaseLayout
  title="SAYAN Immobilien Köln | Persönlich seit 2001"
  description="SAYAN Immobilien Köln: persönliche Betreuung durch unser Team bei Verkauf, Vermietung und Immobilienbewertung."
>
  <Header />
  <main id="main">
    <section class="home-hero">
      <div class="container">
        <div class="home-hero__media">
          <img src="/images/haus-modern-klinker.webp" alt="" fetchpriority="high" />
          <div class="home-hero__shade" aria-hidden="true"></div>
          <div class="home-hero__copy" data-reveal>
            <p class="eyebrow">Immobilienvermittlung · Köln</p>
            <h1>Engagiert für Sie und Ihre <em>Immobilie.</em></h1>
            <p class="home-hero__lead">
              Sie möchten verkaufen oder vermieten? SAYAN Immobilien kümmert sich um Bewertung,
              Vermarktung und Vermittlung. Persönlich, mit einem Team vor Ort in Köln.
            </p>
            <div class="home-hero__actions">
              <a class="button button--light" href="#online-bewertung">Bewertung starten</a>
              <a class="button button--glass" href="/kontakt/">Persönlich sprechen</a>
            </div>
          </div>
        </div>
      </div>
      <div class="proof-line">
        <div class="proof-line__track">
          <div class="proof-line__group">
            <span>Persönlicher Ansprechpartner</span>
            <span>Fundierte Wertermittlung</span>
            <span>Öffentliche oder diskrete Vermarktung</span>
            <span>Köln & Region</span>
            <span>Seit 2001 am Markt</span>
            <span>Inhabergeführt</span>
            <span>Verkauf & Vermietung</span>
            <span>Verbindliche Beratung</span>
          </div>
          <div class="proof-line__group" aria-hidden="true">
            <span>Persönlicher Ansprechpartner</span>
            <span>Fundierte Wertermittlung</span>
            <span>Öffentliche oder diskrete Vermarktung</span>
            <span>Köln & Region</span>
            <span>Seit 2001 am Markt</span>
            <span>Inhabergeführt</span>
            <span>Verkauf & Vermietung</span>
            <span>Verbindliche Beratung</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--paper valuation-section" id="online-bewertung">
      <div class="container valuation-section__grid">
        <div class="valuation-section__copy" data-reveal>
          <p class="eyebrow">Kostenlose Ersteinschätzung</p>
          <h2>Was ist Ihre Immobilie wert?</h2>
          <p>Ein zu hoch angesetzter Preis kann den Verkauf unnötig verzögern. Geben Sie hier die Eckdaten ein. Für eine fundierte Einschätzung sehen wir uns Ihre Immobilie und den Markt persönlich an.</p>
        </div>
        <aside class="hero-valuation" data-reveal aria-label="Online Immobilienbewertung">
          <p class="widget-status" data-bottimmo-status>Bewertung wird geladen …</p>
          <btm-widget widget="valuation"></btm-widget>
          <p class="widget-error" data-bottimmo-error hidden>Die Bewertung konnte gerade nicht geladen werden. Rufen Sie uns gern unter <a href="tel:+4922116892660">0221 / 168 926 60</a> an.</p>
        </aside>
      </div>
    </section>

    <section class="section section--paper" id="objekte-vorschau">
      <div class="container">
        <SectionHeader eyebrow="Immobilien" title="Ein Blick auf unsere <em>Angebote.</em>" lead="Die Objekte auf dieser Testseite sind noch Beispiele. Aktuelle Angebote erscheinen hier nach der Anbindung an onOffice." />
        <div class="property-grid" data-reveal-group>
          {featuredProperties.map((property, index) => (
            <div data-reveal style={`--stagger:${index}`}>
              <PropertyCard property={property} label={String(index + 1).padStart(2, "0")} />
            </div>
          ))}
        </div>
        <div class="property-preview__cta">
          <a class="button" href="/immobilien/">Alle ansehen</a>
        </div>
      </div>
    </section>

    <section class="section section--brand" id="unternehmen">
      <div class="container owner-grid">
        <div class="owner-mark" aria-hidden="true" data-reveal>
          <img src="/images/buero-candan-sayan-koeln.jpg" alt="" loading="lazy" />
        </div>
        <div class="owner-copy" data-reveal>
          <p class="eyebrow">SAYAN Immobilien Köln</p>
          <h2>Inhabergeführt. Vor Ort in <em>Köln.</em></h2>
          <p>Seit 2001 vermitteln wir Wohn- und Gewerbeimmobilien, beraten Eigentümer und kümmern uns auch nach dem Vertragsabschluss um offene Fragen. Sie werden von unserem Team persönlich betreut.</p>
          <p>Unser Büro gehört weder zu einer Bank noch zu einem Franchise. Wir besprechen mit Ihnen, wie Ihre Immobilie angeboten wird und welche Schritte sinnvoll sind.</p>
          <a class="text-link" href="/kontakt/">Nehmen Sie Kontakt mit uns auf →</a>
        </div>
      </div>
    </section>

    <section class="section section--paper" id="leistungen">
      <div class="container">
        <SectionHeader eyebrow="Für Eigentümer" title="Verkauf und Vermietung aus <em>einer Hand.</em>" lead="Von der Preisfindung über Fotos, Exposé und Besichtigungen bis zum Vertrag übernehmen wir die Arbeit, die eine Vermittlung mit sich bringt." />
        <div class="service-grid" data-reveal-group>
          {services.map((service, i) => (
            <article class="service-card" data-reveal style={`--stagger:${i}`}>
              <div class="service-card__media"><img src={service.image} alt="" loading="lazy" /><span>{service.number}</span></div>
              <h3>{service.title}.</h3><p>{service.copy}</p>
              <a class="text-link" href={service.href}>{service.link} →</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--dark-alt" id="ablauf">
      <div class="container">
        <SectionHeader eyebrow="So arbeiten wir" title="Vom ersten Termin bis zur <em>Übergabe.</em>" lead="Wir stimmen den Vermarktungsplan mit Ihnen ab und halten Sie über Anfragen und Besichtigungen auf dem Laufenden." />
        <div class="process-grid" data-reveal-group>
          {process.map(([number, title, copy], i) => (
            <article data-reveal style={`--stagger:${i}`}><span>{number}</span><h3>{title}.</h3><p>{copy}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--dark" id="diskretion">
      <div class="container discretion-grid">
        <div class="section-photo" data-reveal aria-hidden="true"><img src="/images/altbau-zimmer-leer.webp" alt="" loading="lazy" /></div>
        <div data-reveal>
          <p class="eyebrow">Diskrete Vermarktung</p>
          <h2>Nicht jede Immobilie braucht <em>Öffentlichkeit.</em></h2>
          <p>Sie möchten Ihre Verkaufsabsicht nicht öffentlich machen? Dann bieten wir Ihre Immobilie ausgewählten Interessenten aus unserer Kartei an, ohne Anzeigen und öffentliche Bilder. Welche Informationen wir weitergeben, stimmen wir mit Ihnen ab.</p>
          <a class="button" href="/kontakt/">Diskreten Verkauf besprechen</a>
        </div>
      </div>
    </section>

    <section class="section section--paper">
      <div class="container">
        <SectionHeader eyebrow="Ihre Immobilie" title="Auch für besondere <em>Aufgaben.</em>" />
        <div class="situation-grid">
          {["Wohnimmobilien", "Gewerbeimmobilien", "Grundstücke", "Kapitalanlagen", "Bauträgerprojekte", "Immobilienportfolios"].map((item) => <span data-reveal>{item}</span>)}
        </div>
      </div>
    </section>

    <section class="contact-cta section--brand" id="kontakt">
      <div class="container contact-cta__grid">
        <div data-reveal><p class="eyebrow">Sprechen Sie mit uns</p><h2>Was haben Sie mit Ihrer Immobilie <em>vor?</em></h2><p>Rufen Sie uns an oder schreiben Sie uns. Wir freuen uns auf Sie und Ihre Immobilie.</p></div>
        <div class="contact-cta__links" data-reveal>
          <a href="tel:+4922116892660"><small>Telefon</small><strong>+49 221 168 926 60</strong><span>Direkt anrufen →</span></a>
          <a href="mailto:info@sayan-immo.de"><small>Email</small><strong>info@sayan-immo.de</strong><span>Nachricht schreiben →</span></a>
          <span><small>Adresse</small><strong>Sternengasse 3</strong><span>50676 Köln</span></span>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script is:inline src="https://components.bottimmo.com/components/6a9a8e5ddd651d6512580de2/btm-widget/de-DE" defer></script>
  <script>
    const status = document.querySelector<HTMLElement>("[data-bottimmo-status]");
    const error = document.querySelector<HTMLElement>("[data-bottimmo-error]");
    let ready = false;
    window.customElements.whenDefined("btm-widget").then(() => { ready = true; if (status) status.hidden = true; });
    window.setTimeout(() => { if (!ready) { if (status) status.hidden = true; if (error) error.hidden = false; } }, 12000);
  </script>
</BaseLayout>

<style>
  :global(.site-header .nav-wrap) { background: color-mix(in srgb, #fff 90%, transparent); border-color: var(--n-border); backdrop-filter: blur(12px); }

  .home-hero { padding-top: 6.75rem; overflow: hidden; background: #fff; }
  .home-hero__media { position: relative; min-height: min(44rem, calc(100svh - 9rem)); display: flex; align-items: flex-end; overflow: hidden; border-radius: var(--radius-media); background: var(--brand-900); }
  .home-hero__media > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .home-hero__shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgb(20 24 25 / .82) 0%, rgb(20 24 25 / .58) 42%, rgb(20 24 25 / .08) 78%); }
  .home-hero__copy { position: relative; z-index: 1; width: min(100%, 42rem); padding: clamp(2rem, 5vw, 4.5rem); color: #fff; }
  .home-hero__copy .eyebrow { border-color: rgb(255 255 255 / .3); background: rgb(255 255 255 / .12); color: #fff; backdrop-filter: blur(8px); }
  .home-hero__copy h1 { max-width: 14ch; }
  .home-hero__copy em { color: var(--accent); }
  .home-hero__lead { max-width: 47ch; margin-top: 1.25rem; font-size: clamp(.98rem, 1.2vw, 1.08rem); color: rgb(255 255 255 / .82); }
  .home-hero__actions, .inline-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; margin-top: 2rem; }
  .button--light { border-color: var(--accent); background: var(--accent); color: var(--n-text); }
  .button--glass { border-color: rgb(255 255 255 / .45); background: rgb(255 255 255 / .08); color: #fff; backdrop-filter: blur(8px); }

  .valuation-section { padding-top: clamp(3.5rem, 6vw, 5.5rem); }
  .valuation-section__grid { display: grid; grid-template-columns: minmax(15rem, 4fr) minmax(0, 7fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  .valuation-section__copy { position: sticky; top: 7rem; padding-top: .75rem; }
  .valuation-section__copy p:not(.eyebrow) { max-width: 40ch; margin-top: 1rem; color: var(--n-text-secondary); }
  .hero-valuation { padding: clamp(1rem, 2vw, 1.5rem); overflow: clip; border: 1px solid var(--n-border); border-radius: var(--radius-card); background: #fff; }
  .hero-valuation btm-widget { display: block; width: 100%; }
  @supports (zoom: .88) { .hero-valuation btm-widget { width: 113.64%; zoom: .88; } }
  .widget-status, .widget-error { padding: 1rem; color: var(--n-text-secondary); font-size: .85rem; text-align: center; }
  .widget-error a { text-decoration: underline; }

  .proof-line { margin-top: 1.25rem; overflow: hidden; border-top: 1px solid var(--accent); border-bottom: 1px solid var(--accent); background: var(--accent); }
  .proof-line__track { display: flex; width: max-content; animation: proof-scroll 36s linear infinite; }
  .proof-line:hover .proof-line__track { animation-play-state: paused; }
  .proof-line__group { display: flex; flex-shrink: 0; }
  .proof-line span { display: flex; align-items: center; justify-content: center; width: 16rem; padding: .9rem 1rem; border-left: 1px solid color-mix(in srgb, #fff 35%, transparent); font-size: .75rem; font-weight: 600; color: #fff; text-align: center; white-space: nowrap; }
  @keyframes proof-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  .owner-grid, .valuation-grid, .buyer-grid, .discretion-grid, .contact-cta__grid { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(2.5rem, 6vw, 5rem); align-items: center; }
  .owner-grid { grid-template-columns: 7fr 5fr; }
  .section-photo { position: relative; min-height: 22rem; border-radius: var(--radius-media); overflow: hidden; background: var(--n-surface); }
  .section-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  /* Signature-Detail: ausgesparte Ecke. Kein Trust-Content vorhanden -> bleibt leer. */
  .corner-notch { position: relative; }
  .corner-notch::after { content: ""; position: absolute; right: 0; bottom: 0; width: 3.5rem; height: 3.5rem; background: radial-gradient(circle at 100% 100%, transparent 2rem, var(--n-surface) 2rem); }

  .owner-mark { position: relative; aspect-ratio: 16 / 10; border-radius: var(--radius-media); overflow: hidden; background: var(--brand-900); }
  .owner-mark img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .owner-copy p:not(.eyebrow) { max-width: 60ch; margin-top: 1.2rem; color: var(--n-text-secondary); }
  .owner-copy .text-link { margin-top: 1.8rem; }

  .service-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  .service-card { display: grid; align-content: start; padding: 1.25rem; border-radius: var(--radius-card); background: var(--n-surface); border: 1px solid transparent; transition: background var(--motion-hover) ease, border-color var(--motion-hover) ease; }
  .service-card:hover { background: #fff; border-color: var(--n-border); }
  .service-card__media { position: relative; aspect-ratio: 4 / 3; margin-bottom: 1.25rem; border-radius: var(--radius-field); overflow: hidden; }
  .service-card__media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 700ms var(--ease-out-expo); }
  .service-card:hover .service-card__media img { transform: scale(1.04); }
  .service-card__media span { position: absolute; left: 1rem; bottom: 1rem; display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: var(--radius-pill); background: var(--accent); color: var(--accent-ink); font-size: 1rem; font-weight: 600; }
  .service-card h3 { margin: 0 0 .65rem; text-transform: none; }
  .service-card p { color: var(--n-text-secondary); }
  .service-card .text-link { margin-top: 1rem; padding-top: 0; }

  .process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
  .process-grid article { padding: 1.75rem 0; border-top: 1px solid color-mix(in srgb, #fff 18%, transparent); }
  .process-grid span { color: var(--accent); font-size: .95rem; font-weight: 600; }
  .process-grid h3 { margin: 1.75rem 0 .65rem; text-transform: none; color: #fff; }
  .process-grid p, .discretion-grid p { color: color-mix(in srgb, #fff 70%, transparent); }

  .valuation-grid > div > p:not(.eyebrow), .buyer-grid p { max-width: 58ch; margin-top: 1.2rem; color: var(--n-text-secondary); }
  .valuation-grid .button { margin-top: 2rem; }
  .valuation-points { display: grid; }
  .valuation-points span { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: 1.4rem 0; border-top: 1px solid color-mix(in srgb, var(--accent-ink) 24%, transparent); }
  .valuation-points strong { font-weight: 400; font-size: 1.5rem; color: var(--n-text); }
  .discretion-grid .button { margin-top: 2rem; }

  .situation-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .situation-grid span { display: flex; align-items: center; min-height: 4.5rem; padding: 1.25rem; border: 1px solid var(--n-border); border-radius: var(--radius-card); background: #fff; font: 500 1rem/1.25 var(--font-display); }

  .property-preview__cta { display: flex; justify-content: center; margin-top: clamp(2.5rem, 5vw, 3.5rem); }
  .contact-cta { padding-block: var(--section-space); }
  .contact-cta__grid > div > p:not(.eyebrow) { max-width: 50ch; margin-top: 1.2rem; color: var(--accent-ink); }
  .contact-cta__links { display: grid; }
  .contact-cta__links > a, .contact-cta__links > span { display: grid; grid-template-columns: 6rem 1fr auto; gap: 1rem; align-items: center; padding: 1.4rem 0; border-top: 1px solid color-mix(in srgb, var(--accent-ink) 24%, transparent); }
  .contact-cta__links small, .contact-cta__links span span { font-size: .8rem; color: var(--accent-ink); }
  .contact-cta__links > a > span { font-size: .85rem; font-weight: 600; }

  @media (max-width: 900px) {
    .process-grid { grid-template-columns: 1fr 1fr; }
    .service-grid { grid-template-columns: 1fr; }
    .situation-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 767px) {
    .valuation-section__grid, .owner-grid, .valuation-grid, .buyer-grid, .discretion-grid, .contact-cta__grid { grid-template-columns: 1fr; }
    .home-hero { padding-top: 5.75rem; }
    .home-hero__media { min-height: 34rem; }
    .home-hero__shade { background: linear-gradient(0deg, rgb(20 24 25 / .86) 0%, rgb(20 24 25 / .48) 68%, rgb(20 24 25 / .12) 100%); }
    .home-hero__copy { padding: 1.5rem; }
    .home-hero__copy h1 { max-width: 14ch; font-size: clamp(1.75rem, 7.3vw, 2.05rem); overflow-wrap: normal; }
    .home-hero__actions { align-items: stretch; }
    .home-hero__actions .button { flex: 1 1 auto; }
    .valuation-section__copy { position: static; padding-top: 0; }
    .hero-valuation { padding: .75rem; }
    .owner-mark { aspect-ratio: 3 / 2; }
    .process-grid, .situation-grid { grid-template-columns: 1fr; }
    .proof-line { margin-top: .75rem; }
    .proof-line span { width: 12.5rem; padding-block: .75rem; }
    .contact-cta__links > a, .contact-cta__links > span { grid-template-columns: 1fr; }
    .contact-cta__links > a > span { display: none; }
  }
</style>
