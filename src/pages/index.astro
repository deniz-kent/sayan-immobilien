---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionHeader from "../components/SectionHeader.astro";
import VideoFeature from "../components/VideoFeature.astro";
import PropertyCard from "../components/PropertyCard.astro";
import { getPropertyCatalog, setPropertyCacheHeaders } from "../server/properties";
import { faqQuestions } from "../data/faq";
import EditorialPhoto from "../components/EditorialPhoto.astro";
import { editorialImages } from "../data/editorial-images";
import ValuationOptions from "../components/ValuationOptions.astro";
import Reviews from "../components/Reviews.astro";
import PriceCheck from "../components/PriceCheck.astro";

export const prerender = false;
const catalog = await getPropertyCatalog();
setPropertyCacheHeaders(Astro.response.headers, catalog.available);
const featuredProperties = catalog.properties.slice(0, 3);

// Track-Record: Zahlen laut Kundenangabe (Meeting 02.11.2026).
const trackRecord = [
  { value: 1998, from: 1970, plain: true, suffix: "", label: "Immobilienexpertise seit" },
  { value: 28, from: 0, plain: false, suffix: "", label: "Jahre Erfahrung" },
  { value: 500, from: 0, plain: false, suffix: "+", label: "vermittelte Verkaufsobjekte" },
  { value: 10000, from: 0, plain: false, suffix: "+", label: "Suchprofile in unserer Kartei" },
];

const career = [
  { year: "1998", title: "Einstieg in die Immobilienbranche", copy: "Candan Sayan lernt den Beruf von Grund auf und baut SAYAN Immobilien in Köln auf. Seitdem begleiten wir Eigentümer beim Verkauf und bei der Vermietung." },
  { year: "2008", title: "Diplom-Kaufmann (FH)", copy: "Berufsbegleitendes Studium der Wirtschaftswissenschaften an der Rheinischen Fachhochschule Köln, mit Schwerpunkt Immobilienmarketing." },
  { year: "Heute", title: "Über 500 Verkäufe.", copy: "Ein fester Ansprechpartner, ein Team vor Ort und Beratung auf Deutsch und Türkisch." },
];

const photo = (src: string, alt: string, position = "50% 50%") => ({ src, srcSet: `${src} 1200w`, alt, position });

const services = [
  { title: "Verkaufen", copy: "Von der Bewertung bis zur Schlüsselübergabe. Ein Ansprechpartner, ein klarer Plan.", href: "/leistung/immobilienverkauf/", image: photo("/images/haus-modern-klinker.webp", "Modernes Wohnhaus mit Klinkerfassade", "50% 60%") },
  { title: "Bewerten", copy: "Online als erste Orientierung oder persönlich vor Ort mit klarer Preisempfehlung.", href: "/leistung/wertermittlung/", image: editorialImages.advice },
  { title: "Vermieten", copy: "Passende Mieter, geprüfte Unterlagen, ein sauberer Vertrag und eine ordentliche Übergabe.", href: "/leistung/immobilienvermietung/", image: photo("/images/altbau-zimmer-leer.webp", "Heller, leerer Altbauraum mit Fischgrätparkett") },
  { title: "Suchservice", copy: "Sie suchen in Köln? Legen Sie Ihr Suchprofil an, passende Angebote kommen direkt von uns.", href: "/suchservice/", image: photo("/images/wohnzimmer-modern-domblick.webp", "Modernes Wohnzimmer mit Blick auf den Kölner Dom", "50% 55%") },
];

// Bildstreifen: Objekt- und Stadtfotos, läuft langsam durch.
const gallery = [
  photo("/images/altbau-fassade-stuck.webp", "Altbaufassade mit Stuck und Erkern"),
  photo("/images/sayan-besichtigung-1440.webp", "Candan Sayan bei einer Besichtigung", "50% 40%"),
  photo("/images/altbau-wohnzimmer-fischgraet.webp", "Altbau-Wohnzimmer mit Fischgrätparkett"),
  photo("/images/sayan-persoenlich-1440.webp", "Candan Sayan im Büro", "50% 30%"),
  photo("/images/strasse-altbau-koeln.webp", "Altbau-Straße in Köln"),
  photo("/images/sayan-beratung-1440.webp", "Candan Sayan in einer Wohnung", "55% 35%"),
  photo("/images/wohnzimmer-modern-domblick.webp", "Wohnzimmer mit Domblick"),
  photo("/images/sayan-vermietung-1440.webp", "Candan Sayan am Fenster", "50% 30%"),
  photo("/images/fassade-balkone-klinker.webp", "Klinkerfassade mit Balkonen"),
  photo("/images/buero-candan-sayan-koeln.webp", "Büro von SAYAN Immobilien mit Domblick"),
  photo("/images/altbau-zimmer-leer.webp", "Leerer Altbauraum"),
  photo("/images/sayan-unterlagen-1440.webp", "Candan Sayan mit Unterlagen", "50% 35%"),
  photo("/images/haus-modern-klinker.webp", "Modernes Haus mit Klinker"),
  photo("/images/sayan-kontakt-1440.webp", "Candan Sayan in einem hellen Wohnraum", "55% 30%"),
];

const process = [
  ["01", "Besichtigen", "Wir sehen uns Ihre Immobilie an und hören zu, was Sie vorhaben."],
  ["02", "Bewerten", "Lage, Zustand, Unterlagen und Markt. Daraus legen wir den Angebotspreis gemeinsam fest."],
  ["03", "Vermarkten", "Fotos, Exposé, die richtigen Kanäle und unsere Suchprofile. Besichtigungen organisieren wir."],
  ["04", "Abschließen", "Wir prüfen Interessenten, verhandeln und begleiten Sie bis zum Notar und zur Übergabe."],
];
---

<BaseLayout
  title="Immobilienmakler Köln seit 1998 | SAYAN Immobilien"
  description="SAYAN Immobilien Köln: Immobilienexpertise seit 1998, über 500 vermittelte Verkaufsobjekte. Bewertung, Verkauf und Vermietung, inhabergeführt, auf Deutsch und Türkisch."
>
  <Header />
  <main id="main">
    <section class="home-hero">
      <div class="home-hero__media" aria-hidden="true">
        <video class="home-hero__video" autoplay muted loop playsinline preload="auto" poster="/images/sayan-hero-poster.webp" data-parallax="0.12" data-parallax-scale="1">
          <source src="/videos/sayan-hero-mobil.mp4" type="video/mp4" media="(max-width: 767px) and (orientation: portrait)" />
          <source src="/videos/sayan-hero-1080.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="home-hero__shade" aria-hidden="true"></div>
      <div class="container home-hero__copy">
        <p class="eyebrow" data-reveal>Immobilienmakler in Köln</p>
        <h1 data-reveal style="--stagger:1">Wir kümmern uns.<br /> <em>Seit 1998 an Ihrer Seite.</em></h1>
        <p class="home-hero__lead" data-reveal>
          Ehrliche Bewertung vor Ort. Vermarktung mit System. Ein Ansprechpartner bis zum Notar.
        </p>
        <div class="home-hero__actions" data-reveal>
          <a class="button" href="/kontakt/#termin">Bewertung vor Ort vereinbaren <span class="arrow" aria-hidden="true">→</span></a>
          <a class="button button--ghost" href="#bewertung">Erst online schätzen</a>
        </div>
      </div>
    </section>

    <section class="track-record" aria-label="Unsere Erfahrung in Zahlen">
      <div class="container track-record__grid">
        {trackRecord.map((item) => (
          <div class="track-record__item">
            <p class="track-record__value">
              <span data-count={item.value} data-count-from={item.from} data-plain={item.plain ? "true" : undefined}>{item.plain ? item.value : item.value.toLocaleString("de-DE")}</span>{item.suffix}
            </p>
            <p class="track-record__label">{item.label}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="section section--paper" id="bewertung">
      <div class="container">
        <SectionHeader eyebrow="Der erste Schritt zum Verkauf" title="Was ist Ihre Immobilie <em>wirklich wert?</em>" lead="Schnell online oder gründlich vor Ort. Beides ist unverbindlich. Für einen Verkauf empfehlen wir den Termin, weil kein Rechner Ihren Grundriss, Ihre Lage und Ihren Zustand so sieht wie wir." />
        <ValuationOptions />
      </div>
    </section>

    <section class="section section--white" id="unternehmen">
      <div class="container career">
        <div class="career__media zoom-media" data-reveal>
          <EditorialPhoto image={editorialImages.candanPortrait} sizes="(max-width: 900px) 100vw, 45vw" />
          <p class="career__badge"><strong>Seit 1998</strong><span>in Köln</span></p>
        </div>
        <div class="career__copy">
          <div data-reveal>
            <p class="eyebrow">Unser Werdegang</p>
            <h2>28 Jahre Erfahrung. <em>Persönlich für Sie.</em></h2>
            <p class="career__lead">Candan Sayan hat den Beruf von Grund auf gelernt, SAYAN Immobilien aufgebaut und über 500 Verkäufe begleitet. Diese Erfahrung steckt in jeder Bewertung.</p>
          </div>
          <ol class="timeline" data-reveal-group>
            {career.map((step, i) => (
              <li data-reveal style={`--stagger:${i}`}>
                <span class="timeline__year">{step.year}</span>
                <div><h3>{step.title}</h3><p>{step.copy}</p></div>
              </li>
            ))}
          </ol>
          <a class="text-link" href="/ueber-uns/" data-reveal>Mehr über uns und das Team <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="section section--paper" id="leistungen">
      <div class="container">
        <SectionHeader eyebrow="Leistungen" title="Vier Dinge, die wir <em>richtig gut</em> können." linkLabel="Alle Leistungen" linkHref="/leistung/" />
        <div class="services" data-reveal-group>
          {services.map((service, i) => (
            <a class="service" href={service.href} data-reveal style={`--stagger:${i}`}>
              <div class="service__media"><EditorialPhoto image={service.image} sizes="(max-width: 767px) 100vw, (max-width: 1100px) 50vw, 25vw" /></div>
              <div class="service__body">
                <span class="service__num">0{i + 1}</span>
                <h3>{service.title}</h3>
                <p>{service.copy}</p>
                <span class="service__more">Mehr erfahren <span aria-hidden="true">→</span></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>


    <VideoFeature src="/videos/sayan-grundriss.mp4" poster="/images/video-grundriss-poster.webp" label="Animation: Grundriss wird zur eingerichteten Wohnung" eyebrow="Grundriss und Raumgefühl" title="Aus einem Plan wird <em>ein Zuhause.</em>" copy="Käufer kaufen keine Quadratmeter. Sie kaufen Räume, in denen sie sich ihr Leben vorstellen können. Genau so zeigen wir Ihre Immobilie." />

    <section class="photo-strip" aria-label="Eindrücke aus Köln">
      <div class="photo-strip__head container" data-reveal>
        <p class="eyebrow">Unser Markt</p>
        <h2>Köln. Vom Altbau bis zum <em>Neubau.</em></h2>
      </div>
      <div class="photo-strip__track">
        {[0, 1].map((copy) => (
          <div class="photo-strip__group" aria-hidden={copy === 1 ? "true" : undefined}>
            {gallery.map((img) => (
              <figure><img src={img.src} alt={copy === 1 ? "" : img.alt} loading="lazy" decoding="async" style={`object-position:${img.position}`} /></figure>
            ))}
          </div>
        ))}
      </div>
    </section>

    <section class="section section--paper" id="objekte-vorschau">
      <div class="container">
        <SectionHeader eyebrow="Immobilien" title="Aktuell bei uns <em>im Angebot.</em>" linkLabel="Alle Angebote" linkHref="/immobilien/" />
        <div class="property-grid" data-reveal-group>
          {featuredProperties.map((property, index) => (
            <div data-reveal style={`--stagger:${index}`}>
              <PropertyCard property={property} />
            </div>
          ))}
        </div>
        {featuredProperties.length === 0 && <p role="status" class="empty-note">{catalog.available ? "Zurzeit sind keine öffentlichen Angebote online. Viele Objekte vermitteln wir diskret über unsere Suchprofile. Sprechen Sie uns an." : "Unsere Angebote können gerade nicht geladen werden. Bitte versuchen Sie es später noch einmal oder rufen Sie uns an."}</p>}
      </div>
    </section>


    <VideoFeature reverse src="/videos/sayan-lage.mp4" poster="/images/video-lage-poster.webp" label="Kamerafahrt von außen in eine Wohnung" eyebrow="Lage und Umgebung" title="Die Umgebung <em>verkauft mit.</em>" copy="Straße, Nachbarschaft, der erste Eindruck an der Tür. Wir zeigen, was rund um Ihre Immobilie zählt, bevor jemand zur Besichtigung kommt." />

    <PriceCheck />

    <Reviews tone="paper" />

    <section class="section section--blue" id="ablauf">
      <div class="container">
        <SectionHeader eyebrow="So arbeiten wir" title="Vom ersten Termin bis zur <em>Übergabe.</em>" lead="Vier Schritte, ein Ansprechpartner. Sie wissen jederzeit, wo Ihr Verkauf steht." />
        <div class="process" data-reveal-group>
          {process.map(([number, title, copy], i) => (
            <article data-reveal style={`--stagger:${i}`}><span>{number}</span><h3>{title}</h3><p>{copy}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--paper" id="diskretion">
      <div class="container discretion">
        <div class="discretion__media zoom-media" data-reveal><EditorialPhoto image={editorialImages.candanColumns} sizes="(max-width: 767px) 100vw, 45vw" /></div>
        <div data-reveal>
          <p class="eyebrow">Diskrete Vermarktung</p>
          <h2>Nicht jede Immobilie braucht <em>Öffentlichkeit.</em></h2>
          <p class="discretion__copy">Kein Inserat, keine Fotos im Netz, keine Nachbarn, die fragen. Wir bieten Ihre Immobilie gezielt Interessenten aus über 10.000 Suchprofilen an. Was wir weitergeben, entscheiden Sie.</p>
          <a class="button button--blue" href="/kontakt/">Diskreten Verkauf besprechen <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <VideoFeature src="/videos/sayan-fassade.mp4" poster="/images/video-fassade-poster.webp" label="Kamerafahrt entlang einer modernen Fassade" eyebrow="Architektur im Detail" title="Qualität, <em>die man sieht.</em>" copy="Fassade, Balkone, Materialien. Was Ihre Immobilie wertvoll macht, setzen wir so in Szene, dass Interessenten es auf den ersten Blick erkennen." />

    <section class="section section--white home-faq" id="faq" aria-labelledby="faq-title">
      <div class="container home-faq__layout">
        <div class="home-faq__intro" data-reveal>
          <p class="eyebrow">Häufige Fragen</p>
          <h2 id="faq-title">Gut zu wissen, <em>bevor es losgeht.</em></h2>
        </div>
        <div class="home-faq__questions">
          {faqQuestions.map(([question, answer]) => (
            <details class="home-faq__item">
              <summary>{question}<span aria-hidden="true">+</span></summary>
              <p>{answer}</p>
            </details>
          ))}
          <a class="text-link" href="/kontakt/">Ihre Frage ist nicht dabei? Rufen Sie uns an <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="contact-cta section--brand" id="kontakt">
      <div class="container contact-cta__grid">
        <div data-reveal><p class="eyebrow">Sprechen Sie mit uns</p><h2>Was haben Sie mit Ihrer Immobilie <em>vor?</em></h2><p>Ein Anruf reicht. Wir hören zu, schätzen ehrlich ein und sagen Ihnen, was sinnvoll ist. Auf Deutsch oder Türkisch.</p></div>
        <div class="contact-cta__links" data-reveal>
          <a href="tel:+4922116892660"><small>Telefon</small><strong>+49 221 168 926 60</strong></a>
          <a href="mailto:info@sayan-immo.de"><small>E-Mail</small><strong>info@sayan-immo.de</strong></a>
          <span><small>Büro</small><strong>Sternengasse 3, 50676 Köln</strong></span>
        </div>
      </div>
    </section>
  </main>

<script>
  const heroVideo = document.querySelector<HTMLVideoElement>(".home-hero__video");
  if (heroVideo) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const apply = () => {
      if (reduce.matches) { heroVideo.pause(); heroVideo.removeAttribute("autoplay"); }
      else { heroVideo.muted = true; heroVideo.play().catch(() => {}); }
    };
    apply();
    reduce.addEventListener("change", apply);
  }
</script>
  <Footer />
</BaseLayout>

<style>
  .section--white { background: #fff; }

  /* Hero: volle Breite mit Header-Video. */
  .home-hero { position: relative; display: flex; align-items: flex-end; min-height: min(100svh, 56rem); padding: 9rem 0 clamp(3rem, 7vw, 6rem); overflow: hidden; background: var(--ink); color: #fff; }
  .home-hero__media { position: absolute; inset: 0; overflow: hidden; }
  .home-hero__media img, .home-hero__media :global(video) { position: absolute; inset: -6% 0; width: 100%; height: 112%; object-fit: cover; transform: scale(1.12); animation: hero-zoom 2.4s var(--ease-out-expo) both; }
  /* Video nicht zusätzlich hochskalieren: der Puffer von 6 % oben und unten reicht für den Parallax. */
  .home-hero__media video { transform: none; animation-name: hero-fade; }
  @keyframes hero-fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes hero-zoom { from { opacity: 0; scale: 1.08; } to { opacity: 1; scale: 1; } }
  .home-hero__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(30 23 19 / .35) 0%, rgb(30 23 19 / .2) 40%, rgb(30 23 19 / .78) 100%), linear-gradient(90deg, rgb(30 23 19 / .55) 0%, transparent 70%); }
  .home-hero__copy { position: relative; z-index: 1; }
  .home-hero .eyebrow { color: var(--accent); }
  .home-hero h1 { max-width: 24ch; color: #fff; }
  .home-hero h1 em { background-size: 100% .09em; background-position: 0 96%; }
  .js .home-hero h1:not(.is-visible) em { background-size: 0% .09em; }
  .home-hero__lead { max-width: 46ch; margin-top: 1.5rem; color: rgb(255 255 255 / .88); font-size: clamp(1.125rem, 1.4vw, 1.3rem); }
  .home-hero__actions { display: flex; flex-wrap: wrap; gap: .85rem; margin-top: 2.25rem; }
  .button--ghost { border-color: rgb(255 255 255 / .55); background: rgb(255 255 255 / .06); color: #fff; backdrop-filter: blur(6px); }
  .button--ghost:hover { background: rgb(255 255 255 / .16); filter: none; }

  /* Track-Record-Leiste in Limette. */
  .track-record { background: var(--accent); color: var(--accent-ink); }
  .track-record__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .track-record__item { padding: clamp(1.75rem, 3.5vw, 2.75rem) clamp(1rem, 2vw, 2rem); border-left: 1px solid rgb(36 28 24 / .18); }
  .track-record__item:first-child { border-left: 0; padding-left: 0; }
  .track-record__value { font: 600 clamp(2.5rem, 4.4vw, 4rem)/1 var(--font-display); font-variant-numeric: tabular-nums; letter-spacing: -.025em; }
  .track-record__label { margin-top: .6rem; font-size: 1rem; font-weight: 600; }

  /* Werdegang */
  .career { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(2rem, 5vw, 5.5rem); align-items: start; }
  .career__media { position: sticky; top: 7rem; aspect-ratio: 4 / 5; border-radius: 20px; }
  .career__media :global(img) { height: 100%; }
  .career__badge { position: absolute; left: 1.25rem; bottom: 1.25rem; display: grid; padding: 1rem 1.25rem; border-radius: 12px; background: var(--accent); color: var(--accent-ink); }
  .career__badge strong { font: 600 1.5rem/1.1 var(--font-display); }
  .career__badge span { font-size: .95rem; font-weight: 500; }
  .career__lead { max-width: 52ch; margin-top: 1.5rem; color: var(--n-text-secondary); font-size: 1.2rem; }
  .timeline { display: grid; margin: 2.5rem 0; padding: 0; list-style: none; }
  .timeline li { display: grid; grid-template-columns: 6.5rem minmax(0, 1fr); gap: 1.5rem; padding: 1.75rem 0; border-top: 1px solid var(--n-border); }
  .timeline__year { color: var(--blue); font: 600 2.25rem/1 var(--font-display); }
  .timeline h3 { margin-bottom: .4rem; }
  .timeline p { color: var(--n-text-secondary); }

  /* Leistungen: vier klare Karten. */
  .services { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; }
  .service { display: flex; flex-direction: column; overflow: hidden; border-radius: 18px; background: #fff; transition: transform 500ms var(--ease-out-expo), box-shadow 500ms var(--ease-out-expo); }
  .service:hover { transform: translateY(-6px); box-shadow: 0 30px 60px -32px rgb(36 28 24 / .4); }
  .service__media { aspect-ratio: 4 / 3; overflow: hidden; }
  .service__media :global(img) { transition: transform 1200ms var(--ease-out-expo); }
  .service:hover .service__media :global(img) { transform: scale(1.06); }
  .service__body { display: flex; flex: 1; flex-direction: column; padding: 1.5rem 1.5rem 1.75rem; }
  .service__num { color: var(--blue); font-size: .95rem; font-weight: 600; }
  .service h3 { margin: .5rem 0 .75rem; font-size: 1.65rem; }
  .service p { color: var(--n-text-secondary); font-size: 1.0625rem; }
  .service__more { margin-top: auto; padding-top: 1.25rem; color: var(--blue); font-weight: 600; }


  /* Bildstreifen */
  .photo-strip { padding: var(--section-space) 0; overflow: hidden; background: #fff; }
  .photo-strip__head { margin-bottom: clamp(2rem, 3.5vw, 3rem); }
  .photo-strip__track { display: flex; width: max-content; animation: strip 120s linear infinite; }
  .photo-strip__group { display: flex; gap: 1.25rem; padding-right: 1.25rem; }
  .photo-strip figure { flex: 0 0 auto; width: clamp(15rem, 24vw, 22rem); aspect-ratio: 4 / 5; margin: 0; overflow: hidden; border-radius: 18px; }
  .photo-strip figure:nth-child(even) { aspect-ratio: 1 / 1; align-self: center; }
  .photo-strip img { width: 100%; height: 100%; object-fit: cover; transition: transform 1200ms var(--ease-out-expo); }
  .photo-strip figure:hover img { transform: scale(1.05); }
  @keyframes strip { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .photo-strip__track { animation: none; } }


  .empty-note { max-width: 60ch; color: var(--n-text-secondary); }

  /* Ablauf in Blau */
  .process { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(1rem, 2.5vw, 2.5rem); }
  .process article { padding-top: 1.75rem; border-top: 1px solid rgb(255 255 255 / .3); }
  .process span { color: var(--accent); font: 600 2.5rem/1 var(--font-display); }
  .process h3 { margin: 1.25rem 0 .6rem; color: #fff; }
  .process p { color: rgb(255 255 255 / .85); }
  #ablauf :global(.section-lead) { color: rgb(255 255 255 / .85); }

  .discretion { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .discretion__media { aspect-ratio: 5 / 4; border-radius: 20px; }
  .discretion__copy { max-width: 50ch; margin: 1.5rem 0 2.25rem; color: var(--n-text-secondary); font-size: 1.2rem; }

  .home-faq__layout { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(2rem, 4vw, 4rem); align-items: start; }
  .home-faq__item { border-top: 1px solid var(--n-border); }
