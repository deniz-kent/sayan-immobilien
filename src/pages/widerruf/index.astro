---
import ReducedLayout from "../../layouts/ReducedLayout.astro";
---
<ReducedLayout title="Widerrufsformular | SAYAN" description="Formular zur Erklärung eines Vertragswiderrufs." noindex><main id="main" class="revoke"><div class="wrap"><p class="eyebrow">Vertragswiderruf</p><h1>Widerruf eindeutig <em>erklären.</em></h1><p>Dieses Formular demonstriert den vorgesehenen Ablauf. Es versendet in der Testversion noch keine rechtswirksame Erklärung. Nutzen Sie bis zur Freigabe einen bestätigten Kontaktweg.</p><form data-revoke><label>Name<input name="name" required/></label><label>E-Mail<input type="email" name="email" required/></label><label class="wide">Anschrift<textarea name="anschrift" rows="3" required></textarea></label><label>Vertragsdatum<input type="date" name="datum" required/></label><label>Vertragsbezeichnung<input name="vertrag" required/></label><label class="wide">Erklärung<textarea name="erklaerung" rows="5" required>Hiermit widerrufe ich den von mir abgeschlossenen Vertrag.</textarea></label><label class="wide consent"><input type="checkbox" required/> Ich bestätige, dass meine Angaben vollständig sind.</label><p class="wide" data-status></p><button class="button" type="submit">Widerruf vorbereiten →</button></form></div></main><script>document.querySelector<HTMLFormElement>("[data-revoke]")?.addEventListener("submit",e=>{e.preventDefault();const f=e.currentTarget as HTMLFormElement;if(!f.checkValidity()){f.reportValidity();return}f.querySelector<HTMLElement>("[data-status]")!.textContent="Test erfolgreich. Es wurde keine rechtswirksame Erklärung versendet."});</script></ReducedLayout>
<style>.revoke{min-height:100svh;padding:9rem 1.5rem 5rem;background:var(--accent)}.wrap{width:min(100%,800px);margin:auto}.wrap>p:not(.eyebrow){max-width:60ch;margin:1.2rem 0 2rem}form{display:grid;grid-template-columns:1fr 1fr;gap:1rem;padding:clamp(1.3rem,5vw,3rem);border-radius:var(--radius-card);background:var(--cream)}label{display:grid;gap:.4rem;font-size:.68rem;font-weight:700}input,textarea{width:100%;padding:.8rem;border:1px solid var(--line-dark);border-radius:var(--radius-sm);background:var(--paper)}.wide{grid-column:1/-1}.consent{display:flex;gap:.6rem}.consent input{width:auto}@media(max-width:600px){form{grid-template-columns:1fr}label,.wide{grid-column:1/-1}}</style>
