---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Reviews from "../../components/Reviews.astro";
import EditorialPhoto from "../../components/EditorialPhoto.astro";
import { editorialImages } from "../../data/editorial-images";

const mailSubject = encodeURIComponent("Terminanfrage: Bewertung vor Ort");
const mailBody = encodeURIComponent(
  "Guten Tag Herr Sayan,\n\nich interessiere mich für eine kostenlose Bewertung meiner Immobilie vor Ort.\n\nArt der Immobilie (Wohnung, Haus, Mehrfamilienhaus):\nAdresse:\nIch bin am besten erreichbar unter:\nWunschtermin:\n\nViele Grüße\n",
);
const mailHref = `mailto:info@sayan-immo.de?subject=${mailSubject}&body=${mailBody}`;

const steps = [
  ["Kurz melden", "Rufen Sie an oder fordern Sie einen Rückruf an. Wir stimmen einen Termin ab, der Ihnen passt."],
  ["Wir kommen zu Ihnen", "Wir sehen uns Ihre Immobilie persönlich an und hören zu, was Sie vorhaben."],
  ["Klare Einschätzung", "Sie erfahren, was Ihre Immobilie am Markt bringt und wie wir vorgehen würden. Kostenlos und unverbindlich."],
];

const documents = ["Grundrisse und Wohnflächenberechnung", "Energieausweis", "Grundbuchauszug", "Bei Eigentumswohnungen: Teilungserklärung und letzte Protokolle", "Liste von Modernisierungen"];
---

<BaseLayout title="Termin vor Ort & Kontakt | SAYAN Immobilien Köln" description="Kostenlose Bewertung Ihrer Immobilie vor Ort: Rufen Sie SAYAN Immobilien Köln an oder fordern Sie einen Rückruf an. Sternengasse 3, 50676 Köln.">
  <Header />
  <main id="main">
    <section class="contact-hero" id="termin">
      <div class="container contact-hero__grid">
        <div class="contact-hero__copy" data-reveal>
          <p class="eyebrow">Termin vor Ort · kostenlos</p>
          <h1>Ein Termin. <em>Bei Ihnen vor Ort.</em></h1>
          <p class="contact-hero__lead">Wir kommen zu Ihnen, sehen uns Ihre Immobilie an und sagen Ihnen ehrlich, was sie am Markt bringt. Kostenlos und unverbindlich, auf Deutsch oder Türkisch.</p>

          <div class="contact-ways">
            <a class="way way--primary" href="tel:+4922116892660">
              <span class="way__label">Am schnellsten</span>
              <strong>0221 168 926 60 anrufen</strong>
              <span class="way__status" data-open-status>Montag bis Freitag, 9:30 bis 18:00 Uhr</span>
            </a>
            <a class="way" href="#rueckruf">
              <span class="way__label">Wir melden uns</span>
              <strong>Rückruf anfordern</strong>
              <span class="way__status">Sie sagen uns, wann es passt</span>
            </a>
            <a class="way" href={mailHref}>
              <span class="way__label">Schriftlich</span>
              <strong>Terminanfrage per E-Mail</strong>
              <span class="way__status">Vorlage ist schon ausgefüllt</span>
            </a>
          </div>
        </div>

        <aside class="contact-person" data-reveal>
          <div class="contact-person__photo zoom-media"><EditorialPhoto image={editorialImages.contact} sizes="(max-width: 900px) 100vw, 38vw" priority /></div>
          <div class="contact-person__body">
            <p class="contact-person__role">Ihr Ansprechpartner</p>
            <p class="contact-person__name">Candan Sayan</p>
            <p class="contact-person__title">Inhaber · Diplom-Kaufmann (FH) · Immobilienkaufmann</p>
            <ul>
              <li><span class="stars" aria-hidden="true">★★★★★</span> 4,7 bei Google</li>
              <li>Inhabergeführt seit 2001</li>
              <li>Beratung auf Deutsch und Türkisch</li>
            </ul>
          </div>
        </aside>
      </div>
    </section>

    <section class="section section--white">
      <div class="container">
        <div class="steps-head" data-reveal>
          <p class="eyebrow">So läuft es ab</p>
          <h2>In drei Schritten zur <em>klaren Einschätzung.</em></h2>
        </div>
        <ol class="steps" data-reveal-group>
          {steps.map(([title, copy], i) => (
            <li data-reveal style={`--stagger:${i}`}><span>0{i + 1}</span><h3>{title}</h3><p>{copy}</p></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section section--paper" id="rueckruf">
      <div class="container callback">
        <div class="callback__intro" data-reveal>
          <p class="eyebrow">Rückruf anfordern</p>
          <h2>Wir rufen Sie <em>zurück.</em></h2>
          <p>Hinterlassen Sie Ihre Nummer. Wir melden uns und vereinbaren den Termin mit Ihnen. Ihre Daten nutzen wir nur für Ihre Anfrage.</p>
          <div class="callback__docs">
            <p><strong>Falls vorhanden, gern zum Termin bereitlegen:</strong></p>
            <ul>{documents.map((doc) => <li>{doc}</li>)}</ul>
            <p class="callback__hint">Fehlt etwas, kein Problem. Wir helfen beim Zusammenstellen.</p>
          </div>
        </div>
        <div class="callback__widget" data-reveal>
          <btm-widget widget="return-call"></btm-widget>
          <noscript><p>Bitte rufen Sie uns direkt an: <a href="tel:+4922116892660">0221 168 926 60</a></p></noscript>
        </div>
      </div>
    </section>

    <Reviews />

    <section class="section section--paper">
      <div class="container office">
        <div class="office__photo zoom-media" data-reveal>
          <img src="/images/buero-candan-sayan-koeln.webp" alt="Büro von SAYAN Immobilien in Köln mit Blick auf den Dom" loading="lazy" width="1400" height="788" />
        </div>
        <div class="office__info" data-reveal>
          <p class="eyebrow">Unser Büro</p>
          <h2>Sternengasse 3, <em>mitten in Köln.</em></h2>
          <dl>
            <div><dt>Adresse</dt><dd>Sternengasse 3<br />50676 Köln</dd></div>
            <div><dt>Bürozeiten</dt><dd>Montag bis Freitag, 9:30 bis 18:00 Uhr<br />Wochenende nach Vereinbarung</dd></div>
            <div><dt>Telefon</dt><dd><a href="tel:+4922116892660">0221 168 926 60</a></dd></div>
            <div><dt>E-Mail</dt><dd><a href="mailto:info@sayan-immo.de">info@sayan-immo.de</a></dd></div>
            <div><dt>Telefax</dt><dd>0221 168 926 61</dd></div>
          </dl>
          <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=SAYAN+Immobilien+Sternengasse+3+50676+K%C3%B6ln" target="_blank" rel="noopener">Route in Google Maps öffnen <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="section section--white">
      <div class="container">
        <div class="steps-head" data-reveal>
          <p class="eyebrow">Andere Anliegen</p>
          <h2>Vermieten oder <em>suchen?</em></h2>
        </div>
        <div class="topics" data-reveal-group>
          <a class="topic" href="/leistung/immobilienvermietung/" data-reveal><span>01</span><h3>Immobilie vermieten</h3><p>Inserat, Besichtigungen, Bonitätsprüfung und Mietvertrag aus einer Hand.</p><em>Mehr erfahren →</em></a>
          <a class="topic" href="/suchservice/" data-reveal style="--stagger:1"><span>02</span><h3>Immobilie suchen</h3><p>Legen Sie Ihr Suchprofil an. Passende Angebote, auch diskrete, kommen direkt von uns.</p><em>Zum Suchservice →</em></a>
          <a class="topic" href="/immobilienpreise-koeln/" data-reveal style="--stagger:2"><span>03</span><h3>Preise in Köln</h3><p>Amtliche Richtwerte für 116 Kölner Lagen, durchsuchbar nach Stadtteil.</p><em>Zu den Preisen →</em></a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <script is:inline src="https://components.bottimmo.com/components/6a9a8e5ddd651d6512580de2/btm-widget/de-DE" defer></script>
</BaseLayout>

<style>
  .section--white { background: #fff; }

  .contact-hero { padding: 10rem 0 clamp(3rem, 6vw, 5rem); background: var(--n-bg); }
  .contact-hero__grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .contact-hero h1 { max-width: 13ch; }
  .contact-hero__lead { max-width: 48ch; margin-top: 1.5rem; color: var(--n-text-secondary); font-size: clamp(1.1rem, 1.3vw, 1.25rem); }

  .contact-ways { display: grid; gap: .75rem; margin-top: 2.25rem; }
  .way { display: grid; gap: .2rem; padding: 1.25rem 1.5rem; border: 1px solid var(--n-border); border-radius: 14px; background: #fff; transition: transform 300ms var(--ease-out-expo), border-color 200ms ease; }
  .way:hover { transform: translateX(4px); border-color: var(--ink); }
  .way:active { transform: scale(.99); }
  .way strong { font: 500 clamp(1.3rem, 1.8vw, 1.6rem)/1.2 var(--font-display); letter-spacing: -.015em; }
  .way__label { color: var(--n-text-secondary); font-size: .78rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .way__status { color: var(--n-text-secondary); font-size: .95rem; }
  .way--primary { border-color: var(--accent); background: var(--accent); color: var(--accent-ink); }
  .way--primary:hover { border-color: var(--accent); }
  .way--primary .way__label, .way--primary .way__status { color: var(--accent-ink); }
  .way__status.is-open::before { display: inline-block; width: .55rem; height: .55rem; margin-right: .45rem; border-radius: 50%; background: var(--ink); content: ""; }

  .contact-person { overflow: hidden; border-radius: 20px; background: var(--ink); color: #fff; }
  .contact-person__photo { aspect-ratio: 4 / 3; }
  .contact-person__photo :global(img) { height: 100%; }
  .contact-person__body { padding: 1.5rem 1.75rem 1.75rem; }
  .contact-person__role { color: var(--accent); font-size: .78rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .contact-person__name { margin-top: .4rem; font: 500 1.8rem/1.15 var(--font-display); }
  .contact-person__title { margin-top: .35rem; color: rgb(255 255 255 / .75); font-size: .95rem; }
  .contact-person ul { display: grid; gap: .5rem; margin: 1.25rem 0 0; padding: 1.25rem 0 0; border-top: 1px solid rgb(255 255 255 / .15); list-style: none; font-size: .98rem; }
  .stars { color: #e2b13c; letter-spacing: .08em; }

  .steps-head { margin-bottom: 2.25rem; }
  .steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; margin: 0; padding: 0; list-style: none; }
  .steps li { padding: clamp(1.5rem, 2.5vw, 2.25rem); border-radius: 18px; background: var(--n-bg); }
  .steps span { display: grid; place-items: center; width: 3rem; height: 3rem; margin-bottom: 1.5rem; border-radius: 50%; background: var(--accent); color: var(--accent-ink); font-weight: 700; }
  .steps h3 { margin-bottom: .6rem; }
  .steps p { color: var(--n-text-secondary); }

  .callback { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .callback__intro > p:not(.eyebrow) { max-width: 46ch; margin-top: 1.25rem; color: var(--n-text-secondary); }
  .callback__docs { margin-top: 2rem; padding: 1.5rem; border-radius: 16px; background: #fff; }
  .callback__docs ul { display: grid; gap: .5rem; margin: .9rem 0; padding: 0; list-style: none; }
  .callback__docs li { position: relative; padding-left: 1.6rem; }
  .callback__docs li::before { position: absolute; left: 0; color: var(--ink); font-weight: 700; content: "✓"; }
  .callback__hint { color: var(--n-text-secondary); font-size: .95rem; }
  .callback__widget { min-height: 20rem; padding: clamp(1.25rem, 2.5vw, 2rem); border-radius: 20px; background: #fff; }
  .callback__widget btm-widget { display: block; width: 100%; }

  .office { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .office__photo { aspect-ratio: 16 / 10; border-radius: 20px; }
  .office__photo img { width: 100%; height: 100%; object-fit: cover; }
  .office dl { display: grid; margin: 1.75rem 0; }
  .office dl div { display: grid; grid-template-columns: 8rem minmax(0, 1fr); gap: 1rem; padding: .9rem 0; border-top: 1px solid var(--n-border); }
  .office dt { color: var(--n-text-secondary); font-size: .95rem; }
  .office dd { margin: 0; font-weight: 500; }
  .office dd a:hover { text-decoration: underline; text-underline-offset: .2em; }

  .topics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .topic { display: flex; flex-direction: column; padding: clamp(1.5rem, 2.5vw, 2.25rem); border: 1px solid var(--n-border); border-radius: 18px; transition: transform 400ms var(--ease-out-expo), border-color 200ms ease; }
  .topic:hover { transform: translateY(-4px); border-color: var(--ink); }
  .topic span { color: var(--n-text-secondary); font-weight: 600; }
  .topic h3 { margin: 1.25rem 0 .6rem; }
  .topic p { color: var(--n-text-secondary); }
  .topic em { margin-top: auto; padding-top: 1.25rem; font-style: normal; font-weight: 600; }

  @media (max-width: 900px) {
    .contact-hero { padding-top: 7.5rem; }
    .contact-hero__grid, .callback, .office { grid-template-columns: 1fr; }
    .steps, .topics { grid-template-columns: 1fr; }
    .office dl div { grid-template-columns: 1fr; gap: .2rem; }
  }
</style>

<script>
  // Zeigt "Jetzt erreichbar" während der Bürozeiten (Mo–Fr 9:30–18:00, Berliner Zeit).
  const status = document.querySelector<HTMLElement>("[data-open-status]");
  if (status) {
    const parts = new Intl.DateTimeFormat("de-DE", { timeZone: "Europe/Berlin", weekday: "short", hour: "2-digit", minute: "2-digit", hour12: false }).formatToParts(new Date());
    const get = (t: string) => parts.find((p) => p.type === t)?.value ?? "";
    const day = get("weekday");
    const minutes = Number(get("hour")) * 60 + Number(get("minute"));
    const weekday = ["Mo", "Di", "Mi", "Do", "Fr"].some((d) => day.startsWith(d));
    if (weekday && minutes >= 570 && minutes < 1080) {
      status.textContent = "Jetzt erreichbar, bis 18:00 Uhr";
      status.classList.add("is-open");
    }
  }
</script>
