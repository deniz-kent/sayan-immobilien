---
import BaseLayout from "../../layouts/BaseLayout.astro"; import Header from "../../components/Header.astro"; import Footer from "../../components/Footer.astro"; import SectionHeader from "../../components/SectionHeader.astro";
---
<BaseLayout title="Kontakt und Termin | SAYAN Immobilien" description="SAYAN Immobilien in Köln kontaktieren und einen Termin anfragen."><Header/><main id="main"><section class="page-hero"><div class="container"><p class="eyebrow">Kontakt · Köln</p><h1>Beginnen wir mit einem <em>Gespräch.</em></h1><p>Telefonisch, per E-Mail oder über das Formular. Die Testversion zeigt alle Zustände, versendet aber noch keine Daten.</p></div></section><section class="section section--light"><div class="container contact"><div><SectionHeader eyebrow="Direkter Kontakt" title="Sie erreichen einen echten <em>Menschen.</em>"/><address><a href="tel:+4922116892660">+49 221 168 926 60</a><a href="mailto:info@sayan-immo.de">info@sayan-immo.de</a><span>Sternengasse 3 · 50676 Köln</span><small>Verfügbarkeit und Antwortzeit: Platzhalter</small></address></div><form data-form novalidate><label>Name<input name="name" autocomplete="name" required/></label><label>E-Mail<input name="email" type="email" autocomplete="email" required/></label><label>Telefon<input name="telefon" type="tel" autocomplete="tel"/></label><label>Anliegen<select name="anliegen"><option>Verkauf</option><option>Kauf</option><option>Vermietung</option><option>Sonstiges</option></select></label><label class="wide">Nachricht<textarea name="nachricht" rows="6" required></textarea></label><label class="wide consent"><input type="checkbox" name="consent" required/> Ich stimme der Verarbeitung zur Bearbeitung meiner Anfrage zu.</label><p class="wide error" data-error></p><div class="wide"><button class="button" type="submit">Anfrage vorbereiten →</button><p class="micro">Unverbindlich · keine Weitergabe · noch ohne Versand</p><p class="success" data-success hidden>Formular erfolgreich geprüft. In der Testversion wurden keine Daten versendet.</p></div></form></div></section><section class="section section--dark" id="termin"><div class="container"><SectionHeader eyebrow="Terminbuchung" title="Wählen Sie später Ihren <em>Termin.</em>" lead="Der Anbieter und die datenschutzrechtliche Freigabe stehen noch aus. Deshalb wird in der Testseite kein externes Script geladen."/><div class="placeholder-box">Terminbuchungs-Embed<br/>Platzhalter · Anbieter folgt</div></div></section><section class="section section--brand" id="newsletter"><div class="container newsletter"><div><p class="eyebrow">Newsletter</p><h2>Hinweise kommen nur nach <em>Bestätigung.</em></h2><p>Nach der Anmeldung folgt eine E-Mail mit Bestätigungslink. Erst der Klick schließt die Anmeldung ab.</p></div><form data-newsletter><label>E-Mail-Adresse<input type="email" required placeholder="name@beispiel.de"/></label><button class="button" type="submit">Hinweise abonnieren →</button><small>Double-Opt-in · jederzeit abmeldbar · Versanddienst: Platzhalter</small><p data-news-success hidden>Test erfolgreich. Es wurde noch keine E-Mail versendet.</p></form></div></section></main><Footer/><script>document.querySelectorAll<HTMLFormElement>("[data-form],[data-newsletter]").forEach(form=>form.addEventListener("submit",e=>{e.preventDefault();if(!form.checkValidity()){form.reportValidity();form.querySelector<HTMLElement>("[data-error]")?.replaceChildren("Bitte prüfen Sie die Pflichtfelder und Ihre Einwilligung.");return}form.querySelector<HTMLElement>("[data-success]")?.removeAttribute("hidden");form.querySelector<HTMLElement>("[data-news-success]")?.removeAttribute("hidden")}));</script></BaseLayout>
<style>.contact,.newsletter{display:grid;grid-template-columns:5fr 7fr;gap:clamp(3rem,8vw,8rem)}address{display:grid;gap:.8rem}address a{font:500 1.6rem/1.1 var(--font-display)}address small{color:var(--ink-muted)}form{display:grid;grid-template-columns:1fr 1fr;gap:1rem;padding:clamp(1.4rem,4vw,2.5rem);border-radius:var(--radius-card);background:var(--paper)}form label{display:grid;gap:.4rem;font-size:.68rem;font-weight:700}form input,form select,form textarea{width:100%;padding:.8rem;border:1px solid var(--line-dark);border-radius:var(--radius-sm);background:var(--cream)}form .wide{grid-column:1/-1}.consent{display:flex;align-items:start;gap:.6rem}.consent input{width:auto;margin-top:.2rem}.micro,.error,.success{margin-top:.7rem;font-size:.67rem}.error{color:#9f3527}.success{padding:.7rem;border-left:3px solid var(--accent);background:var(--brand-100)}.newsletter{align-items:center}.newsletter>div p:not(.eyebrow){margin-top:1rem}.newsletter form{display:flex;flex-wrap:wrap;background:transparent;padding:0}.newsletter form label{flex:1 1 15rem}.newsletter form small,.newsletter form p{flex-basis:100%}.newsletter .button{border-color:var(--ink);background:var(--ink);color:var(--cream)}@media(max-width:767px){.contact,.newsletter{grid-template-columns:1fr}form{grid-template-columns:1fr}form label,form .wide{grid-column:1/-1}}</style>
