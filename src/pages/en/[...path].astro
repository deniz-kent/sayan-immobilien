---
import { services } from "../../data/services";

export function getStaticPaths() {
  const paths = ["ueber-uns", "kontakt", "suchservice", "immobilienpreise-koeln", "leistung", "leistung/formular", "leistung/faq", ...services.map((s) => `leistung/${s.slug}`)];
  return paths.map((path) => ({ params: { path } }));
}
return Astro.rewrite(`/${Astro.params.path}/`);
---
