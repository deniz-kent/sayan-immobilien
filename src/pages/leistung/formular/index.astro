---
import ReducedLayout from "../../../layouts/ReducedLayout.astro";
---

<ReducedLayout
  title="Immobilie online bewerten | SAYAN Immobilien"
  description="Kostenlose Online-Immobilienbewertung für Eigentümer in Köln und Umgebung."
  noindex
>
  <main id="main" class="valuation-page">
    <section class="valuation-intro" aria-labelledby="valuation-title">
      <p class="eyebrow">Online-Immobilienbewertung</p>
      <h1 id="valuation-title">Was ist Ihre Immobilie <em>heute wert?</em></h1>
      <p>
        Beantworten Sie einige Fragen zu Ihrer Immobilie und erhalten Sie eine erste, unverbindliche
        Einschätzung. Für eine persönliche Bewertung steht Ihnen Candan Sayan anschließend direkt zur
        Verfügung.
      </p>
    </section>

    <section class="widget-section" aria-label="Immobilienbewertung starten">
      <div class="widget-shell" data-bottimmo-shell>
        <p class="widget-status" data-bottimmo-status role="status">Immobilienbewertung wird geladen …</p>
        <btm-widget widget="valuation"></btm-widget>
        <noscript>
          <p class="widget-fallback">
            Für die Online-Immobilienbewertung wird JavaScript benötigt. Alternativ erreichen Sie uns unter
            <a href="tel:+4922116892660">+49 221 168 926 60</a> oder
            <a href="mailto:info@sayan-immo.de">info@sayan-immo.de</a>.
          </p>
        </noscript>
        <p class="widget-fallback" data-bottimmo-error hidden>
          Die Online-Bewertung konnte gerade nicht geladen werden. Bitte versuchen Sie es erneut oder
          kontaktieren Sie uns unter <a href="tel:+4922116892660">+49 221 168 926 60</a>.
        </p>
      </div>

      <p class="privacy-note">
        Ihre Angaben werden zur Erstellung der Bewertung und Bearbeitung Ihrer Anfrage über BOTTIMMO
        verarbeitet. Weitere Informationen finden Sie im <a href="/datenschutz/">Datenschutz</a>.
      </p>
    </section>
  </main>

  <script
    is:inline
    src="https://components.bottimmo.com/components/6a9a8e5ddd651d6512580de2/btm-widget/de-DE"
    defer
  ></script>
  <script>
    const status = document.querySelector<HTMLElement>("[data-bottimmo-status]");
    const error = document.querySelector<HTMLElement>("[data-bottimmo-error]");
    let widgetReady = false;

    window.customElements.whenDefined("btm-widget").then(() => {
      widgetReady = true;
      if (status) status.hidden = true;
    });

    window.setTimeout(() => {
      if (widgetReady) return;
      if (status) status.hidden = true;
      if (error) error.hidden = false;
    }, 12000);
  </script>
</ReducedLayout>

<style>
  .valuation-page {
    min-height: 100svh;
    padding: 9rem 1.5rem 5rem;
    background: var(--cream);
  }

  .valuation-intro,
  .widget-section {
    width: min(100%, 980px);
    margin-inline: auto;
  }

  .valuation-intro {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(17rem, 4fr);
    gap: 2rem 4rem;
    align-items: end;
    margin-bottom: 3rem;
  }

  .valuation-intro .eyebrow {
    grid-column: 1 / -1;
    margin-bottom: 0;
  }

  .valuation-intro h1 {
    max-width: 13ch;
  }

  .valuation-intro > p:last-child {
    color: var(--ink-muted);
  }

  .widget-shell {
    position: relative;
    min-height: 38rem;
    padding: clamp(1rem, 3vw, 2rem);
    overflow: clip;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius-card);
    background: var(--paper);
  }

  btm-widget {
    display: block;
    width: 100%;
  }

  .widget-status,
  .widget-fallback {
    padding: 1rem;
    color: var(--ink-muted);
    text-align: center;
  }

  .widget-fallback a,
  .privacy-note a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .privacy-note {
    max-width: 72ch;
    margin: 1rem auto 0;
    color: var(--ink-muted);
    font-size: 0.78rem;
    text-align: center;
  }

  @media (max-width: 767px) {
    .valuation-page {
      padding: 7rem 1rem 3rem;
    }

    .valuation-intro {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      margin-bottom: 2rem;
    }

    .valuation-intro .eyebrow {
      grid-column: auto;
    }

    .widget-shell {
      min-height: 42rem;
      padding: 0.5rem;
    }
  }
</style>
