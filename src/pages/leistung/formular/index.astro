---
import ReducedLayout from "../../../layouts/ReducedLayout.astro";
---
<ReducedLayout title="Immobilie einordnen | SAYAN" description="Unverbindliche Anfrage zur Einordnung einer Immobilie." noindex>
  <main id="main" class="funnel-shell">
    <div class="funnel-wrap">
      <div class="progress"><p data-step-label>Schritt 1 von 5</p><div><span data-progress></span></div></div>
      <form data-funnel novalidate>
        <section class="step is-active" data-step="1"><p class="eyebrow">Schritt 01 · Immobilie</p><h1>Worum geht es bei Ihrer <em>Immobilie?</em></h1><fieldset><legend>Objekttyp auswählen</legend><div class="tile-grid">{["Wohnung","Haus","Mehrfamilienhaus","Gewerbe","Grundstück","Noch unklar"].map(x=><label><input type="radio" name="typ" value={x} required /><span>{x}</span></label>)}</div></fieldset><label class="field">Adresse oder Lage<input name="adresse" autocomplete="street-address" required placeholder="z. B. Köln-Lindenthal" /></label><p class="error" data-step-error></p></section>
        <section class="step" data-step="2"><p class="eyebrow">Schritt 02 · Kennzahlen</p><h2>Welche Eckdaten sind bereits <em>bekannt?</em></h2><div class="form-grid"><label class="field">Wohnfläche in m²<input name="flaeche" inputmode="decimal" placeholder="Platzhalter" /></label><label class="field">Zimmer<input name="zimmer" inputmode="decimal" placeholder="Platzhalter" /></label><label class="field">Baujahr<input name="baujahr" inputmode="numeric" placeholder="Platzhalter" /></label><label class="field">Grundstück in m²<input name="grundstueck" inputmode="decimal" placeholder="falls relevant" /></label></div></section>
        <section class="step" data-step="3"><p class="eyebrow">Schritt 03 · Details · optional</p><h2>Details verbessern die spätere <em>Einordnung.</em></h2><div class="form-grid"><label class="field">Etage<input name="etage" /></label><label class="field">Stellplätze<input name="stellplaetze" /></label><label class="field field--full">Besonderheiten<textarea name="details" rows="5" placeholder="z. B. vermietet, Denkmalschutz oder geplanter Umzug"></textarea></label></div><p class="micro-note">Diese Angaben sind freiwillig und können übersprungen werden.</p></section>
        <section class="step" data-step="4"><p class="eyebrow">Schritt 04 · Zustand</p><h2>Wie schätzen Sie den Zustand <em>ein?</em></h2>{["Bausubstanz","Innenausbau","Energie","Außenbereich"].map((x,i)=><fieldset class="rating"><legend>{x}</legend><div>{[1,2,3,4].map(n=><label><input type="radio" name={`rating-${i}`} value={n} /><span>{n}</span></label>)}</div><small>1 = einfach · 4 = sehr gut · freiwillige Selbsteinschätzung</small></fieldset>)}</section>
        <section class="step" data-step="5"><p class="eyebrow">Schritt 05 · Kontakt</p><h2>Wie dürfen wir Sie <em>erreichen?</em></h2><div class="form-grid"><label class="field">Name<input name="name" autocomplete="name" required /></label><label class="field">E-Mail<input name="email" type="email" autocomplete="email" required /></label><label class="field">Telefon<input name="telefon" type="tel" autocomplete="tel" /></label><label class="field">Gewünschter Kontakt<select name="kontakt"><option>Telefon</option><option>E-Mail</option></select></label></div><div class="summary"><h3>Zusammenfassung.</h3><p data-summary>Ihre Eingaben werden hier vor dem Absenden zusammengefasst.</p></div><label class="consent"><input type="checkbox" name="consent" required /> Ich stimme der Verarbeitung meiner Angaben zur Bearbeitung dieser Anfrage zu.</label><label class="consent"><input type="checkbox" name="newsletter" /> Optional: Hinweise per E-Mail erhalten. Anmeldung erst nach Bestätigung.</label><p class="error" data-step-error></p></section>
        <section class="thanks" data-thanks hidden><p class="eyebrow">Anfrage vorbereitet</p><h2>Vielen Dank für Ihre <em>Angaben.</em></h2><p>In dieser Testversion wurden keine Daten versendet. Eine echte Erst-Indikation, der PDF-Download und die verbindliche Rückmeldefrist werden erst mit Datenquelle und Formularziel freigeschaltet.</p><div class="placeholder-box">PDF-Auswertung · Platzhalter</div><a class="button" href="/">Zur Startseite →</a></section>
        <div class="actions" data-actions><button type="button" class="button button--back" data-back disabled>Zurück</button><button type="button" class="button" data-next>Weiter →</button></div>
        <p class="privacy" data-actions-note>Zwischenstände bleiben in dieser Testversion im sessionStorage dieses Browsers.</p>
      </form>
    </div>
  </main>
  <script>
    const form=document.querySelector<HTMLFormElement>("[data-funnel]");
    const steps=[...document.querySelectorAll<HTMLElement>("[data-step]")];let current=1;
    const next=document.querySelector<HTMLButtonElement>("[data-next]");const back=document.querySelector<HTMLButtonElement>("[data-back]");
    const label=document.querySelector<HTMLElement>("[data-step-label]");const bar=document.querySelector<HTMLElement>("[data-progress]");
    const show=()=>{steps.forEach(s=>s.classList.toggle("is-active",Number(s.dataset.step)===current));if(label)label.textContent=`Schritt ${current} von 5`;if(bar)bar.style.width=`${current*20}%`;if(back)back.disabled=current===1;if(next)next.textContent=current===5?"Anfrage abschließen →":"Weiter →";window.scrollTo({top:0,behavior:"smooth"});};
    const save=()=>{if(!form)return;const data=Object.fromEntries(new FormData(form).entries());sessionStorage.setItem("sayan-funnel",JSON.stringify(data));};
    const restore=()=>{
      if(!form)return;
      const stored=sessionStorage.getItem("sayan-funnel");
      let values:Record<string,string>={};
      if(stored){try{values=JSON.parse(stored)}catch{sessionStorage.removeItem("sayan-funnel")}}
      const params=new URLSearchParams(window.location.search);
      if(params.get("ort"))values.adresse=params.get("ort")!;
      form.querySelectorAll<HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement>("input,textarea,select").forEach(field=>{
        const value=values[field.name];if(value===undefined)return;
        if(field instanceof HTMLInputElement&&(field.type==="radio"||field.type==="checkbox")){field.checked=field.value===value||value==="on";}else{field.value=value;}
      });
    };
    next?.addEventListener("click",()=>{const active=steps[current-1];const required=[...active.querySelectorAll<HTMLInputElement>("[required]")];const radioGroups=[...new Set(required.filter(x=>x.type==="radio").map(x=>x.name))];const fieldsOk=required.filter(x=>x.type!=="radio").every(x=>x.type==="checkbox"?x.checked:x.reportValidity());const radiosOk=radioGroups.every(name=>active.querySelector(`input[name="${name}"]:checked`));const error=active.querySelector<HTMLElement>("[data-step-error]");if(!fieldsOk||!radiosOk){if(error)error.textContent="Bitte füllen Sie die markierten Pflichtangaben aus.";return}if(error)error.textContent="";save();if(current<5){current++;if(current===5){const data=new FormData(form!);const summary=document.querySelector<HTMLElement>("[data-summary]");if(summary)summary.textContent=`${data.get("typ")??"Objekt"} · ${data.get("adresse")??"Lage offen"} · Kontaktdaten werden erst im letzten Schritt verwendet.`;}show();return}steps.forEach(s=>s.classList.remove("is-active"));document.querySelector<HTMLElement>("[data-thanks]")!.hidden=false;document.querySelector<HTMLElement>("[data-actions]")!.hidden=true;document.querySelector<HTMLElement>("[data-actions-note]")!.hidden=true;sessionStorage.removeItem("sayan-funnel");});
    back?.addEventListener("click",()=>{if(current>1){current--;show()}});restore();show();
  </script>
</ReducedLayout>
<style>
  .funnel-shell{min-height:100svh;padding:8rem 1.5rem 4rem;background:var(--cream)}.funnel-wrap{width:min(100%,900px);margin:auto}.progress{margin-bottom:3rem;font-size:.68rem;font-weight:700}.progress>div{height:3px;margin-top:.6rem;background:var(--line-dark)}.progress span{display:block;width:20%;height:100%;background:var(--accent);transition:width .2s}.step{margin-bottom:3rem;padding:clamp(1.5rem,5vw,4rem);border-radius:var(--radius-card);background:var(--paper)}.js .step{display:none}.js .step.is-active{display:block}.step h1,.step h2{margin-bottom:2.5rem}.step fieldset{margin:1.5rem 0;padding:0;border:0}.step legend,.field{font-size:.68rem;font-weight:700}.tile-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.7rem;margin-top:.7rem}.tile-grid input,.rating input{position:absolute;opacity:0}.tile-grid span,.rating span{display:grid;min-height:4rem;place-items:center;border:1px solid var(--line-dark);border-radius:var(--radius-sm);background:var(--cream);cursor:pointer}.tile-grid input:checked+span,.rating input:checked+span{border-color:var(--accent-ink);background:var(--accent)}.field{display:grid;gap:.45rem;margin-top:1rem}.field input,.field textarea,.field select{width:100%;padding:.85rem;border:1px solid var(--line-dark);border-radius:var(--radius-sm);background:var(--cream)}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.field--full{grid-column:1/-1}.rating{padding-block:1rem!important;border-top:1px solid var(--line-dark)!important}.rating>div{display:grid;grid-template-columns:repeat(4,3.2rem);gap:.5rem;margin-block:.6rem}.rating span{min-height:3.2rem}.rating small,.micro-note,.privacy{color:var(--ink-muted);font-size:.65rem}.summary{margin-block:1.5rem;padding:1.2rem;border-left:3px solid var(--accent);background:var(--brand-100)}.summary p{margin-top:.5rem;color:var(--ink-muted)}.consent{display:flex;gap:.6rem;margin-top:1rem;font-size:.7rem}.error{min-height:1.5rem;margin-top:1rem;color:#9f3527;font-size:.7rem}.actions{display:flex;justify-content:space-between}.button--back{border-color:var(--line-dark);background:transparent}.button:disabled{opacity:.4}.privacy{text-align:center;margin-top:1rem}.thanks{display:grid;gap:1.5rem}.thanks .placeholder-box{min-height:10rem}.thanks .button{justify-self:start}
  @media(max-width:600px){.tile-grid,.form-grid{grid-template-columns:1fr 1fr}.step{padding:1.25rem}.rating>div{grid-template-columns:repeat(4,1fr)}}
</style>
