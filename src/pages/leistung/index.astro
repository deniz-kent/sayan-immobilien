---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import PersonCard from "../../components/PersonCard.astro";
---
<BaseLayout title="Immobilie verkaufen | SAYAN Köln" description="Persönliche Immobilienvermittlung für Eigentümer in Köln – vom ersten Gespräch bis zur Übergabe.">
  <Header />
  <main id="main">
    <section class="page-hero"><div class="container offer-hero"><div><p class="eyebrow">Immobilie verkaufen · Köln</p><h1>Ein Verkauf braucht einen klaren <em>Plan.</em></h1><p>Wir ordnen Anlass, Objekt und gewünschten Zeitrahmen gemeinsam ein. Danach entsteht der passende Weg: öffentlich, vorgemerkt oder diskret.</p><div class="page-hero__actions"><a class="button" href="/leistung/formular/">Bewertung starten →</a></div></div><div class="placeholder-box">Hero-Video oder Objektbild<br />Platzhalter</div></div></section>
    <section class="section section--light"><div class="container"><SectionHeader eyebrow="So funktioniert es" title="Drei Schritte schaffen erste <em>Klarheit.</em>" /><div class="content-grid"><article class="content-card"><span>01 · Anlass</span><h3>Situation kurz beschreiben.</h3><p>Verkauf, Vermietung, Erbe oder Veränderung: Der Anlass bestimmt, welche Informationen zuerst wichtig sind.</p></article><article class="content-card"><span>02 · Einordnung</span><h3>Objekt gemeinsam prüfen.</h3><p>Lage, Zustand, Unterlagen und vergleichbare Angebote werden zusammengeführt. Zahlen bleiben ohne Quelle als Platzhalter markiert.</p></article><article class="content-card"><span>03 · Weg</span><h3>Vermarktung bewusst festlegen.</h3><p>Sie entscheiden mit, wie sichtbar das Objekt wird und welche Interessenten angesprochen werden.</p></article></div></div></section>
    <section class="section section--dark"><div class="container"><SectionHeader eyebrow="Bewertung" title="Drei Datenebenen statt einer <em>Schätzung.</em>" lead="Die konkrete Datenanbindung folgt. Diese Karten zeigen bereits, wie Herkunft und Grenzen jeder Information sichtbar werden." /><div class="content-grid"><article class="content-card dark-card"><span>Amtlich · Platzhalter</span><h3>Grunddaten und Unterlagen.</h3><p>Flächen, Baujahr und rechtliche Dokumente werden nach Prüfung übernommen.</p></article><article class="content-card dark-card"><span>Datenbasiert · Platzhalter</span><h3>Vergleichbare Angebote und Abschlüsse.</h3><p>Datenquelle, Stichtag und räumlicher Bezug stehen später direkt unter jedem Wert.</p></article><article class="content-card dark-card"><span>Lokal</span><h3>Lage und Nachfrage einordnen.</h3><p>Die persönliche Einschätzung ergänzt Daten, ersetzt aber keinen überprüfbaren Beleg.</p></article></div></div></section>
    <section class="section section--paper"><div class="container compare-two"><div><p class="eyebrow">Üblicher Schnellweg</p><h2>Ein Wert ohne <em>Kontext.</em></h2><ul class="minus-list"><li>Wenige Eingaben</li><li>Unklare Datengrundlage</li><li>Kein Blick auf Unterlagen</li><li>Ergebnis ohne Vermarktungsplan</li></ul></div><div><p class="eyebrow">Der SAYAN-Weg</p><h2>Ein Wert mit nächstem <em>Schritt.</em></h2><ul class="check-list"><li>Anlass und Objekt gemeinsam betrachten</li><li>Herkunft der Daten offenlegen</li><li>Zustand und Besonderheiten ergänzen</li><li>Vermarktungsweg daraus ableiten</li></ul></div></div><p class="neutral">Vergleich typischer Vorgehensweisen. Keine Aussage über einzelne Wettbewerber.</p></section>
    <section class="section section--brand"><div class="container benefit-grid"><div><SectionHeader eyebrow="Das bekommen Sie" title="Der Auftrag bleibt <em>nachvollziehbar.</em>" /><ul class="check-list"><li>Persönliche Zuständigkeit</li><li>Geordnete Objektunterlagen</li><li>Abgestimmte Präsentation</li><li>Qualifizierte Interessentenansprache</li><li>Begleitung von Verhandlung und Übergabe</li></ul></div><div class="placeholder-box">Verfahrensvideo<br />Platzhalter</div></div></section>
    <section class="section section--dark-alt"><div class="container"><SectionHeader eyebrow="Zwei Wege" title="Beginnen Sie passend zu Ihrer <em>Situation.</em>" /><div class="content-grid two"><article class="content-card dark-card"><span>Online · ca. 60 Sekunden</span><h3>Objektdaten vorbereiten.</h3><p>Der Funnel sammelt die wichtigsten Angaben und speichert Zwischenstände nur in diesem Browser.</p><a class="button" href="/leistung/formular/">Online starten →</a></article><article class="content-card dark-card"><span>Persönlich · empfohlen</span><h3>Anlass direkt besprechen.</h3><p>Für diskrete oder komplexe Situationen ist der persönliche Termin der ruhigere Einstieg.</p><a class="button" href="/kontakt/#termin">Termin anfragen →</a></article></div></div></section>
    <section class="section section--light"><div class="container"><SectionHeader eyebrow="Typische Anlässe" title="Jeder Anlass verändert den <em>Weg.</em>" /><div class="occasion-grid">{["Eigener Verkauf", "Erbe", "Trennung", "Kapitalanlage", "Umzug"].map((x,i)=><article><span>0{i+1}</span><h3>{x}.</h3><p>Die konkrete Situation wird im ersten Gespräch eingeordnet.</p></article>)}</div><p class="catchline">Ihr Anlass ist nicht dabei? <a href="/kontakt/">Situation schildern →</a></p></div></section>
    <section class="section section--paper"><div class="container"><SectionHeader eyebrow="Marktdaten · Platzhalter" title="Quellen stehen direkt bei den <em>Zahlen.</em>" /><div class="placeholder-box">Statischer Datentabellen-Auszug<br />Werte · Quelle · Stichtag folgen</div></div></section>
    <section class="section section--light"><div class="container"><SectionHeader eyebrow="Wer bewertet" title="Sie wissen, wer <em>verantwortet.</em>" /><div class="people"><PersonCard name="Candan Sayan" role="Geschäftsinhaber" copy="Gründer und persönlicher Ansprechpartner in Köln." proof="Gegründet 2001" /><PersonCard name="Özgür Fidan" role="Verkauf und Vermietung" copy="Begleitet Eigentümer und Interessenten. Profildaten folgen." proof="Profil · Platzhalter" /></div><p class="neutral">Portraits, Unterschriften und echte Bewertungen folgen nach Freigabe.</p></div></section>
    <section class="section section--dark" id="faq"><div class="container faq"><SectionHeader eyebrow="Häufige Fragen" title="Wichtige Fragen werden offen <em>beantwortet.</em>" />{["Muss die Immobilie sofort öffentlich erscheinen?","Welche Unterlagen werden zuerst gebraucht?","Wie entsteht die Preiseinschätzung?","Was kostet die Vermittlung?","Wie lange dauert ein Verkauf?","Ist die erste Anfrage verbindlich?"].map((q,i)=><details><summary>— 0{i+1} {q}</summary><p>Die konkrete Antwort hängt vom Objekt und Anlass ab. Im ersten Gespräch werden Vorgehen, erforderliche Unterlagen und mögliche Verpflichtungen transparent geklärt. Verbindliche Zahlen werden nicht pauschal behauptet.</p></details>)}</div></section>
    <section class="wide-cta"><div class="container"><p class="eyebrow">Der erste Schritt</p><h2>Ordnen wir Ihre Situation <em>ein.</em></h2><p>Die Testversion bereitet Ihre Angaben vor. Es werden noch keine Daten an ein externes System versendet.</p><a class="button" href="/leistung/formular/">Bewertung starten →</a></div></section>
  </main><Footer />
</BaseLayout>
<style>
  .offer-hero,.benefit-grid,.compare-two{display:grid;grid-template-columns:7fr 5fr;gap:clamp(2rem,7vw,7rem);align-items:center}.offer-hero .placeholder-box{min-height:28rem}.dark-card{border-color:var(--hairline);background:var(--brand-700);color:var(--cream)}.dark-card p{color:color-mix(in srgb,var(--cream) 65%,transparent)}.compare-two>div{padding:2rem;border-top:1px solid var(--line-dark)}.minus-list{display:grid;list-style:none}.minus-list li{padding:.9rem 0 .9rem 1.8rem;border-top:1px solid var(--line-dark);position:relative}.minus-list li:before{content:"−";position:absolute;left:0;color:var(--warn)}.neutral{width:min(100% - 3rem,1240px);margin:1rem auto 0;color:var(--ink-muted);font-size:.68rem}.occasion-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:1rem}.occasion-grid article{padding:1.3rem;border:1px solid var(--line-dark);border-radius:var(--radius-card)}.occasion-grid span{color:var(--accent-ink);font-size:.6rem}.occasion-grid h3{margin-block:2.5rem .6rem}.occasion-grid p,.catchline{color:var(--ink-muted);font-size:.75rem}.catchline{margin-top:1.5rem}.catchline a{text-decoration:underline}.people{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem;max-width:42rem}.faq{max-width:900px}.faq details{border-top:1px solid var(--hairline);padding-block:1.2rem}.faq summary{cursor:pointer;font-family:var(--font-display);font-size:1.35rem}.faq details p{max-width:65ch;padding:1rem 0 0 2rem;color:color-mix(in srgb,var(--cream) 65%,transparent)}
  @media(max-width:767px){.offer-hero,.benefit-grid,.compare-two{grid-template-columns:1fr}.offer-hero .placeholder-box{min-height:18rem}.occasion-grid{grid-template-columns:1fr 1fr}.people{grid-template-columns:1fr}}
</style>
