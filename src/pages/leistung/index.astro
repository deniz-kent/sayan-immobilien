---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import SectionHeader from "../../components/SectionHeader.astro";

const faq = [
  ["Muss meine Immobilie sofort öffentlich angeboten werden?", "Nein. Je nach Objekt und Situation kann die Vermarktung zunächst über vorgemerkte Interessenten oder vollständig diskret erfolgen."],
  ["Wie entsteht die Preiseinschätzung?", "Wir verbinden die Eckdaten der Immobilie mit Lage, Zustand, Unterlagen, Vergleichsangeboten und der aktuellen Nachfrage. Eine belastbare Empfehlung entsteht nach der persönlichen Prüfung."],
  ["Welche Unterlagen werden benötigt?", "Je nach Objekt unter anderem Grundbuchauszug, Grundrisse, Wohnflächenberechnung, Energieausweis und bei Eigentumswohnungen Unterlagen der Gemeinschaft. Wir klären mit Ihnen, was bereits vorliegt und was noch beschafft werden muss."],
  ["Was kostet die Vermittlung?", "Die konkrete Provision richtet sich nach Objekt, Auftrag und gesetzlichem Rahmen. Alle Konditionen werden vor Beauftragung transparent und schriftlich vereinbart."],
  ["Wie lange dauert ein Verkauf?", "Das hängt von Objekt, Preispositionierung, Nachfrage und Unterlagen ab. Nach der ersten Prüfung erhalten Sie eine realistische Einschätzung zum möglichen Zeitrahmen."],
  ["Ist die erste Anfrage verbindlich?", "Nein. Die Online Bewertung und das erste Gespräch dienen der Orientierung und verpflichten Sie nicht zu einem Maklerauftrag."],
];
---

<BaseLayout title="Immobilie verkaufen oder vermieten | SAYAN Köln" description="Persönliche Immobilienvermittlung für Eigentümer in Köln: Bewertung, Vermarktung und Begleitung bis zur Übergabe.">
  <Header />
  <main id="main">
    <section class="page-hero"><div class="container offer-hero"><div><p class="eyebrow">Für Eigentümer · Köln</p><h1>Gut vorbereitet. Sicher <em>vermittelt.</em></h1><p>Wir entwickeln für Ihre Immobilie einen nachvollziehbaren Vermarktungsweg: mit realistischer Einordnung, persönlicher Verantwortung und klarer Abstimmung.</p><div class="page-hero__actions"><a class="button" href="/leistung/formular/">Immobilie bewerten</a><a class="text-link" href="/kontakt/">Persönlich beraten lassen →</a></div></div><aside class="offer-facts"><span><small>Erfahrung</small><strong>seit 2001</strong></span><span><small>Verantwortung</small><strong>inhabergeführt</strong></span><span><small>Vermarktung</small><strong>öffentlich oder diskret</strong></span></aside></div></section>

    <section class="section section--light" id="ablauf"><div class="container"><SectionHeader eyebrow="Ihr Verkaufsprozess" title="Vier Schritte. Ein klarer <em>Weg.</em>" lead="Sie werden bei jeder wichtigen Entscheidung einbezogen und wissen, was als Nächstes passiert." /><div class="content-grid process-cards"><article class="content-card"><span>01 · Kennenlernen</span><h3>Ziele und Zeitrahmen klären.</h3><p>Wir besprechen Ihre Situation, die Immobilie und was Ihnen beim Verkauf besonders wichtig ist.</p></article><article class="content-card"><span>02 · Vorbereiten</span><h3>Wert und Unterlagen einordnen.</h3><p>Wir prüfen die Eckdaten, beschaffen fehlende Informationen und entwickeln eine realistische Preisstrategie.</p></article><article class="content-card"><span>03 · Vermarkten</span><h3>Die richtigen Interessenten erreichen.</h3><p>Präsentation, Kanäle und Sichtbarkeit werden auf Objekt und Zielgruppe abgestimmt.</p></article><article class="content-card"><span>04 · Abschließen</span><h3>Sicher bis zur Übergabe.</h3><p>Wir koordinieren Anfragen, Besichtigungen, Verhandlung, Notartermin und Übergabe.</p></article></div></div></section>

    <section class="section section--dark"><div class="container"><SectionHeader eyebrow="Wertermittlung" title="Ein guter Angebotspreis braucht mehr als eine <em>Zahl.</em>" lead="Die Online Bewertung gibt eine erste Orientierung. Für die Vermarktung betrachten wir die Immobilie persönlich und im Zusammenhang mit der aktuellen Nachfrage." /><div class="content-grid"><article class="content-card dark-card"><span>Objekt</span><h3>Substanz und Ausstattung.</h3><p>Fläche, Baujahr, Zustand, Modernisierungen und Besonderheiten beeinflussen die Einordnung.</p></article><article class="content-card dark-card"><span>Lage</span><h3>Mikrolage und Umfeld.</h3><p>Straße, Anbindung, Infrastruktur und die konkrete Nachbarschaft werden differenziert betrachtet.</p></article><article class="content-card dark-card"><span>Markt</span><h3>Nachfrage und Vergleich.</h3><p>Vergleichsangebote und die aktuelle Wettbewerbssituation helfen bei einer realistischen Positionierung.</p></article></div></div></section>

    <section class="section section--brand"><div class="container benefit-grid"><div><p class="eyebrow">Leistungsumfang</p><h2>Sie behalten die Kontrolle. Wir kümmern uns um den <em>Prozess.</em></h2></div><ul class="check-list"><li>Persönliche Betreuung durch Candan Sayan</li><li>Prüfung und Strukturierung der Objektunterlagen</li><li>Professionelle Positionierung und Präsentation</li><li>Koordination und Qualifizierung von Interessenten</li><li>Vorbereitung und Begleitung von Besichtigungen</li><li>Verhandlungsführung, Notartermin und Übergabe</li></ul></div></section>

    <section class="section section--paper" id="vermietung"><div class="container rental-grid"><div><p class="eyebrow">Immobilie vermieten</p><h2>Passende Mieter statt möglichst vieler <em>Anfragen.</em></h2></div><div><p>Eine gute Vermietung beginnt mit einer marktgerechten Positionierung und klaren Auswahlkriterien. Wir bereiten das Angebot vor, koordinieren Besichtigungen und begleiten die Auswahl bis zum Mietvertrag und zur Übergabe.</p><a class="button button--dark" href="/kontakt/">Vermietung besprechen</a></div></div></section>

    <section class="section section--light"><div class="container"><SectionHeader eyebrow="Typische Anlässe" title="Der Anlass bestimmt den <em>richtigen Weg.</em>" /><div class="occasion-grid">{["Geplanter Verkauf", "Erbschaft", "Trennung", "Kapitalanlage", "Umzug", "Altersbedingter Wechsel"].map((item,i)=><article><span>0{i+1}</span><h3>{item}.</h3><p>Wir stimmen Tempo, Sichtbarkeit und Vorgehen auf Ihre Situation ab.</p></article>)}</div></div></section>

    <section class="section section--dark-alt"><div class="container owner-callout"><div><p class="eyebrow">Persönliche Verantwortung</p><h2>Candan Sayan bleibt Ihr <em>Ansprechpartner.</em></h2></div><div><p>Sie sprechen nicht bei jedem Schritt mit jemand anderem. Von der ersten Einordnung bis zur Übergabe führt Candan Sayan Ihr Anliegen persönlich und stimmt Entscheidungen direkt mit Ihnen ab.</p><a class="button" href="/kontakt/">Gespräch vereinbaren</a></div></div></section>

    <section class="section section--dark" id="faq">
      <div class="container faq-layout">
        <SectionHeader eyebrow="Häufige Fragen" title="Was Eigentümer vor dem Start wissen <em>möchten.</em>" />
        <div class="faq-list">
          {faq.map(([question, answer], i) => (
            <div class="faq-item" data-faq-item data-open="false">
              <h3 class="faq-item__question-wrap">
                <button type="button" class="faq-item__trigger" aria-expanded="false" aria-controls={`faq-panel-${i}`} id={`faq-trigger-${i}`}>
                  <span class="faq-item__question">{question}</span>
                  <span class="faq-item__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
                </button>
              </h3>
              <div class="faq-item__panel" id={`faq-panel-${i}`} role="region" aria-labelledby={`faq-trigger-${i}`}>
                <div class="faq-item__panel-inner"><p>{answer}</p></div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section class="wide-cta"><div class="container"><p class="eyebrow">Der erste Schritt</p><h2>Wie möchten Sie <em>beginnen?</em></h2><p>Starten Sie direkt mit der Online Bewertung oder besprechen Sie Ihre Situation persönlich mit Candan Sayan.</p><div class="cta-actions"><a class="button" href="/leistung/formular/">Online Bewertung starten</a><a class="button button--outline" href="/kontakt/">Persönlich sprechen</a></div></div></section>
  </main>
  <Footer />

  <script>
    document.querySelectorAll<HTMLElement>("[data-faq-item]").forEach((item) => {
      const trigger = item.querySelector<HTMLButtonElement>(".faq-item__trigger");
      trigger?.addEventListener("click", () => {
        const isOpen = item.dataset.open === "true";
        item.dataset.open = String(!isOpen);
        trigger.setAttribute("aria-expanded", String(!isOpen));
      });
    });
  </script>
</BaseLayout>

<style>
  .offer-hero, .benefit-grid, .rental-grid, .owner-callout { display: grid; grid-template-columns: 7fr 5fr; gap: clamp(2rem, 7vw, 7rem); align-items: center; }
  .offer-facts { display: grid; padding: 1.75rem; border-radius: var(--radius-card); background: #fff; border: 1px solid var(--n-border); }
  .offer-facts span { display: grid; grid-template-columns: 1fr 1.6fr; gap: 1rem; padding: 1.1rem 0; border-top: 1px solid var(--n-border); }
  .offer-facts span:first-child { border-top: 0; }
  .offer-facts small { font-size: .72rem; text-transform: uppercase; letter-spacing: .04em; color: var(--n-text-secondary); }
  .offer-facts strong { font-weight: 400; font-size: 1.5rem; color: var(--n-text); }
  .process-cards { grid-template-columns: repeat(4, 1fr); }
  .dark-card { background: var(--brand-700); color: #fff; }
  .dark-card p { color: color-mix(in srgb, #fff 68%, transparent); }
  .benefit-grid .check-list { margin: 0; }
  .rental-grid p, .owner-callout p { max-width: 60ch; color: var(--n-text-secondary); }
  .rental-grid .button, .owner-callout .button { margin-top: 2rem; }
  .owner-callout p { color: color-mix(in srgb, #fff 70%, transparent); }
  .occasion-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.75rem; }
  .occasion-grid article { padding: 2rem; border-radius: var(--radius-card); background: var(--n-surface); }
  .occasion-grid span { color: var(--n-text-secondary); font-size: .78rem; font-weight: 700; }
  .occasion-grid h3 { margin: 2.5rem 0 .7rem; text-transform: none; }
  .occasion-grid p { color: var(--n-text-secondary); font-size: .95rem; }

  .faq-layout { max-width: 920px; }
  .faq-item__question-wrap { margin: 0; font-weight: inherit; }
  .faq-item__trigger { width: 100%; }
  .faq-item__question { color: #fff; }

  .cta-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 1rem; }
  .wide-cta .button--outline { border-color: var(--n-border); background: transparent; color: var(--n-text); }

  @media (max-width: 1000px) { .process-cards { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 767px) {
    .offer-hero, .benefit-grid, .rental-grid, .owner-callout { grid-template-columns: 1fr; }
    .process-cards, .occasion-grid { grid-template-columns: 1fr; }
    .faq-item__trigger { padding-block: 1.75rem; }
  }
</style>
