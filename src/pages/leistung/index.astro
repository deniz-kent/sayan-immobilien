---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { services } from "../../data/services";
import EditorialPhoto from "../../components/EditorialPhoto.astro";
import { serviceImages } from "../../data/editorial-images";
import ServiceIcon from "../../components/ServiceIcon.astro";

const featured = ["immobilienverkauf", "immobilienvermietung", "wertermittlung"];
const groups = ["Eigentümer", "Vermarktung", "Abschluss", "Weitere Leistungen"] as const;
---

<BaseLayout title="Leistungen | SAYAN Immobilien Köln" description="Verkauf, Vermietung, Bewertung und weitere Leistungen von SAYAN Immobilien Köln im Überblick.">
  <Header />
  <main id="main">
    <section class="page-hero overview-hero">
      <div class="container">
        <p class="eyebrow">Unsere Leistungen</p>
        <h1>Was können wir für Sie tun?</h1>
        <p>Verkaufen, vermieten oder bewerten: Wählen Sie Ihren Einstieg. Alle weiteren Leistungen finden Sie direkt im Überblick.</p>
        <div class="overview-jumps"><a class="button button--dark" href="#all-services-title">Alle 19 Leistungen im Überblick</a><a class="text-link" href="/leistung/fotografie-und-expose/">Professionelle Immobilienfotografie ↗</a></div>
      </div>
    </section>

    <section class="section section--paper featured-section" aria-labelledby="featured-title">
      <div class="container">
        <h2 id="featured-title">Der erste Schritt</h2>
        <div class="featured-grid">
          {featured.map((slug) => {
            const service = services.find((item) => item.slug === slug)!;
            const image = serviceImages[slug];
            return <a class="featured-card" href={`/leistung/${service.slug}/`}>{image && <div class="featured-card__photo"><EditorialPhoto image={image} sizes="(max-width: 767px) 100vw, 30vw" decorative /></div>}<div class="featured-card__meta"><ServiceIcon name={service.slug}/><span>{service.group}</span></div><h3>{service.title}</h3><p>{service.summary}</p><strong>Mehr erfahren →</strong></a>;
          })}
        </div>
      </div>
    </section>

    <section class="section section--light all-services" aria-labelledby="all-services-title">
      <div class="container">
        <div class="section-intro">
          <p class="eyebrow">Im Detail</p>
          <h2 id="all-services-title">Alle Leistungen</h2>
          <p>Von der Vorbereitung bis zur Übergabe: Jeder Bereich hat seine eigene Seite.</p>
        </div>
        <div class="service-groups">
          {groups.map((group) => (
            <div class="service-group">
              <h3>{group}</h3>
              <div class="service-links">
                {services.filter((service) => service.group === group).map((service) => (
                  <a href={`/leistung/${service.slug}/`}><span class="service-links__icon"><ServiceIcon name={service.slug}/></span><span>{service.title}</span><small>{service.summary}</small><span class="link-arrow" aria-hidden="true">↗</span></a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="overview-contact">
      <div class="container overview-contact__inner">
        <div><p class="eyebrow">Persönlich klären</p><h2>Sie wissen noch nicht, wo Sie anfangen sollen?</h2><p>Beschreiben Sie uns kurz Ihr Vorhaben. Wir besprechen mit Ihnen, welche Schritte sinnvoll sind.</p></div>
        <div class="overview-actions"><a class="button" href="/kontakt/">Kontakt aufnehmen</a><a class="text-link" href="/leistung/formular/">Online-Bewertung starten →</a></div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .overview-jumps { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: .5rem; }
  .overview-hero { padding-bottom: 2rem; }
  .overview-hero h1 { max-width: 16ch; }
  .overview-hero p:last-child { max-width: 66ch; }
  .featured-section { padding-top: 2rem; }
  .featured-section h2 { margin-bottom: 1.5rem; }
  .featured-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .featured-card { display: flex; flex-direction: column; min-height: 0; padding: 1.25rem; border: 1px solid var(--n-border); border-radius: var(--radius-card); background: #fff; }
  .featured-card:hover, .featured-card:focus-visible { border-color: var(--accent); }
  .featured-card__photo { aspect-ratio: 16 / 9; margin-bottom: 1rem; overflow: hidden; border-radius: var(--radius-field); }
  .featured-card__meta { display: flex; align-items: center; gap: .65rem; }
  .featured-card__meta > span { font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; color: var(--n-text-secondary); }
  .featured-card h3 { margin: .85rem 0 .5rem; text-transform: none; }
  .featured-card p { color: var(--n-text-secondary); }
  .featured-card strong { margin-top: auto; padding-top: 1.5rem; font-size: .9rem; }
  .section-intro { margin-bottom: 1.5rem; }
  .section-intro p:last-child { max-width: 60ch; color: var(--n-text-secondary); }
  .service-groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .service-group { padding: 1.25rem; background: var(--paper); border: 1px solid var(--n-border); border-radius: var(--radius-card); }
  .service-group h3 { margin-bottom: .75rem; font-size: 1.15rem; text-transform: none; }
  .service-links a { display: grid; grid-template-columns: 2.75rem minmax(0, 1fr) auto; gap: .2rem .75rem; padding: .9rem 0; border-top: 1px solid var(--n-border); }
  .service-links a:hover > span:first-child, .service-links a:focus-visible > span:first-child { text-decoration: underline; text-underline-offset: .2em; }
  .service-links a > span:nth-child(2) { font-weight: 600; }
  .service-links__icon { grid-row: 1 / span 2; align-self: center; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 10px; background: var(--brand-100); color: var(--ink); }
  .service-links small { grid-column: 2; color: var(--n-text-secondary); font-size: .85rem; }
  .link-arrow { grid-column: 3; grid-row: 1 / span 2; align-self: center; }
  .overview-contact { padding: var(--section-space) 0; background: var(--paper); }
  .overview-contact__inner { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 2rem; align-items: end; }
  .overview-contact h2 { max-width: 20ch; }
  .overview-contact p:last-child { max-width: 55ch; color: var(--n-text-secondary); }
  .overview-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; }
  @media (max-width: 767px) {
    .featured-grid, .service-groups, .overview-contact__inner { grid-template-columns: 1fr; }
    .featured-card { min-height: 0; }
    .featured-card h3 { margin-top: 1rem; }
    .service-groups { gap: 2rem; }
  }
</style>
