---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { services, serviceBySlug, type Service } from "../../data/services";
import EditorialPhoto from "../../components/EditorialPhoto.astro";
import { serviceImages } from "../../data/editorial-images";
import ServiceIcon from "../../components/ServiceIcon.astro";

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props as { service: Service };
const relatedServices = service.related.map((slug) => serviceBySlug[slug]).filter(Boolean);
const image = serviceImages[service.slug];
---

<BaseLayout title={`${service.title} | SAYAN Immobilien Köln`} description={service.intro}>
  <Header />
  <main id="main">
    <section class="page-hero service-hero">
      <div class="container">
        <nav class="breadcrumbs" aria-label="Brotkrumen">
          <a href="/leistung/">Leistungen</a><span aria-hidden="true">/</span><span aria-current="page">{service.title}</span>
        </nav>
        <p class="eyebrow">{service.group}</p>
        <div class="service-heading"><span><ServiceIcon name={service.slug} size={32}/></span><h1>{service.title}</h1></div>
        <p class="service-hero__intro">{service.intro}</p>
        <a class="text-link" href="/kontakt/">Sprechen Sie mit uns →</a>
      </div>
    </section>

    <section class="section section--paper">
      <div class="container detail-grid">
        <div class="detail-copy">
          <p class="detail-label">Was wir für Sie tun</p>
          <h2>{service.summary}</h2>
          {service.details.map((paragraph) => <p>{paragraph}</p>)}

        </div>
        <aside class="detail-aside" aria-label="Leistungsüberblick">
          <h2>Im Überblick</h2>
          <ul>{service.points.map((point) => <li>{point}</li>)}</ul>
          <a class="button button--dark" href="/kontakt/">Persönlich besprechen ↗</a>
          {image && <div class="detail-photo"><EditorialPhoto image={image} sizes="(max-width: 767px) 100vw, 35vw" /></div>}
        </aside>
      </div>
    </section>

    <section class="section section--light">
      <div class="container related-layout">
        <div>
          <p class="eyebrow">Weitere Leistungen</p>
          <h2>Das könnte Sie auch interessieren.</h2>
        </div>
        <div class="related-links">
          {relatedServices.map((related) => (
            <a href={`/leistung/${related.slug}/`}>
              <strong><ServiceIcon name={related.slug} size={22}/>{related.title}</strong><span>{related.summary}</span>
            </a>
          ))}
          <a href="/leistung/"><strong>Alle Leistungen</strong><span>Zurück zur Übersicht</span></a>
        </div>
      </div>
    </section>

    <section class="wide-cta">
      <div class="container">
        <p class="eyebrow">Kontakt</p>
        <h2>Sprechen wir über Ihre Immobilie.</h2>
        <p>Rufen Sie uns an oder schreiben Sie uns. Wir besprechen, welche Leistungen für Ihr Vorhaben sinnvoll sind.</p>
        <div class="cta-actions">
          <a class="button" href="/kontakt/">Kontakt aufnehmen</a>
          <a class="button button--outline" href="tel:+4922116892660">0221 / 168 926 60</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .service-hero { padding-bottom: 2rem; }
  .service-hero > .container { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,.9fr); gap: .85rem 2.5rem; align-items: center; }
  .service-hero .breadcrumbs, .service-hero .eyebrow { grid-column: 1 / -1; justify-self: start; margin-bottom: 0; }
  .service-hero .service-hero__intro { grid-column: 2; grid-row: 3; margin-top: 0; }
  .service-hero .text-link { grid-column: 1 / -1; }
  .service-hero h1 { max-width: 20ch; font-size: clamp(2rem, 3vw, 2.8rem); }
  .service-hero__intro { max-width: 65ch !important; }
  .service-hero .text-link { margin-top: 1.75rem; }
  .breadcrumbs { display: flex; flex-wrap: wrap; gap: .55rem; margin-bottom: 1.25rem; font-size: .85rem; color: var(--n-text-secondary); }
  .breadcrumbs a { text-decoration: underline; text-underline-offset: .2em; }
  .breadcrumbs a:hover { color: var(--n-text); }
  .detail-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(16rem, 4fr); gap: clamp(1.5rem, 3vw, 2.5rem); align-items: start; }
  .detail-copy { max-width: 68ch; }
  .detail-label { margin-bottom: 1rem; color: var(--n-text-secondary); font-size: .8rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; }
  .detail-copy h2 { max-width: 28ch; margin-bottom: 1rem; }
  .detail-copy > p:not(.detail-label) { margin-top: 1.1rem; color: var(--n-text-secondary); }
  .detail-photo { aspect-ratio: 16 / 10; margin-top: 1.25rem; overflow: hidden; border-radius: var(--radius-media); background: var(--n-surface); }
  .detail-aside { padding: 1.25rem; border: 1px solid var(--n-border); border-radius: var(--radius-card); background: #fff; }
  .service-heading { display: flex; align-items: center; gap: 1rem; }
  .service-heading > span { display: grid; place-items: center; flex: 0 0 3.75rem; height: 3.75rem; border-radius: var(--radius-field); background: var(--accent); color: var(--ink); }
  .detail-aside .button { margin-top: 1rem; width: 100%; }
  .detail-aside h2 { margin-bottom: 1rem; font-size: 1.2rem; text-transform: none; }
  .detail-aside ul { margin: 0; padding: 0; list-style: none; }
  .detail-aside li { padding: .85rem 0; border-top: 1px solid var(--n-border); font-size: .95rem; }
  .related-layout { display: grid; grid-template-columns: 4fr 7fr; gap: clamp(1.5rem, 3vw, 2.5rem); }
  .related-layout h2 { max-width: 16ch; }
  .related-links { display: grid; }
  .related-links a { display: grid; grid-template-columns: 1fr 1.2fr; gap: 1rem; align-items: baseline; padding: 1.1rem 0; border-top: 1px solid var(--n-border); }
  .related-links a:hover strong { text-decoration: underline; text-underline-offset: .2em; }
  .related-links strong { display: flex; align-items: center; gap: .6rem; font-weight: 600; }
  .related-links span { color: var(--n-text-secondary); font-size: .9rem; }
  .cta-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: .8rem; }
  .wide-cta .button--outline { border-color: var(--n-border); background: transparent; color: var(--n-text); }
  @media (max-width: 767px) {
    .detail-grid, .related-layout, .service-hero > .container { grid-template-columns: 1fr; }
    .service-hero .service-hero__intro { grid-column: auto; grid-row: auto; }
    .related-links a { grid-template-columns: 1fr; gap: .3rem; }
  }
</style>
