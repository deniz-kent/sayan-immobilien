---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PropertyCard from "../../components/PropertyCard.astro";
import { getPropertyCatalog, setPropertyCacheHeaders } from "../../server/properties";

export const prerender = false;
const catalog = await getPropertyCatalog();
const properties = catalog.properties;
setPropertyCacheHeaders(Astro.response.headers, catalog.available);
if (!catalog.available) Astro.response.status = 503;
---

<BaseLayout
  title="Immobilienangebote | SAYAN Immobilien Köln"
  description="Aktuelle Kauf- und Mietangebote von SAYAN Immobilien in Köln. Öffentliche Objekte erscheinen hier, sobald sie verfügbar sind."
  noindex={false}
>
  <Header />
  <main id="main">
    <section class="page-hero">
      <div class="container">
        <p class="eyebrow">Immobilien · Köln</p>
        <h1>Aktuelle <em>Angebote.</em></h1>
        <p>
          Hier finden Sie unsere aktuellen Kauf- und Mietangebote. Im jeweiligen Exposé sehen Sie
          Fotos, Preise und Objektdaten. Bei Fragen zu einer Immobilie sind wir persönlich für Sie da.
        </p>
        <div class="page-hero__actions">
          <a class="button" href="/kontakt/">Kontakt aufnehmen</a>
          <a class="text-link" href="/leistung/formular/">Immobilie bewerten →</a>
        </div>
      </div>
    </section>

    <section class="section section--paper" id="angebote">
      <div class="container">
        <div class="property-filter" role="group" aria-label="Objekte filtern">
          <button type="button" class="is-active" data-filter="alle" aria-pressed="true">Alle</button>
          <button type="button" data-filter="kaufen" aria-pressed="false">Kaufen</button>
          <button type="button" data-filter="mieten" aria-pressed="false">Mieten</button>
        </div>

        <div class="property-grid" data-reveal-group>
          {properties.map((property, index) => (
            <div data-type={property.type} data-reveal style={`--stagger:${index}`}>
              <PropertyCard property={property} />
            </div>
          ))}
        </div>

        <p class="property-note" role="status" data-empty-filter hidden={properties.length > 0}>
          {catalog.available ? "Zurzeit sind keine öffentlichen Immobilienangebote verfügbar." : "Unsere Angebote können gerade nicht geladen werden. Bitte versuchen Sie es später noch einmal oder kontaktieren Sie uns."}
        </p>
      </div>
    </section>

    <section class="wide-cta">
      <div class="container">
        <p class="eyebrow">Ihr nächster Schritt</p>
        <h2>Fragen zu einer <em>Immobilie?</em></h2>
        <p>Wir beantworten Ihre Fragen zum Angebot und vereinbaren gern einen Besichtigungstermin mit Ihnen.</p>
        <div class="cta-actions">
          <a class="button" href="/kontakt/">Kontakt aufnehmen</a>
          <a class="button button--outline" href="tel:+4922116892660">0221 / 168 926 60</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>(".property-filter button");
    const cards = document.querySelectorAll<HTMLElement>(".property-grid > [data-type]");
    const empty = document.querySelector<HTMLElement>("[data-empty-filter]");

    function applyFilter(filter: string) {
      buttons.forEach((b) => {
        b.classList.toggle("is-active", b.dataset.filter === filter);
        b.setAttribute("aria-pressed", String(b.dataset.filter === filter));
      });
      cards.forEach((card) => {
        card.hidden = filter !== "alle" && card.dataset.type !== filter;
      });
      if (empty && cards.length > 0) {
        empty.hidden = [...cards].some((card) => !card.hidden);
        empty.textContent = "Für diese Auswahl sind zurzeit keine Immobilienangebote verfügbar.";
      }
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () => applyFilter(button.dataset.filter ?? "alle"));
    });

    const requestedType = new URLSearchParams(window.location.search).get("typ");
    if (requestedType && [...buttons].some((b) => b.dataset.filter === requestedType)) {
      applyFilter(requestedType);
    }
  </script>
</BaseLayout>

<style>
  .property-filter { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .property-filter button { padding: .7rem 1.4rem; border: 1px solid var(--n-border); border-radius: var(--radius-pill); background: transparent; color: var(--n-text-secondary); font-size: .9rem; font-weight: 500; cursor: pointer; transition: background var(--motion-hover) ease, color var(--motion-hover) ease, border-color var(--motion-hover) ease; }
  .property-filter button.is-active { border-color: var(--accent); background: var(--accent); color: var(--n-text); font-weight: 700; }
  .property-note { max-width: 60ch; margin-top: clamp(2.5rem, 5vw, 3.5rem); color: var(--n-text-secondary); }
  .cta-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 1rem; }
  .wide-cta .button--outline { border-color: var(--n-border); background: transparent; color: var(--n-text); }
</style>
